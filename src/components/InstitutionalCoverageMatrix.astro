---
import { getCollection } from 'astro:content';
import type { SiteLocale } from '../lib/i18n';
import {
  institutionalCoverageRegions,
  institutionalCoverageRegionLabel,
  resolveInstitutionalCoverageRegion,
  type InstitutionalCoverageRegionId,
} from '../lib/institutionalCoverageRegions';

interface Props {
  locale?: SiteLocale;
}

const { locale = 'en' } = Astro.props;

const beliefs = await getCollection('institutionalBeliefs');

const allEpisodes = beliefs.flatMap((belief) =>
  belief.data.episodes.map((episode) => ({
    ...episode,
    beliefId: belief.id,
    coverageRegionId: resolveInstitutionalCoverageRegion({
      polity: episode.polity,
      region: episode.region,
    }),
  }))
);

const periodLabels = locale === 'de'
  ? {
      pre1900: 'Vor 1900',
      early20: '1900–1939',
      mid20: '1940–1969',
      late20: '1970–1999',
      modern: '2000–heute',
    }
  : {
      pre1900: 'Before 1900',
      early20: '1900–1939',
      mid20: '1940–1969',
      late20: '1970–1999',
      modern: '2000–present',
    };

const coveragePeriods = [
  {
    id: 'pre-1900',
    start: Number.MIN_SAFE_INTEGER,
    end: 1899,
    label: periodLabels.pre1900,
  },
  {
    id: '1900-1939',
    start: 1900,
    end: 1939,
    label: periodLabels.early20,
  },
  {
    id: '1940-1969',
    start: 1940,
    end: 1969,
    label: periodLabels.mid20,
  },
  {
    id: '1970-1999',
    start: 1970,
    end: 1999,
    label: periodLabels.late20,
  },
  {
    id: '2000-present',
    start: 2000,
    end: Number.MAX_SAFE_INTEGER,
    label: periodLabels.modern,
  },
];

const unclassifiedEpisodes = allEpisodes.filter(
  (episode) => episode.coverageRegionId === 'unclassified'
);

if (unclassifiedEpisodes.length > 0) {
  console.warn(
    '[InstitutionalCoverageMatrix] Unclassified episode polities:',
    [...new Set(unclassifiedEpisodes.map((episode) => `${episode.polity} (${episode.region})`))].join(', ')
  );
}

const diagnosticRegion = {
  id: 'unclassified' as InstitutionalCoverageRegionId,
  en: 'Unclassified',
  de: 'Nicht klassifiziert',
  target: false,
};

const coverageRegions = [
  ...institutionalCoverageRegions,
  ...(unclassifiedEpisodes.length > 0 ? [diagnosticRegion] : []),
];

const targetCoverageRegions = institutionalCoverageRegions.filter((region) => region.target);

const regionHasEpisode = (regionId: InstitutionalCoverageRegionId) =>
  allEpisodes.some((episode) => episode.coverageRegionId === regionId);

const coveredRegionCount = targetCoverageRegions.filter((region) =>
  regionHasEpisode(region.id)
).length;

const matrix = coverageRegions.map((region) => ({
  ...region,
  label: locale === 'de' ? region.de : region.en,
  cells: coveragePeriods.map((period) => {
    const episodes = allEpisodes.filter(
      (episode) =>
        episode.coverageRegionId === region.id &&
        episode.startYear <= period.end &&
        episode.endYear >= period.start
    );

    const polities = [...new Set(episodes.map((episode) => episode.polity))]
      .sort((a, b) => a.localeCompare(b, locale));

    return {
      period,
      count: episodes.length,
      polityCount: polities.length,
      polities,
      density: Math.min(4, episodes.length),
    };
  }),
}));

const copy = locale === 'de'
  ? {
      eyebrow: 'Forschungsabdeckung',
      title: 'Abdeckung des Katalogs',
      intro:
        'Die Matrix zeigt, welche festen geografischen Abdeckungsregionen und Zeiträume der derzeitige Katalog bereits dokumentiert. Gezählt werden institutionelle Episoden, deren Laufzeit den jeweiligen Zeitraum berührt.',
      caution:
        'Sie beschreibt die Abdeckung dieser Sammlung, nicht die historische Häufigkeit institutioneller Irrtümer. Leere oder dünn besetzte Felder sind Forschungslücken im Katalog.',
      taxonomy:
        'Für die Vergleichbarkeit verwendet die Matrix eine feste Forschungstaxonomie statt der frei formulierten Regionsangabe einzelner Karten. Alternative geografische oder kulturelle Einordnungen können ebenfalls sinnvoll sein; überregionale Fälle werden getrennt zusammengefasst.',
      region: 'Region',
      episode: 'Episode',
      episodes: 'Episoden',
      polity: 'politischer Raum',
      polities: 'politische Räume',
      noCoverage: 'Noch keine dokumentierte Episode',
      densityNote:
        'Die Schattierung zeigt nur die Zahl dokumentierter Episoden, nicht deren Schweregrad.',
      summary: (episodes: number, covered: number, total: number) =>
        `${episodes} Episoden · ${covered} von ${total} Zielregionen derzeit belegt`,
    }
  : {
      eyebrow: 'Research coverage',
      title: 'Coverage of the catalogue',
      intro:
        'This matrix shows which fixed geographic coverage regions and periods the current catalogue already documents. A cell counts institutional episodes whose active span overlaps that period.',
      caution:
        'It describes the coverage of this collection, not the historical prevalence of institutional error. Empty or thin cells are research gaps in the catalogue.',
      taxonomy:
        'For comparability, the matrix uses one fixed research taxonomy rather than each card’s free-text region label. Other geographic or cultural classifications can also be valid; cross-regional cases are grouped separately.',
      region: 'Region',
      episode: 'episode',
      episodes: 'episodes',
      polity: 'polity',
      polities: 'polities',
      noCoverage: 'No documented episode yet',
      densityNote:
        'Shading indicates only the number of documented episodes, not their severity.',
      summary: (episodes: number, covered: number, total: number) =>
        `${episodes} episodes · ${covered} of ${total} target regions currently represented`,
    };

const cellLabel = (count: number, polityCount: number) => {
  if (count === 0) return copy.noCoverage;
  const episodeLabel = count === 1 ? copy.episode : copy.episodes;
  const polityLabel = polityCount === 1 ? copy.polity : copy.polities;
  return `${count} ${episodeLabel}, ${polityCount} ${polityLabel}`;
};
---

<section
  class="coverage-section container"
  id="coverage"
  aria-labelledby="coverage-title"
  data-coverage-locale={locale}
>
  <header class="coverage-head">
    <div>
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2 id="coverage-title">{copy.title}</h2>
      <p class="coverage-intro">{copy.intro}</p>
      <p class="coverage-caution">{copy.caution}</p>
      <p class="coverage-taxonomy">{copy.taxonomy}</p>
    </div>
    <p class="coverage-summary">
      {copy.summary(
        allEpisodes.length,
        coveredRegionCount,
        targetCoverageRegions.length
      )}
    </p>
  </header>

  <div
    class="coverage-table-wrap"
    tabindex="0"
    aria-label={locale === 'de'
      ? 'Matrix der Katalogabdeckung nach Region und Zeitraum'
      : 'Catalogue coverage matrix by region and period'}
  >
    <table class="coverage-table">
      <thead>
        <tr>
          <th scope="col" class="region-column">{copy.region}</th>
          {coveragePeriods.map((period) => (
            <th scope="col">{period.label}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {matrix.map((row) => (
          <tr class={row.target ? undefined : 'coverage-special-row'}>
            <th scope="row">{row.label}</th>
            {row.cells.map((cell) => (
              <td
                class={`coverage-cell coverage-density-${cell.density}`}
                title={
                  cell.count === 0
                    ? copy.noCoverage
                    : `${cellLabel(cell.count, cell.polityCount)}: ${cell.polities.join(', ')}`
                }
                aria-label={`${row.label}, ${cell.period.label}: ${cellLabel(cell.count, cell.polityCount)}`}
              >
                {cell.count === 0 ? (
                  <span class="coverage-zero" aria-hidden="true">—</span>
                ) : (
                  <>
                    <strong>{cell.count}</strong>
                    <span>
                      {cell.polityCount} {cell.polityCount === 1 ? copy.polity : copy.polities}
                    </span>
                  </>
                )}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="coverage-density-note">{copy.densityNote}</p>
</section>

<script>
  import {
    institutionalCoverageRegions,
    institutionalCoverageRegionLabel,
    resolveInstitutionalCoverageRegion,
  } from '../lib/institutionalCoverageRegions';

  const normalizeRegionFilter = () => {
    const select = document.querySelector<HTMLSelectElement>(
      '.institutional-filter[data-filter="region"]'
    );
    const cards = [
      ...document.querySelectorAll<HTMLElement>('.episode-card[data-region][data-polity]'),
    ];

    if (!select || cards.length === 0) return;

    const locale = document.documentElement.lang.toLowerCase().startsWith('de')
      ? 'de'
      : 'en';

    const usedRegionIds = new Set<string>();

    cards.forEach((card) => {
      const coverageRegionId = resolveInstitutionalCoverageRegion({
        polity: card.dataset.polity ?? '',
        region: card.dataset.region ?? '',
      });

      card.dataset.region = coverageRegionId;
      usedRegionIds.add(coverageRegionId);
    });

    const firstOption = select.options[0];
    const previousValue = select.value;
    select.replaceChildren(firstOption);

    institutionalCoverageRegions.forEach((region) => {
      if (!usedRegionIds.has(region.id)) return;

      const option = document.createElement('option');
      option.value = region.id;
      option.textContent = institutionalCoverageRegionLabel(region.id, locale);
      select.append(option);
    });

    if (usedRegionIds.has('unclassified')) {
      const option = document.createElement('option');
      option.value = 'unclassified';
      option.textContent = institutionalCoverageRegionLabel('unclassified', locale);
      select.append(option);
    }

    const requestedRegion =
      new URL(window.location.href).searchParams.get('region') ?? '';

    if (
      requestedRegion &&
      [...select.options].some((option) => option.value === requestedRegion)
    ) {
      select.value = requestedRegion;
    } else if (
      [...select.options].some((option) => option.value === previousValue)
    ) {
      select.value = previousValue;
    } else {
      select.value = '';
    }

    // The catalogue component owns the filtering and URL-state machinery.
    // Re-dispatch after normalization so any initial filtering that ran against
    // the old free-text region values is recalculated with canonical ids.
    requestAnimationFrame(() => {
      select.dispatchEvent(new Event('change', { bubbles: true }));
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', normalizeRegionFilter, { once: true });
  } else {
    normalizeRegionFilter();
  }
</script>

<style>
  .coverage-section {
    margin-top: 5.5rem;
    padding-top: 2.5rem;
    border-top: 2px solid var(--ink);
  }

  .coverage-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(230px, 0.35fr);
    gap: 2rem;
    align-items: end;
  }

  .coverage-head h2 {
    margin: 0.15rem 0 0.8rem;
  }

  .coverage-intro {
    margin: 0;
    color: var(--muted);
    font-size: 1.02rem;
  }

  .coverage-caution,
  .coverage-taxonomy {
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .coverage-caution {
    font-style: italic;
  }

  .coverage-taxonomy {
    max-width: 76ch;
  }

  .coverage-summary {
    margin: 0;
    padding: 0.9rem 1rem;
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    background: var(--card);
    color: var(--muted);
    font-size: 0.88rem;
    font-weight: 720;
  }

  .coverage-table-wrap {
    margin-top: 1.5rem;
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 0.8rem;
    background: var(--card);
  }

  .coverage-table {
    width: 100%;
    min-width: 820px;
    border-collapse: collapse;
    font-size: 0.88rem;
  }

  .coverage-table th,
  .coverage-table td {
    padding: 0.8rem 0.7rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    text-align: center;
    vertical-align: middle;
  }

  .coverage-table tr:last-child > * {
    border-bottom: 0;
  }

  .coverage-table tr > *:last-child {
    border-right: 0;
  }

  .coverage-table thead th {
    background: color-mix(in srgb, var(--paper) 78%, var(--card));
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 850;
    letter-spacing: 0.035em;
  }

  .coverage-table .region-column,
  .coverage-table tbody th {
    position: sticky;
    left: 0;
    z-index: 2;
    min-width: 175px;
    text-align: left;
    background: var(--card);
  }

  .coverage-table thead .region-column {
    z-index: 3;
    background: color-mix(in srgb, var(--paper) 78%, var(--card));
  }

  .coverage-table tbody th {
    font-weight: 800;
  }

  .coverage-special-row > th {
    border-top: 2px solid var(--line);
  }

  .coverage-special-row > td {
    border-top: 2px solid var(--line);
  }

  .coverage-cell {
    min-width: 122px;
    background: var(--card);
  }

  .coverage-cell strong {
    display: block;
    font-size: 1.18rem;
    line-height: 1;
  }

  .coverage-cell span:not(.coverage-zero) {
    display: block;
    margin-top: 0.28rem;
    color: var(--muted);
    font-size: 0.7rem;
    line-height: 1.2;
  }

  .coverage-zero {
    color: color-mix(in srgb, var(--muted) 48%, transparent);
    font-size: 1.15rem;
  }

  .coverage-density-1 {
    background: color-mix(in srgb, #4f5d6b 6%, var(--card));
  }

  .coverage-density-2 {
    background: color-mix(in srgb, #4f5d6b 11%, var(--card));
  }

  .coverage-density-3 {
    background: color-mix(in srgb, #4f5d6b 17%, var(--card));
  }

  .coverage-density-4 {
    background: color-mix(in srgb, #4f5d6b 24%, var(--card));
  }

  .coverage-density-note {
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
  }

  @media (max-width: 760px) {
    .coverage-section {
      margin-top: 4rem;
    }

    .coverage-head {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .coverage-summary {
      width: fit-content;
    }
  }
</style>
