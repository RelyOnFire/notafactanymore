---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompactClaim from '../../components/CompactClaim.astro';
import FactCard from '../../components/FactCard.astro';
import { translationMatchesEntry } from '../../lib/i18n';

const entries = await getCollection('entries');
const translations = await getCollection(
  'entryTranslations',
  (translation) => translation.data.locale === 'de',
);

const translatedEntries = translations
  .map((translation) => {
    const entry = entries.find((candidate) => candidate.id === translation.data.entryId);
    return entry && translationMatchesEntry(entry, translation) ? { entry, translation } : null;
  })
  .filter((item): item is NonNullable<typeof item> => Boolean(item));

const featured = translatedEntries
  .filter(({ entry }) => entry.data.featured)
  .sort((a, b) => (a.entry.data.featuredOrder ?? 999) - (b.entry.data.featuredOrder ?? 999))
  .slice(0, 3);

const catalogue = [...translatedEntries].sort((a, b) =>
  a.translation.data.claim.localeCompare(b.translation.data.claim, 'de', { sensitivity: 'base' }),
);
---
<BaseLayout
  locale="de"
  alternatePath="/"
  description="Die deutschsprachige Ausgabe von Not a Fact Anymore: wissenschaftliche Aussagen, die durch bessere Evidenz widerlegt, abgelöst, eingeschränkt, neu eingeordnet oder korrigiert wurden."
>
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow">Fakten haben eine Geschichte.</p>
      <h1>Wissen verändert sich.<br />Der Wissensstand sollte es auch.</h1>
      <p class="intro">
        Ein Katalog wissenschaftlicher Aussagen, die einst vernünftigerweise als Tatsachen galten,
        später aber durch bessere Evidenz widerlegt, abgelöst, eingeschränkt, neu eingeordnet oder
        korrigiert wurden.
      </p>
      <div class="actions">
        <a class="button" href="/de/browse">Deutschen Katalog ansehen</a>
        <a class="button secondary" href="/de/submit">Beitrag vorschlagen</a>
      </div>
    </div>

    <div class="hero-art" aria-hidden="true">
      <img
        src="/images/cat-oracle-hero-site-bg.webp"
        alt=""
        width="1200"
        height="800"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </section>

  <section class="principle">
    <div class="narrow">
      <p>
        Dies ist keine Sammlung von Mythen, gescheiterten Vorhersagen oder Dingen, die irgendwann
        einmal jemand behauptet hat. Jeder Eintrag muss zeigen, dass die frühere Aussage tatsächlich
        wissenschaftlich gestützt oder als maßgeblich behandelt wurde und dass die heutige Auffassung
        auf stärkerer Evidenz beruht.
      </p>
      <strong>Falsch zu liegen ist nicht das Versagen. Sich trotz besserer Evidenz nicht zu korrigieren, schon.</strong>
    </div>
  </section>

  <section class="translation-note">
    <div class="container translation-note-inner">
      <div>
        <p class="eyebrow">Deutschsprachige Ausgabe</p>
        <h2>Die Übersetzung beginnt mit einer kuratierten Auswahl.</h2>
      </div>
      <p>
        Der vollständige englische Katalog bleibt unverändert verfügbar. Die deutsche Ausgabe wird
        schrittweise erweitert; Quellen, Publikationstitel, Daten und die zugrunde liegenden
        Klassifikationen bleiben mit dem englischen Original verknüpft.
      </p>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="container featured">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Ausgewählte Einträge</p>
          <h2>Klare Beispiele dafür, wie sich Wissen aktualisiert</h2>
        </div>
        <a href="/de/browse">Alle deutschen Einträge →</a>
      </div>

      <div class="cards">
        {featured.map(({ entry, translation }) => (
          <FactCard entry={entry} translation={translation} locale="de" />
        ))}
      </div>
    </section>
  )}

  <section class="catalogue-preview">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Der deutsche Katalog</p>
          <h2>{catalogue.length} übersetzte Einträge zum Start</h2>
          <p class="section-intro">
            Diese erste Auswahl deckt mehrere Fachgebiete und Zeiträume ab. Weitere Einträge werden
            in späteren Übersetzungswellen ergänzt.
          </p>
        </div>
        <a href="/browse">Vollständigen englischen Katalog öffnen →</a>
      </div>

      <div class="compact-preview">
        {catalogue.map(({ entry, translation }) => (
          <CompactClaim entry={entry} translation={translation} locale="de" />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(19rem, 0.92fr);
    grid-template-areas: "copy art";
    align-items: center;
    column-gap: clamp(1.5rem, 4vw, 4.5rem);
    padding: clamp(3rem, 7vw, 6.5rem) 0;
  }

  .hero-copy { grid-area: copy; min-width: 0; }
  .hero h1 { margin: .3rem 0 1.5rem; max-width: 14ch; }
  .intro { font-size: clamp(1.1rem, 2.5vw, 1.45rem); color: var(--muted); max-width: 46rem; }
  .actions { display: flex; gap: .75rem; flex-wrap: wrap; margin-top: 2rem; }
  .hero-art { grid-area: art; min-width: 0; display: flex; justify-content: center; align-items: center; }
  .hero-art img { display: block; width: min(100%, 37rem); height: auto; object-fit: contain; }

  .principle { background: var(--ink); color: white; padding: 3.5rem 0; }
  .principle p { font-size: 1.2rem; color: #ddd7ca; }
  .principle strong { font-size: 1.35rem; }

  .translation-note { padding: 4rem 0; border-bottom: 1px solid var(--line); background: var(--card); }
  .translation-note-inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  .translation-note h2 { margin: .2rem 0 0; }
  .translation-note p:last-child { color: var(--muted); font-size: 1.05rem; }

  .featured { padding: 5rem 0; }
  .cards { display: grid; gap: 2rem; }
  .section-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 2rem; }
  .section-heading h2 { margin: .2rem 0 0; }
  .section-heading > a { flex: 0 0 auto; font-weight: 800; color: var(--accent-dark); }
  .section-intro { margin-bottom: 0; color: var(--muted); }

  .catalogue-preview { padding: 4.5rem 0 5rem; border-top: 1px solid var(--line); background: color-mix(in srgb, var(--card) 66%, var(--paper)); }
  .compact-preview { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }

  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; grid-template-areas: "copy" "art"; row-gap: 2rem; }
    .hero-art img { width: min(100%, 28rem); }
    .translation-note-inner, .compact-preview { grid-template-columns: 1fr; }
    .section-heading { align-items: flex-start; flex-direction: column; }
  }
</style>
