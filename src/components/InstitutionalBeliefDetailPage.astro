---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CorrectionLink from './CorrectionLink.astro';
import ReadingPathNav from './ReadingPathNav.astro';
import Permalink from './Permalink.astro';
import { historicalDescription } from '../lib/socialCards';
import { evidenceRelations, institutionalCorrectionStates } from '../lib/institutionalEvidenceLabels';
import { translationMatchesEntry, type SiteLocale } from '../lib/i18n';
import {
  normalizeInstitutionalBelief,
  type InstitutionalBeliefEntry,
  type InstitutionalBeliefTranslationEntry,
  type NormalizedInstitutionalEvidence,
} from '../lib/institutionalBeliefs';

interface Props {
  belief: InstitutionalBeliefEntry;
  locale?: SiteLocale;
  translation?: InstitutionalBeliefTranslationEntry;
  hasGermanTranslation?: boolean;
}

const {
  belief,
  locale = 'en',
  translation,
  hasGermanTranslation = false,
} = Astro.props;

const entry = normalizeInstitutionalBelief(belief, locale, translation);
const sourceById = new Map(entry.sources.map((source) => [source.id, source]));
const enrichEvidence = (items: NormalizedInstitutionalEvidence[]) => items.map((item) => {
  const source = sourceById.get(item.sourceId);
  if (!source) {
    throw new Error(`${entry.id}: evidence ${item.id} references missing source ${item.sourceId}`);
  }
  return { ...item, source };
});

const beliefEvidence = enrichEvidence(
  entry.evidence.filter((item) => item.target.scope === 'belief'),
);
const episodes = [...entry.episodes]
  .sort((a, b) => a.startYear - b.startYear || a.polity.localeCompare(b.polity, locale))
  .map((episode) => ({
    ...episode,
    evidence: enrichEvidence(
      entry.evidence.filter(
        (item) => item.target.scope === 'episode' && item.target.episodeId === episode.id,
      ),
    ),
  }));
const sourceRows = entry.sources.map((source) => ({
  source,
  evidenceCount: entry.evidence.filter((item) => item.sourceId === source.id).length,
}));

const strengthLabels: Record<string, string> = locale === 'de'
  ? {
      'institutionally-influential': 'Institutionell einflussreich',
      'officially-endorsed': 'Offiziell unterstützt',
      'policy-basis': 'Grundlage staatlicher Praxis',
      'enforced-doctrine': 'Durchgesetzte Doktrin',
    }
  : {
      'institutionally-influential': 'Institutionally influential',
      'officially-endorsed': 'Officially endorsed',
      'policy-basis': 'Policy basis',
      'enforced-doctrine': 'Enforced doctrine',
    };

const institutionTypeLabels: Record<string, string> = locale === 'de'
  ? {
      government: 'Staat',
      court: 'Gericht',
      academy: 'Akademie',
      university: 'Universität',
      medical: 'Medizin',
      professional: 'Fachinstitution',
      education: 'Bildung',
      military: 'Militär',
    }
  : {
      government: 'Government',
      court: 'Court',
      academy: 'Academy',
      university: 'University',
      medical: 'Medical',
      professional: 'Professional',
      education: 'Education',
      military: 'Military',
    };

const mechanismLabels: Record<string, string> = locale === 'de'
  ? {
      endorsement: 'Befürwortung',
      classification: 'Klassifizierung',
      'standard-setting': 'Standardsetzung',
      'administrative-adoption': 'Administrative Übernahme',
      education: 'Ausbildung',
      publication: 'Veröffentlichung',
      funding: 'Finanzierung',
      credentialing: 'Qualifikationsvergabe',
      enforcement: 'Durchsetzung',
      suppression: 'Unterdrückung',
      other: 'Anderer Mechanismus',
    }
  : {
      endorsement: 'Endorsement',
      classification: 'Classification',
      'standard-setting': 'Standard-setting',
      'administrative-adoption': 'Administrative adoption',
      education: 'Education',
      publication: 'Publication',
      funding: 'Funding',
      credentialing: 'Credentialing',
      enforcement: 'Enforcement',
      suppression: 'Suppression',
      other: 'Other mechanism',
    };

const correctionStatusLabels = Object.fromEntries(institutionalCorrectionStates.map(state => [state.id, state.label[locale]]));
const relationLabels = Object.fromEntries(evidenceRelations.map(relation => [relation.id, relation.label[locale]]));

const targetLabels: Record<string, string> = locale === 'de'
  ? {
      proposition: 'Historische Überzeugung',
      correction: 'Heutige Korrektur',
      impact: 'Auswirkungen',
      carrier: 'Institutioneller Träger',
      mechanism: 'Mechanismus',
      consequences: 'Folgen',
      'institutional-correction': 'Institutionelle Korrektur',
      context: 'Kontext',
    }
  : {
      proposition: 'Historical belief',
      correction: 'Present correction',
      impact: 'Impact',
      carrier: 'Institutional carrier',
      mechanism: 'Mechanism',
      consequences: 'Consequences',
      'institutional-correction': 'Institutional correction',
      context: 'Context',
    };

const targetLabel = (evidence: NormalizedInstitutionalEvidence) =>
  targetLabels[evidence.target.aspect] ?? evidence.target.aspect;

const copy = locale === 'de'
  ? {
      back: 'Zur Zeitleiste der institutionellen Überzeugungen',
      eyebrow: 'Institutionelle Überzeugung',
      accepted: 'Was Institutionen akzeptierten',
      current: 'Was die Evidenz heute stützt',
      beliefEvidence: 'Evidenz zur übergeordneten Überzeugung',
      impact: 'Auswirkungen',
      impactContext: 'Einordnung',
      impactCaution:
        'Historische Zahlen und Wirkungen werden als kontextgebundene Evidenz dargestellt, nicht als universelle Kausalbehauptung.',
      episode: 'Institutionelle Episode',
      institutions: 'Beteiligte Institutionen',
      institutionalContext: 'Institutioneller Kontext',
      consequences: 'Folgen',
      why: 'Warum sich die Annahme hielt',
      how: 'Wie die institutionelle Korrektur verlief',
      action: 'Maßnahme',
      evidenceForEpisode: 'Evidenz für diese Episode',
      locator: 'Fundstelle',
      sourceRegistry: 'Quellenregister',
      sourceRegistryIntro:
        'Jede Quelle wird einmal geführt und kann mehrere präzise Evidenzbeziehungen tragen.',
      catalogue: 'Verknüpfter Katalogeintrag',
      reviewed: 'Inhalt geprüft',
      episodes: (count: number) => `${count} ${count === 1 ? 'Episode' : 'Episoden'}`,
      evidenceLinks: (count: number) =>
        `${count} Evidenz${count === 1 ? 'beziehung' : 'beziehungen'}`,
      sources: (count: number) => `${count} ${count === 1 ? 'Quelle' : 'Quellen'}`,
      usedBy: (count: number) =>
        `${count} ${count === 1 ? 'Evidenzbeziehung' : 'Evidenzbeziehungen'}`,
    }
  : {
      back: 'Back to institutional beliefs timeline',
      eyebrow: 'Institutional belief',
      accepted: 'What institutions accepted',
      current: 'What the evidence supports now',
      beliefEvidence: 'Evidence for the overall belief',
      impact: 'Impact',
      impactContext: 'Context',
      impactCaution:
        'Historical totals and effects are presented as contextual evidence, not as universal causal claims.',
      episode: 'Institutional episode',
      institutions: 'Institutions involved',
      institutionalContext: 'Institutional context',
      consequences: 'Consequences',
      why: 'Why this persisted',
      how: 'How correction happened',
      action: 'Action',
      evidenceForEpisode: 'Evidence for this episode',
      locator: 'Where in the source',
      sourceRegistry: 'Source registry',
      sourceRegistryIntro:
        'Each source is registered once and can carry several precise evidence relationships.',
      catalogue: 'Linked catalogue entry',
      reviewed: 'Content reviewed',
      episodes: (count: number) => `${count} ${count === 1 ? 'episode' : 'episodes'}`,
      evidenceLinks: (count: number) =>
        `${count} evidence ${count === 1 ? 'link' : 'links'}`,
      sources: (count: number) => `${count} ${count === 1 ? 'source' : 'sources'}`,
      usedBy: (count: number) => `${count} evidence ${count === 1 ? 'link' : 'links'}`,
    };

const timelinePath = locale === 'de' ? '/de/institutions/' : '/institutions/';
const alternatePath = locale === 'de'
  ? `/institutions/${entry.id}/`
  : hasGermanTranslation
    ? `/de/institutions/${entry.id}/`
    : undefined;

let cataloguePath: string | undefined;
let catalogueTitle: string | undefined;

if (entry.entryId) {
  const catalogueEntries = await getCollection('entries', (item) => item.id === entry.entryId);
  const catalogueEntry = catalogueEntries[0];

  if (catalogueEntry) {
    catalogueTitle = catalogueEntry.data.claim;
    cataloguePath = `/entries/${catalogueEntry.id}/`;

    if (locale === 'de') {
      const catalogueTranslations = await getCollection(
        'entryTranslations',
        (item) =>
          item.data.locale === 'de' &&
          item.data.entryId === catalogueEntry.id &&
          translationMatchesEntry(catalogueEntry, item),
      );
      const catalogueTranslation = catalogueTranslations[0];
      if (catalogueTranslation) {
        catalogueTitle = catalogueTranslation.data.claim;
        cataloguePath = `/de/entries/${catalogueEntry.id}/`;
      }
    }
  }
}

const reviewedDate = entry.reviewedAt.toLocaleDateString(
  locale === 'de' ? 'de-DE' : 'en-GB',
  { dateStyle: 'long' },
);
---

<BaseLayout
  locale={locale}
  title={`${entry.title} — ${locale === 'de' ? 'Institutionelle Überzeugungen' : 'Institutional beliefs'}`}
  description={historicalDescription(entry.proposition, locale)}
  type="article"
  alternatePath={alternatePath}
>
  <article class="institution-case container">
    <a class="back-link" href={timelinePath}>← {copy.back}</a>

    <header class="case-header">
      <div class="case-flags">
        <span class="section-label">{copy.eyebrow}</span>
        <span>{entry.category}</span>
      </div>
      <h1>{entry.title}</h1>
      <div
        class="case-counts"
        aria-label={`${copy.episodes(episodes.length)}, ${copy.evidenceLinks(entry.evidence.length)}, ${copy.sources(entry.sources.length)}`}
      >
        <span>{copy.episodes(episodes.length)}</span>
        <span>{copy.evidenceLinks(entry.evidence.length)}</span>
        <span>{copy.sources(entry.sources.length)}</span>
      </div>
    </header>

    <ReadingPathNav collection="institutions" id={entry.id} locale={locale} compact />

    <nav class="case-navigation" aria-label={locale === 'de' ? 'Auf dieser Seite' : 'On this page'}>
      <p>{locale === 'de' ? 'Auf dieser Seite' : 'On this page'}</p>
      <ul>
        <li><a href="#case-overview">{locale === 'de' ? 'Überblick' : 'Overview'}</a></li>
        {entry.impact && <li><a href="#impact-title">{copy.impact}</a></li>}
        {episodes.map(episode => <li><a href={`#${episode.id}`}>{episode.polity}</a></li>)}
        <li><a href="#source-registry">{copy.sourceRegistry}</a></li>
        <li><a href={`${locale === 'de' ? '/de' : ''}/methodology/#institutional-evidence`}>{locale === 'de' ? 'Evidenz erklärt' : 'Evidence guide'}</a></li>
      </ul>
      <button
        class="evidence-toggle" type="button" hidden aria-expanded="false"
        data-expand-label={locale === 'de' ? 'Alle Evidenzbeziehungen anzeigen' : 'Show all evidence'}
        data-collapse-label={locale === 'de' ? 'Evidenzbeziehungen einklappen' : 'Collapse evidence'}
      >{locale === 'de' ? 'Alle Evidenzbeziehungen anzeigen' : 'Show all evidence'}</button>
    </nav>

    <div class="narrative-grid" id="case-overview">
      <section class="narrative-panel proposition-panel" aria-labelledby="institutional-proposition">
        <p class="section-kicker">01</p>
        <h2 id="institutional-proposition">{copy.accepted}</h2>
        <p>{entry.proposition}</p>
        <Permalink id="institutional-proposition" context={copy.accepted} kind="section" locale={locale} />
      </section>
      <section class="narrative-panel correction-panel" aria-labelledby="present-correction">
        <p class="section-kicker">02</p>
        <h2 id="present-correction">{copy.current}</h2>
        <p>{entry.correction}</p>
        <Permalink id="present-correction" context={copy.current} kind="section" locale={locale} />
      </section>
    </div>

    {beliefEvidence.length > 0 && (
      <section class="belief-evidence evidence-section" aria-labelledby="belief-evidence-title">
        <div class="subsection-heading">
          <div>
            <p class="section-kicker">03</p>
            <h2 id="belief-evidence-title">{copy.beliefEvidence}</h2>
          </div>
          <span>{copy.evidenceLinks(beliefEvidence.length)}</span>
        </div>
        <details class="evidence-disclosure" id="belief-evidence">
          <summary>{locale === 'de' ? 'Quellen, Fundstellen und Erläuterungen öffnen' : 'Open sources, locators and notes'}</summary>
          <ol class="evidence-list">
          {beliefEvidence.map((evidence) => (
            <li class="evidence-item" id={`evidence-${entry.id}-${evidence.id}`}>
              <div class="evidence-badges">
                <span class={`relation-badge relation-${evidence.relation}`}>
                  {relationLabels[evidence.relation]}
                </span>
                <span class="target-badge">{targetLabel(evidence)}</span>
              </div>
              <a
                class="evidence-source"
                href={evidence.source.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {evidence.source.title}
              </a>
              <span class="evidence-publisher">{evidence.source.publisher}</span>
              {evidence.locator && (
                <p class="evidence-locator">
                  <strong>{copy.locator}:</strong> {evidence.locator}
                </p>
              )}
              {evidence.note && <p class="evidence-note-copy">{evidence.note}</p>}
              <Permalink id={`evidence-${entry.id}-${evidence.id}`} context={`${targetLabel(evidence)}: ${evidence.source.title}`} locale={locale} />
            </li>
          ))}
          </ol>
        </details>
      </section>
    )}

    {entry.impact && (
      <section class="impact-section" aria-labelledby="impact-title">
        <div class="subsection-heading">
          <div>
            <p class="section-kicker">04</p>
            <h2 id="impact-title">{copy.impact}</h2>
          </div>
        </div>
        <p class="impact-summary">{entry.impact.summary}</p>
        {entry.impact.context.length > 0 && (
          <div class="impact-context">
            <h3>{copy.impactContext}</h3>
            <div>{entry.impact.context.map((paragraph) => <p>{paragraph}</p>)}</div>
          </div>
        )}
        {entry.impact.highlights.length > 0 && (
          <div class="impact-grid">
            {entry.impact.highlights.map((highlight) => (
              <article class="impact-highlight">
                <strong>{highlight.value}</strong>
                <h3>{highlight.label}</h3>
                {highlight.note && <p>{highlight.note}</p>}
              </article>
            ))}
          </div>
        )}
        <p class="impact-caution">{copy.impactCaution}</p>
        <Permalink id="impact-title" context={copy.impact} kind="section" locale={locale} />
      </section>
    )}

    <section class="episodes-section" aria-label={copy.episodes(episodes.length)}>
      {episodes.map((episode, episodeIndex) => (
        <article class="episode-card" id={episode.id}>
          <header class="episode-header">
            <div>
              <p class="section-kicker">
                {copy.episode} {String(episodeIndex + 1).padStart(2, '0')}
              </p>
              <h2>{episode.polity}</h2>
              <p class="episode-region">{episode.regionLabel}</p>
            </div>
            <div class="episode-meta">
              <span class="period-badge">{episode.period}</span>
              <span class={`strength-badge strength-${episode.strength}`}>
                {strengthLabels[episode.strength] ?? episode.strength}
              </span>
            </div>
          </header>

          <Permalink id={episode.id} context={episode.polity} kind="episode" locale={locale} />

          <p class="episode-summary">{episode.summary}</p>

          <div class="institution-block">
            <div>
              <h3>{copy.institutions}</h3>
              <div class="type-badges">
                {episode.institutionTypes.map((type) => (
                  <span>{institutionTypeLabels[type] ?? type}</span>
                ))}
              </div>
            </div>
            <ul>{episode.institutions.map((institution) => <li>{institution}</li>)}</ul>
          </div>

          {episode.institutionalContext && (
            <section class="context-block">
              <h3>{copy.institutionalContext}</h3>
              <p>{episode.institutionalContext}</p>
            </section>
          )}

          <div class="explanation-grid">
            <section class="explanation-panel mechanism-panel">
              <div class="explanation-title">
                <h3>{copy.why}</h3>
                {episode.mechanism?.kind && (
                  <span>{mechanismLabels[episode.mechanism.kind] ?? episode.mechanism.kind}</span>
                )}
              </div>
              <p>{episode.mechanism?.summary}</p>
            </section>

            <section class="explanation-panel correction-process-panel">
              <div class="explanation-title">
                <h3>{copy.how}</h3>
                <span class={`status-badge status-${episode.institutionalCorrection?.status}`}>
                  {episode.institutionalCorrection &&
                    correctionStatusLabels[episode.institutionalCorrection.status]}
                </span>
              </div>
              {episode.institutionalCorrection?.periodLabel && (
                <p class="correction-period">{episode.institutionalCorrection.periodLabel}</p>
              )}
              {episode.institutionalCorrection?.action && (
                <p class="correction-action">
                  <strong>{copy.action}:</strong> {episode.institutionalCorrection.action}
                </p>
              )}
              <p>{episode.institutionalCorrection?.summary}</p>
            </section>
          </div>

          <section class="consequences-block">
            <h3>{copy.consequences}</h3>
            <ul>{episode.consequences.map((consequence) => <li>{consequence}</li>)}</ul>
          </section>

          <section
            class="evidence-section episode-evidence"
            aria-labelledby={`episode-evidence-${episode.id}`}
          >
            <div class="subsection-heading">
              <h3 id={`episode-evidence-${episode.id}`}>{copy.evidenceForEpisode}</h3>
              <span>{copy.evidenceLinks(episode.evidence.length)}</span>
            </div>
            <details class="evidence-disclosure" id={`episode-evidence-block-${episode.id}`}>
              <summary>{locale === 'de' ? 'Quellen, Fundstellen und Erläuterungen öffnen' : 'Open sources, locators and notes'}</summary>
              <ol class="evidence-list">
              {episode.evidence.map((evidence) => (
                <li class="evidence-item" id={`evidence-${entry.id}-${evidence.id}`}>
                  <div class="evidence-badges">
                    <span class={`relation-badge relation-${evidence.relation}`}>
                      {relationLabels[evidence.relation]}
                    </span>
                    <span class="target-badge">{targetLabel(evidence)}</span>
                  </div>
                  <a
                    class="evidence-source"
                    href={evidence.source.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {evidence.source.title}
                  </a>
                  <span class="evidence-publisher">{evidence.source.publisher}</span>
                  {evidence.locator && (
                    <p class="evidence-locator">
                      <strong>{copy.locator}:</strong> {evidence.locator}
                    </p>
                  )}
                  {evidence.note && <p class="evidence-note-copy">{evidence.note}</p>}
                  <Permalink id={`evidence-${entry.id}-${evidence.id}`} context={`${targetLabel(evidence)}: ${evidence.source.title}`} locale={locale} />
                </li>
              ))}
              </ol>
            </details>
          </section>
        </article>
      ))}
    </section>

    <details class="source-registry" id="source-registry">
      <summary>
        <span>
          <strong>{copy.sourceRegistry}</strong>
          <small>{copy.sourceRegistryIntro}</small>
        </span>
        <span>{copy.sources(sourceRows.length)}</span>
      </summary>
      <ol>
        {sourceRows.map(({ source, evidenceCount }, sourceIndex) => (
          <li id={`source-${entry.id}-${source.id}`}>
            <span class="source-number">{String(sourceIndex + 1).padStart(2, '0')}</span>
            <div>
              <a href={source.url} target="_blank" rel="noopener noreferrer">{source.title}</a>
              <span>{source.publisher}</span>
              <Permalink id={`source-${entry.id}-${source.id}`} context={source.title} kind="source" locale={locale} />
            </div>
            <small>{copy.usedBy(evidenceCount)}</small>
          </li>
        ))}
      </ol>
    </details>

    {cataloguePath && (
      <aside class="catalogue-link">
        <span>{copy.catalogue}</span>
        <a href={cataloguePath}>{catalogueTitle ?? entry.entryId} →</a>
      </aside>
    )}

    <ReadingPathNav collection="institutions" id={entry.id} locale={locale} />

    <footer class="case-footer">
      <span>{copy.reviewed}: {reviewedDate}</span>
      <CorrectionLink locale={locale} />
      <a href={timelinePath}>← {copy.back}</a>
    </footer>
  </article>
</BaseLayout>

<script>
  const evidenceSections = Array.from(document.querySelectorAll<HTMLDetailsElement>('.evidence-disclosure'));
  const toggle = document.querySelector<HTMLButtonElement>('.evidence-toggle');
  const updateToggle = () => {
    if (!toggle) return;
    const expanded = evidenceSections.every(section => section.open);
    toggle.setAttribute('aria-expanded', String(expanded));
    toggle.textContent = expanded ? toggle.dataset.collapseLabel! : toggle.dataset.expandLabel!;
  };
  if (toggle && evidenceSections.length) {
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      const open = !evidenceSections.every(section => section.open);
      for (const section of evidenceSections) section.open = open;
      updateToggle();
    });
    for (const section of evidenceSections) section.addEventListener('toggle', updateToggle);
  }
  // Direct links to an evidence relationship or registry source remain usable when folded.
  const revealFragment = () => {
    let id: string;
    try { id = decodeURIComponent(window.location.hash.slice(1)); } catch { return; }
    const target = id ? document.getElementById(id) : null;
    if (!target) return;
    for (let node: HTMLElement | null = target; node; node = node.parentElement) {
      if (node instanceof HTMLDetailsElement) node.open = true;
    }
    window.requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
  };
  window.addEventListener('hashchange', revealFragment);
  revealFragment();
  let printState: Array<[HTMLDetailsElement, boolean]> = [];
  window.addEventListener('beforeprint', () => {
    printState = Array.from(document.querySelectorAll<HTMLDetailsElement>('.institution-case details'))
      .map(section => [section, section.open]);
    for (const [section] of printState) section.open = true;
  });
  window.addEventListener('afterprint', () => {
    for (const [section, open] of printState) section.open = open;
  });
</script>

<style>
  .institution-case {
    max-width: 1180px;
    padding: 3.5rem 0 6rem;
  }

  .case-navigation {
    margin: 1.4rem 0 2rem;
    padding: 1.1rem 1.25rem;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 0.8rem;
  }
  .case-navigation p { margin: 0 0 0.65rem; font-size: 0.85rem; font-weight: 800; }
  .case-navigation ul { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; list-style: none; margin: 0; padding: 0; }
  .case-navigation a { color: var(--accent-dark); font-size: 0.9rem; font-weight: 700; text-underline-offset: 0.2em; }
  .evidence-toggle { margin-top: 1rem; border: 1px solid var(--line); border-radius: 0.4rem; padding: 0.55rem 0.75rem; background: var(--paper); color: var(--ink); font: inherit; font-size: 0.85rem; cursor: pointer; }
  .evidence-toggle[hidden] { display: none; }
  .evidence-disclosure { margin-top: 0.8rem; }
  .evidence-disclosure > summary { cursor: pointer; color: var(--accent-dark); font-weight: 750; padding: 0.85rem 1rem; border: 1px solid var(--line); border-radius: 0.5rem; background: var(--card); }
  .evidence-disclosure[open] > summary { margin-bottom: 1rem; }
  .institution-case :global([id]) { scroll-margin-top: 1rem; }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--accent-dark);
    font-size: 0.88rem;
    font-weight: 780;
    text-underline-offset: 0.2em;
  }

  .case-header {
    padding-bottom: 2.5rem;
    border-bottom: 3px solid var(--ink);
  }

  .case-header h1 {
    margin: 0.75rem 0 0;
    max-width: 1000px;
    font-size: clamp(2.8rem, 7vw, 5.6rem);
    line-height: 0.95;
  }

  .case-flags,
  .case-counts,
  .type-badges,
  .evidence-badges {
    display: flex;
