---
import { getCollection } from 'astro:content';
import type { SiteLocale } from '../lib/i18n';

interface Props {
  locale?: SiteLocale;
}

const { locale = 'en' } = Astro.props;

const beliefs = await getCollection('institutionalBeliefs');
const translations = locale === 'de'
  ? await getCollection(
      'institutionalBeliefTranslations',
      (translation) => translation.data.locale === 'de',
    )
  : [];

const translationById = new Map(
  translations.map((translation) => [translation.data.entryId, translation]),
);

const strengthLabels: Record<string, string> = locale === 'de'
  ? {
      'institutionally-influential': 'Institutionell einflussreich',
      'officially-endorsed': 'Offiziell unterstützt',
      'policy-basis': 'Grundlage staatlicher Praxis',
      'enforced-doctrine': 'Durchgesetzte Doktrin',
    }
  : {
      'institutionally-influential': 'Institutionally influential',
      'officially-endorsed': 'Officially endorsed',
      'policy-basis': 'Policy basis',
      'enforced-doctrine': 'Enforced doctrine',
    };

const strengthRanks: Record<string, number> = {
  'institutionally-influential': 1,
  'officially-endorsed': 2,
  'policy-basis': 3,
  'enforced-doctrine': 4,
};

const typeLabels: Record<string, string> = locale === 'de'
  ? {
      government: 'Staat',
      court: 'Gericht',
      academy: 'Akademie',
      university: 'Universität',
      medical: 'Medizin',
      professional: 'Fachinstitution',
      education: 'Bildung',
      military: 'Militär',
    }
  : {
      government: 'Government',
      court: 'Court',
      academy: 'Academy',
      university: 'University',
      medical: 'Medical',
      professional: 'Professional',
      education: 'Education',
      military: 'Military',
    };

const formatPeriod = (startYear: number, endYear: number, endOpen = false) => {
  if (startYear === endYear) return `${startYear}${endOpen ? '+' : ''}`;
  return `${startYear}–${endYear}${endOpen ? '+' : ''}`;
};

const compactInstitutionLabel = (institutions: string[]) => {
  if (institutions.length <= 2) return institutions.join(' · ');
  const more = institutions.length - 2;
  return `${institutions.slice(0, 2).join(' · ')} · +${more} ${locale === 'de' ? 'weitere' : 'more'}`;
};

const entries = beliefs.map((belief) => {
  const translation = translationById.get(belief.id);
  const isCurrentTranslation = translation
    ? translation.data.sourceReviewedAt.getTime() === belief.data.reviewedAt.getTime()
    : false;
  const localized = locale === 'de' && isCurrentTranslation ? translation : undefined;
  const translatedEpisodes = new Map(
    localized?.data.episodes.map((episode) => [episode.id, episode]) ?? [],
  );

  return {
    belief,
    title: localized?.data.title ?? belief.data.title,
    claim: localized?.data.claim ?? belief.data.claim,
    currentUnderstanding:
      localized?.data.currentUnderstanding ?? belief.data.currentUnderstanding,
    episodes: belief.data.episodes.map((episode) => {
      const translatedEpisode = translatedEpisodes.get(episode.id);
      return {
        ...episode,
        period: formatPeriod(episode.startYear, episode.endYear, episode.endOpen),
        polity: translatedEpisode?.polity ?? episode.polity,
        institutions: translatedEpisode?.institutions ?? episode.institutions,
        institutionalContext:
          translatedEpisode?.institutionalContext ?? episode.institutionalContext,
        summary: translatedEpisode?.summary ?? episode.summary,
        consequences: translatedEpisode?.consequences ?? episode.consequences,
      };
    }).sort((a, b) =>
      a.startYear - b.startYear ||
      a.polity.localeCompare(b.polity, locale)
    ),
  };
}).sort((a, b) => {
  const aStart = Math.min(...a.episodes.map((episode) => episode.startYear));
  const bStart = Math.min(...b.episodes.map((episode) => episode.startYear));
  return aStart - bStart || a.title.localeCompare(b.title, locale);
});

const regions = [...new Set(
  entries.flatMap((item) => item.episodes.map((episode) => episode.region)),
)].sort((a, b) => a.localeCompare(b, locale));

const polityGroupFor = (polity: string) => {
  for (const separator of [' — ', ' – ', ' - ']) {
    if (polity.includes(separator)) {
      return polity.split(separator)[0].trim();
    }
  }
  return polity;
};

const polityFilters = [...new Set(
  entries.flatMap((item) => item.episodes.map((episode) => polityGroupFor(episode.polity))),
)].sort((a, b) => a.localeCompare(b, locale));

const types = [...new Set(
  entries.flatMap((item) => item.episodes.flatMap((episode) => episode.institutionTypes)),
)].sort((a, b) => typeLabels[a].localeCompare(typeLabels[b], locale));

const strengths = [
  'institutionally-influential',
  'officially-endorsed',
  'policy-basis',
  'enforced-doctrine',
].filter((strength) =>
  entries.some((item) => item.episodes.some((episode) => episode.strength === strength))
);

const decadeFor = (year: number) => Math.floor(year / 10) * 10;

const allDecades = [...new Set(
  entries.flatMap((item) =>
    item.episodes.flatMap((episode) => {
      const decades: number[] = [];
      for (
        let decade = decadeFor(episode.startYear);
        decade <= decadeFor(episode.endYear);
        decade += 10
      ) {
        decades.push(decade);
      }
      return decades;
    })
  ),
)].sort((a, b) => a - b);

const formatDecade = (decade: number) =>
  locale === 'de' ? `${decade}er` : `${decade}s`;

const entryPath = (entryId: string) => locale === 'de'
  ? `/de/entries/${entryId}/`
  : `/entries/${entryId}/`;

const casePath = (beliefId: string) => locale === 'de'
  ? `/de/institutions/${beliefId}/`
  : `/institutions/${beliefId}/`;

const copy = locale === 'de'
  ? {
      eyebrow: 'Wenn Behauptungen Macht bekommen',
      title: 'Institutionelle Überzeugungen',
      intro:
        'Diese Zeitleiste verfolgt Aussagen, die nicht nur geglaubt wurden, sondern genügend institutionelle Autorität erhielten, um Forschung, Lehre, Medizin, Recht oder staatliche Praxis zu prägen.',
      ruleTitle: 'Was hier aufgenommen wird',
      ruleBody:
        'Ein Fall gehört hierher, wenn sich benennen lässt, welche Institution die Aussage als etabliertes Wissen behandelte, wann das geschah und welche Folgen daraus entstanden. Die Seite setzt unterschiedliche Regime, Länder oder Institutionen nicht gleich; die Intensität der Institutionalisierung wird ausdrücklich gekennzeichnet.',
      chronologyTitle: 'Was galt gleichzeitig?',
      chronologyBody:
        'Die Jahrzehntansicht macht sichtbar, welche institutionellen Überzeugungen etwa in den 1950er- oder 1960er-Jahren gleichzeitig in verschiedenen Ländern wirkten, während jede nationale oder institutionelle Episode als ein zusammenhängender historischer Fall bestehen bleibt.',
      coverageNote:
        'Die Sammlung wächst. Fehlende Länder oder Zeiträume bedeuten fehlende Abdeckung, nicht das Fehlen institutioneller Irrtümer. Sie ist weder ein Ranking von Staaten noch eine vollständige Weltgeschichte.',
      levelsTitle: 'Stufen der Institutionalisierung',
      levels: {
        'institutionally-influential': 'In einflussreichen Fachkreisen oder Einrichtungen verwendet, aber nicht als staatliche Doktrin.',
        'officially-endorsed': 'Von maßgeblichen staatlichen oder fachlichen Institutionen ausdrücklich unterstützt.',
        'policy-basis': 'Als Grundlage für Gesetze, Verwaltung, medizinische Praxis oder andere konkrete Politik verwendet.',
        'enforced-doctrine': 'Institutionell durchgesetzt; konkurrierende wissenschaftliche Positionen wurden eingeschränkt oder unterdrückt.',
      },
      search: 'Überzeugungen durchsuchen…',
      cards: 'Karten',
      compact: 'Kompakt',
      view: 'Ansicht',
      filters: 'Filter',
      filterTitle: 'Institutionelle Überzeugungen filtern',
      filterHelp: 'Innerhalb einer Gruppe sind mehrere Auswahlen möglich. Zwischen Gruppen werden die Filter kombiniert.',
      filterDecade: 'Jahrzehnt',
      filterRegion: 'Region',
      filterPolity: 'Land / politischer Raum',
      filterType: 'Institutionstyp',
      filterStrength: 'Stufe',
      clearAll: 'Alle löschen',
      closeFilters: 'Filter schließen',
      showResults: (count: number) => count === 1 ? '1 Ergebnis anzeigen' : `${count} Ergebnisse anzeigen`,
      institutions: 'Institutionen',
      consequences: 'Folgen',
      evidence: 'Belege zur Institutionalisierung',
      linkedEntry: 'Zum Katalogeintrag',
      moreOnCase: 'weitere auf der Detailseite',
      current: 'Heutiger Wissensstand',
      noResults: 'Keine institutionellen Fälle entsprechen diesen Filtern.',
      episodes: (count: number) => `${count} ${count === 1 ? 'Episode' : 'Episoden'}`,
      polities: (count: number) => `${count} politische Räume`,
      resultSummary: (episodes: number, groups: number) =>
        `${episodes} institutionelle Episoden in ${groups} Themen`,
      highestLevel: (count: number) =>
        `Höchste Stufe unter ${count} passenden Episoden`,
    }
  : {
      eyebrow: 'When claims acquire power',
      title: 'Institutional beliefs',
      intro:
        'This timeline tracks claims that were not merely believed, but acquired enough institutional authority to shape research, education, medicine, law, or public policy.',
      ruleTitle: 'What qualifies',
      ruleBody:
        'A case belongs here when we can identify which institution treated the claim as established knowledge, when that happened, and what followed from it. The page does not equate different regimes, countries, or institutions; the degree of institutionalization is labeled explicitly.',
      chronologyTitle: 'What was authoritative at the same time?',
      chronologyBody:
        'The decade view makes it possible to ask which institutional beliefs were operating around the world during the 1950s or 1960s, while each country or institutional episode remains a single continuous historical case.',
      coverageNote:
        'This is a growing research collection. Missing countries or periods mean missing coverage, not an absence of institutional error. It is neither a ranking of states nor a complete world history.',
      levelsTitle: 'Levels of institutionalization',
      levels: {
        'institutionally-influential': 'Used within influential professional circles or institutions without becoming state doctrine.',
        'officially-endorsed': 'Explicitly backed by major state or professional institutions.',
        'policy-basis': 'Used to justify laws, administration, medical practice, or other concrete policy.',
        'enforced-doctrine': 'Institutionally enforced; competing scientific positions were restricted or suppressed.',
      },
      search: 'Search institutional beliefs…',
      cards: 'Cards',
      compact: 'Compact',
      view: 'View',
      filters: 'Filters',
      filterTitle: 'Filter institutional beliefs',
      filterHelp: 'Choose multiple options within a group. Different filter groups are combined.',
      filterDecade: 'Decade',
      filterRegion: 'Region',
      filterPolity: 'Country / polity',
      filterType: 'Institution type',
      filterStrength: 'Level',
      clearAll: 'Clear all',
      closeFilters: 'Close filters',
      showResults: (count: number) => count === 1 ? 'Show 1 result' : `Show ${count} results`,
      institutions: 'Institutions',
      consequences: 'Consequences',
      evidence: 'Institutional evidence',
      linkedEntry: 'Open catalogue entry',
      moreOnCase: 'more on the case page',
      current: 'Current understanding',
      noResults: 'No institutional cases match those filters.',
      episodes: (count: number) => `${count} ${count === 1 ? 'episode' : 'episodes'}`,
      polities: (count: number) => `${count} polities`,
      resultSummary: (episodes: number, groups: number) =>
        `${episodes} institutional episodes across ${groups} beliefs`,
      highestLevel: (count: number) =>
        `Highest level among ${count} matching episodes`,
    };

const levelDescriptions: Record<string, string> = copy.levels;
const allEpisodes = entries.flatMap((item) => item.episodes);
const totalEpisodes = allEpisodes.length;

const countEpisodes = (predicate: (episode: typeof allEpisodes[number]) => boolean) =>
  allEpisodes.filter(predicate).length;

const highestStrengthFor = (episodes: typeof allEpisodes) =>
  episodes.reduce(
    (highest, episode) =>
      strengthRanks[episode.strength] > strengthRanks[highest]
        ? episode.strength
        : highest,
    'institutionally-influential',
  );

const compactPeriodFor = (episodes: typeof allEpisodes) => {
  const startYear = Math.min(...episodes.map((episode) => episode.startYear));
  const endYear = Math.max(...episodes.map((episode) => episode.endYear));
  const endOpen = episodes.some(
    (episode) => episode.endOpen && episode.endYear === endYear,
  );
  return formatPeriod(startYear, endYear, endOpen);
};

const compactPolitiesFor = (episodes: typeof allEpisodes) =>
  [...new Set(episodes.map((episode) => episode.polity))].join(' · ');
---

<header class="institutional-head container">
  <p class="eyebrow">{copy.eyebrow}</p>
  <h1>{copy.title}</h1>
  <p class="institutional-intro">{copy.intro}</p>

  <div class="definition-grid">
    <section class="definition-card">
      <h2>{copy.ruleTitle}</h2>
      <p>{copy.ruleBody}</p>
    </section>
    <section class="definition-card">
      <h2>{copy.chronologyTitle}</h2>
      <p>{copy.chronologyBody}</p>
    </section>
  </div>

  <p class="coverage-note">{copy.coverageNote}</p>

  <section class="level-legend" aria-labelledby="institutional-levels-title">
    <h2 id="institutional-levels-title">{copy.levelsTitle}</h2>
    <div class="level-grid">
      {strengths.map((strength) => (
        <div>
          <span class={`strength strength-${strength}`}>{strengthLabels[strength]}</span>
          <p>{levelDescriptions[strength]}</p>
        </div>
      ))}
    </div>
  </section>
</header>

<section
  class="institutional-controls"
  aria-label={locale === 'de' ? 'Filter für institutionelle Überzeugungen' : 'Institutional belief filters'}
>
  <div class="container filter-inner">
    <div class="primary-controls">
      <label class="search-field">
        <span class="sr-only">{locale === 'de' ? 'Suchen' : 'Search'}</span>
        <input
          class="institutional-search"
          type="search"
          placeholder={copy.search}
          autocomplete="off"
        />
      </label>

      <fieldset class="view-switcher">
        <legend class="sr-only">{copy.view}</legend>
        <div class="view-buttons">
          <button class="view-button" type="button" data-view="cards" aria-pressed="true">
            {copy.cards}
          </button>
          <button class="view-button" type="button" data-view="compact" aria-pressed="false">
            {copy.compact}
          </button>
        </div>
      </fieldset>

      <button
        class="filter-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="institutional-filter-panel"
      >
        <span>{copy.filters}</span>
        <span class="filter-count" hidden>0</span>
      </button>
    </div>

    <div class="active-filter-row" hidden>
      <div class="active-filter-chips" aria-label={locale === 'de' ? 'Aktive Filter' : 'Active filters'}></div>
      <button class="clear-filters clear-filters-inline" type="button">{copy.clearAll}</button>
    </div>

    <div class="summary-row">
      <p class="results-summary" aria-live="polite">
        {copy.resultSummary(totalEpisodes, entries.length)}
      </p>
    </div>

    <div
      class="filter-panel"
      id="institutional-filter-panel"
      hidden
      role="dialog"
      aria-labelledby="institutional-filter-title"
    >
      <div class="filter-panel-header">
        <div>
          <p class="filter-panel-title" id="institutional-filter-title">{copy.filterTitle}</p>
          <p class="filter-help">{copy.filterHelp}</p>
        </div>
        <button class="filter-close" type="button" aria-label={copy.closeFilters}>×</button>
      </div>

      <div class="filter-panel-scroll">
        <div class="filter-groups">
          <section>
            <p class="group-label">{copy.filterDecade}</p>
            <div class="filters" role="group" aria-label={copy.filterDecade}>
              {allDecades.map((decade) => {
                const count = countEpisodes(
                  (episode) =>
                    episode.startYear <= decade + 9 && episode.endYear >= decade,
                );
                return (
                  <button
                    class="filter-button"
                    type="button"
                    data-filter-type="decade"
                    data-filter-value={String(decade)}
                    data-filter-label={formatDecade(decade)}
                    aria-pressed="false"
                  >
                    {formatDecade(decade)}<span class="count">{count}</span>
                  </button>
                );
              })}
            </div>
          </section>

          <section>
            <p class="group-label">{copy.filterRegion}</p>
            <div class="filters" role="group" aria-label={copy.filterRegion}>
              {regions.map((region) => (
                <button
                  class="filter-button"
                  type="button"
                  data-filter-type="region"
                  data-filter-value={region}
                  data-filter-label={region}
                  aria-pressed="false"
                >
                  {region}<span class="count">{countEpisodes((episode) => episode.region === region)}</span>
                </button>
              ))}
            </div>
          </section>

          <section>
            <p class="group-label">{copy.filterPolity}</p>
            <div class="filters" role="group" aria-label={copy.filterPolity}>
              {polityFilters.map((polity) => (
                <button
                  class="filter-button"
                  type="button"
                  data-filter-type="polity"
                  data-filter-value={polity}
                  data-filter-label={polity}
                  aria-pressed="false"
                >
                  {polity}<span class="count">{countEpisodes((episode) => polityGroupFor(episode.polity) === polity)}</span>
                </button>
              ))}
            </div>
          </section>

          <section>
            <p class="group-label">{copy.filterType}</p>
            <div class="filters" role="group" aria-label={copy.filterType}>
              {types.map((type) => (
                <button
                  class="filter-button"
                  type="button"
                  data-filter-type="type"
                  data-filter-value={type}
                  data-filter-label={typeLabels[type]}
                  aria-pressed="false"
                >
                  {typeLabels[type]}
                  <span class="count">{countEpisodes((episode) => episode.institutionTypes.includes(type))}</span>
                </button>
              ))}
            </div>
          </section>

          <section>
            <p class="group-label">{copy.filterStrength}</p>
            <div class="filters" role="group" aria-label={copy.filterStrength}>
              {strengths.map((strength) => (
                <button
                  class="filter-button"
                  type="button"
                  data-filter-type="strength"
                  data-filter-value={strength}
                  data-filter-label={strengthLabels[strength]}
                  aria-pressed="false"
                >
                  <span class={`filter-level strength strength-${strength}`}>
                    {strengthLabels[strength]}
                  </span>
                  <span class="count">{countEpisodes((episode) => episode.strength === strength)}</span>
                </button>
              ))}
            </div>
          </section>
        </div>
      </div>

      <div class="filter-panel-actions">
        <button class="clear-filters clear-filters-panel" type="button">{copy.clearAll}</button>
        <button class="apply-filters" type="button">{copy.showResults(totalEpisodes)}</button>
      </div>
    </div>
  </div>
</section>

<div class="belief-groups container">
  {entries.map((item) => {
    const initialHighestStrength = highestStrengthFor(item.episodes);
    return (
      <section
        class="belief-group"
        data-belief-id={item.belief.id}
        data-group-search={`${item.title} ${item.claim} ${item.currentUnderstanding}`.toLowerCase()}
      >
        <header class="belief-heading">
          <div>
            <div class="belief-heading-topline">
              <span>{item.belief.data.category}</span>
              <span class="episode-count">{copy.episodes(item.episodes.length)}</span>
            </div>
            <h2>
              <a href={casePath(item.belief.id)}>{item.title}</a>
            </h2>
            <p class="belief-claim">{item.claim}</p>

            <div class="compact-belief-meta">
              <div class="compact-meta-top">
                <span
                  class={`compact-strength strength strength-${initialHighestStrength}`}
                  data-compact-strength
                >
                  {strengthLabels[initialHighestStrength]}
                </span>
                <span class="compact-period" data-compact-period>
                  {compactPeriodFor(item.episodes)}
                </span>
              </div>
              <span class="compact-polities" data-compact-polities>
                {compactPolitiesFor(item.episodes)}
              </span>
            </div>
          </div>

          <div class="belief-heading-actions">
            <details class="group-current">
              <summary>{copy.current}</summary>
              <p>{item.currentUnderstanding}</p>
            </details>
          </div>
        </header>

        <div class="episode-grid">
          {item.episodes.map((episode) => {
            const searchText = [
              item.title,
              item.claim,
              item.currentUnderstanding,
              episode.polity,
              episode.region,
              episode.period,
              episode.summary,
              episode.institutionalContext ?? '',
              ...episode.institutions,
              ...episode.consequences,
              ...episode.institutionTypes.map((type) => typeLabels[type]),
              strengthLabels[episode.strength],
            ].join(' ').toLowerCase();

            const compactConsequences = episode.consequences.slice(0, 3);
            const hiddenConsequenceCount =
              Math.max(0, episode.consequences.length - compactConsequences.length);

            return (
              <article
                class="episode-card"
                data-start-year={episode.startYear}
                data-end-year={episode.endYear}
                data-end-open={episode.endOpen ? 'true' : 'false'}
                data-period={episode.period}
                data-region={episode.region}
                data-polity={episode.polity}
                data-polity-group={polityGroupFor(episode.polity)}
                data-strength={episode.strength}
                data-types={episode.institutionTypes.join('|')}
                data-search={searchText}
              >
                <div class="episode-topline">
                  <span class="polity">{episode.polity}</span>
                  <span class="period">{episode.period}</span>
                </div>

                <span class={`strength strength-${episode.strength}`}>
                  {strengthLabels[episode.strength]}
                </span>

                <p class="episode-summary">{episode.summary}</p>

                <div class="episode-section">
                  <h3>{copy.institutions}</h3>
                  <p>{compactInstitutionLabel(episode.institutions)}</p>
                </div>

                <div class="episode-section">
                  <h3>{copy.consequences}</h3>
                  <ul class="consequence-list">
                    {compactConsequences.map((consequence) => (
                      <li>{consequence}</li>
                    ))}
                    {hiddenConsequenceCount > 0 && (
                      <li class="consequence-more">
                        +{hiddenConsequenceCount} {copy.moreOnCase}
                      </li>
                    )}
                  </ul>
                </div>

                <details class="evidence">
                  <summary>{copy.evidence}</summary>
                  <ul>
                    {episode.sources.map((source) => (
                      <li>
                        <a href={source.url} target="_blank" rel="noreferrer">
                          {source.title}
                        </a>
                        <span>{source.publisher}</span>
                      </li>
                    ))}
                  </ul>
                </details>

                {item.belief.data.entryId && (
                  <a class="entry-link" href={entryPath(item.belief.data.entryId)}>
                    {copy.linkedEntry} →
                  </a>
                )}
              </article>
            );
          })}
        </div>
      </section>
    );
  })}
</div>

<div class="empty-state container" hidden>
  <p>{copy.noResults}</p>
  <button class="clear-filters empty-clear" type="button">{copy.clearAll}</button>
</div>

<noscript>
  <p class="container noscript-note">
    {locale === 'de'
      ? 'Suche, Filter und Kompaktansicht benötigen JavaScript. Alle Episoden werden als Karten angezeigt.'
      : 'Search, filtering, and compact view require JavaScript. All episodes are shown as cards.'}
  </p>
</noscript>

<script>
  const search = document.querySelector<HTMLInputElement>('.institutional-search');
  const filterButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.filter-button')
  );
  const viewButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.view-button')
  );
  const filterToggle = document.querySelector<HTMLButtonElement>('.filter-toggle');
  const filterPanel = document.querySelector<HTMLElement>('.filter-panel');
  const filterClose = document.querySelector<HTMLButtonElement>('.filter-close');
  const applyButton = document.querySelector<HTMLButtonElement>('.apply-filters');
  const clearButtons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('.clear-filters, .empty-clear')
  );
  const filterCount = document.querySelector<HTMLElement>('.filter-count');
  const activeFilterRow = document.querySelector<HTMLElement>('.active-filter-row');
  const activeFilterChips = document.querySelector<HTMLElement>('.active-filter-chips');
  const resultSummary = document.querySelector<HTMLElement>('.results-summary');
  const emptyState = document.querySelector<HTMLElement>('.empty-state');
  const beliefGroups = document.querySelector<HTMLElement>('.belief-groups');
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.belief-group'));

  const locale: 'en' | 'de' =
    document.documentElement.lang.startsWith('de') ? 'de' : 'en';

  const mobileMedia = window.matchMedia('(max-width: 760px)');
  const filterPanelAnchor = filterPanel
    ? document.createComment('institutional-filter-panel-anchor')
    : null;

  if (filterPanel && filterPanelAnchor) {
    filterPanel.before(filterPanelAnchor);
  }

  const selected: Record<string, Set<string>> = {
    decade: new Set<string>(),
    region: new Set<string>(),
    polity: new Set<string>(),
    type: new Set<string>(),
    strength: new Set<string>(),
  };

  const parameterByType: Record<string, string> = {
    decade: 'decades',
    region: 'regions',
    polity: 'polities',
    type: 'types',
    strength: 'strengths',
  };

  const strengthRank: Record<string, number> = {
    'institutionally-influential': 1,
    'officially-endorsed': 2,
    'policy-basis': 3,
    'enforced-doctrine': 4,
  };

  const strengthLabel: Record<string, Record<string, string>> = {
    en: {
      'institutionally-influential': 'Institutionally influential',
      'officially-endorsed': 'Officially endorsed',
      'policy-basis': 'Policy basis',
      'enforced-doctrine': 'Enforced doctrine',
    },
    de: {
      'institutionally-influential': 'Institutionell einflussreich',
      'officially-endorsed': 'Offiziell unterstützt',
      'policy-basis': 'Grundlage staatlicher Praxis',
      'enforced-doctrine': 'Durchgesetzte Doktrin',
    },
  };

  const summaryCopy = {
    en: (episodes: number, groups: number) =>
      `${episodes} institutional episodes across ${groups} beliefs`,
    de: (episodes: number, groups: number) =>
      `${episodes} institutionelle Episoden in ${groups} Themen`,
  };

  const highestCopy = {
    en: (count: number) => `Highest level among ${count} matching episodes`,
    de: (count: number) => `Höchste Stufe unter ${count} passenden Episoden`,
  };

  const showCopy = {
    en: (count: number) => count === 1 ? 'Show 1 result' : `Show ${count} results`,
    de: (count: number) => count === 1 ? '1 Ergebnis anzeigen' : `${count} Ergebnisse anzeigen`,
  };

  let currentView: 'cards' | 'compact' = 'cards';
  let visibleEpisodes = 0;
  let visibleGroups = 0;

  const syncFilterPanelMount = () => {
    if (!filterPanel || !filterPanelAnchor) return;

    if (mobileMedia.matches && !filterPanel.hidden) {
      if (filterPanel.parentElement !== document.body) {
        document.body.append(filterPanel);
      }
      filterPanel.setAttribute('aria-modal', 'true');
      return;
    }

    if (filterPanel.parentElement === document.body && filterPanelAnchor.parentNode) {
      filterPanelAnchor.parentNode.insertBefore(filterPanel, filterPanelAnchor.nextSibling);
    }
    filterPanel.removeAttribute('aria-modal');
  };

  const updateURL = () => {
    const url = new URL(window.location.href);
    const query = search?.value.trim() ?? '';

    Object.entries(parameterByType).forEach(([type, parameter]) => {
      const values = [...selected[type]].sort();
      if (values.length) url.searchParams.set(parameter, values.join(','));
      else url.searchParams.delete(parameter);
    });

    if (query) url.searchParams.set('q', query);
    else url.searchParams.delete('q');

    url.searchParams.set('view', currentView);
    window.history.replaceState({}, '', url);
  };

  const setView = (view: 'cards' | 'compact', persist = true) => {
    currentView = view;
    beliefGroups?.classList.toggle('is-compact', view === 'compact');

    viewButtons.forEach((button) => {
      const active = button.dataset.view === view;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    });

    if (persist) {
      try {
        localStorage.setItem('institutional-beliefs-view', view);
      } catch {}
    }

    updateURL();
  };

  const openFilters = () => {
    if (!filterPanel || !filterToggle) return;
    filterPanel.hidden = false;
    syncFilterPanelMount();
    filterToggle.setAttribute('aria-expanded', 'true');
    document.body.classList.add('filters-open');
    filterPanel.querySelector<HTMLButtonElement>('.filter-button')?.focus();
  };

  const closeFilters = (returnFocus = true) => {
    if (!filterPanel || !filterToggle) return;
    filterPanel.hidden = true;
    syncFilterPanelMount();
    filterToggle.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('filters-open');
    if (returnFocus) filterToggle.focus();
  };

  const updateCompactMeta = (group: HTMLElement, cards: HTMLElement[]) => {
    const badge = group.querySelector<HTMLElement>('[data-compact-strength]');
    const period = group.querySelector<HTMLElement>('[data-compact-period]');
    const polities = group.querySelector<HTMLElement>('[data-compact-polities]');
    if (!badge || !period || !polities || cards.length === 0) return;

    const strengths = [...new Set(cards.map((card) => card.dataset.strength ?? ''))]
      .filter(Boolean);

    const highest = strengths.reduce(
      (best, strength) =>
        (strengthRank[strength] ?? 0) > (strengthRank[best] ?? 0)
          ? strength
          : best,
      'institutionally-influential',
    );

    Object.keys(strengthRank).forEach((strength) => {
      badge.classList.remove(`strength-${strength}`);
    });
    badge.classList.add(`strength-${highest}`);
    badge.textContent = strengthLabel[locale][highest] ?? highest;
    badge.title = strengths.length > 1 ? highestCopy[locale](cards.length) : '';

    const visiblePolities = [...new Set(
      cards.map((card) => card.dataset.polity ?? '').filter(Boolean)
    )];
    const starts = cards.map((card) => Number(card.dataset.startYear));
    const ends = cards.map((card) => Number(card.dataset.endYear));
    const start = Math.min(...starts);
    const end = Math.max(...ends);
    const endOpen = cards.some(
      (card) => card.dataset.endOpen === 'true' && Number(card.dataset.endYear) === end,
    );

    period.textContent = start === end
      ? `${start}${endOpen ? '+' : ''}`
      : `${start}–${end}${endOpen ? '+' : ''}`;
    polities.textContent = visiblePolities.join(' · ');
  };

  const matchesCard = (card: HTMLElement, groupSearch: string, query: string) => {
    const types = (card.dataset.types ?? '').split('|').filter(Boolean);
    const startYear = Number(card.dataset.startYear);
    const endYear = Number(card.dataset.endYear);

    const decadeMatch =
      selected.decade.size === 0 ||
      [...selected.decade].some((value) => {
        const decade = Number(value);
        return startYear <= decade + 9 && endYear >= decade;
      });

    const regionMatch =
      selected.region.size === 0 ||
      selected.region.has(card.dataset.region ?? '');

    const polityMatch =
      selected.polity.size === 0 ||
      selected.polity.has(card.dataset.polityGroup ?? '');

    const strengthMatch =
      selected.strength.size === 0 ||
      selected.strength.has(card.dataset.strength ?? '');

    const typeMatch =
      selected.type.size === 0 ||
      types.some((type) => selected.type.has(type));

    const searchMatch =
      !query ||
      groupSearch.includes(query) ||
      (card.dataset.search ?? '').includes(query);

    return (
      searchMatch &&
      decadeMatch &&
      regionMatch &&
      polityMatch &&
      strengthMatch &&
      typeMatch
    );
  };

  const renderActiveFilters = () => {
    const selections = filterButtons
      .filter((button) => {
        const type = button.dataset.filterType ?? '';
        const value = button.dataset.filterValue ?? '';
        return selected[type]?.has(value);
      })
      .map((button) => ({
        type: button.dataset.filterType ?? '',
        value: button.dataset.filterValue ?? '',
        label: button.dataset.filterLabel ?? button.dataset.filterValue ?? '',
      }));

    if (filterCount) {
      filterCount.textContent = String(selections.length);
      filterCount.hidden = selections.length === 0;
    }

    if (activeFilterRow) activeFilterRow.hidden = selections.length === 0;
    if (!activeFilterChips) return;

    activeFilterChips.replaceChildren();

    selections.forEach(({ type, value, label }) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'active-filter-chip';
      button.setAttribute(
        'aria-label',
        locale === 'de' ? `Filter ${label} entfernen` : `Remove ${label} filter`,
      );

      const text = document.createElement('span');
      text.textContent = label;

      const remove = document.createElement('span');
      remove.setAttribute('aria-hidden', 'true');
      remove.textContent = '×';

      button.append(text, remove);
      button.addEventListener('click', () => {
        selected[type]?.delete(value);
        apply();
      });
      activeFilterChips.append(button);
    });
  };

  const apply = () => {
    const query = search?.value.trim().toLowerCase() ?? '';
    visibleEpisodes = 0;
    visibleGroups = 0;

    groups.forEach((group) => {
      const groupSearch = group.dataset.groupSearch ?? '';
      const cards = Array.from(group.querySelectorAll<HTMLElement>('.episode-card'));
      const matchingCards: HTMLElement[] = [];

      cards.forEach((card) => {
        const matches = matchesCard(card, groupSearch, query);
        card.hidden = !matches;
        if (matches) matchingCards.push(card);
      });

      group.hidden = matchingCards.length === 0;

      if (matchingCards.length > 0) {
        visibleGroups += 1;
        visibleEpisodes += matchingCards.length;
        updateCompactMeta(group, matchingCards);
      }

      const count = group.querySelector<HTMLElement>('.episode-count');
      if (count) {
        count.textContent = locale === 'de'
          ? `${matchingCards.length} ${matchingCards.length === 1 ? 'Episode' : 'Episoden'}`
          : `${matchingCards.length} ${matchingCards.length === 1 ? 'episode' : 'episodes'}`;
      }
    });

    filterButtons.forEach((button) => {
      const type = button.dataset.filterType ?? '';
      const value = button.dataset.filterValue ?? '';
      const active = selected[type]?.has(value) ?? false;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    });

    if (resultSummary) {
      resultSummary.textContent = summaryCopy[locale](visibleEpisodes, visibleGroups);
    }

    if (applyButton) {
      applyButton.textContent = showCopy[locale](visibleEpisodes);
    }

    if (emptyState) emptyState.hidden = visibleEpisodes > 0;

    renderActiveFilters();
    updateURL();
  };

  const clearFilters = () => {
    Object.values(selected).forEach((set) => set.clear());
    if (search) search.value = '';
    apply();
  };

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const type = button.dataset.filterType ?? '';
      const value = button.dataset.filterValue ?? '';
      const set = selected[type];
      if (!set || !value) return;

      set.has(value) ? set.delete(value) : set.add(value);
      apply();
    });
  });

  viewButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const view = button.dataset.view;
      if (view === 'cards' || view === 'compact') setView(view, true);
    });
  });

  search?.addEventListener('input', apply);
  filterToggle?.addEventListener('click', () => {
    filterPanel?.hidden ? openFilters() : closeFilters();
  });
  filterClose?.addEventListener('click', () => closeFilters());
  applyButton?.addEventListener('click', () => closeFilters());
  clearButtons.forEach((button) => button.addEventListener('click', clearFilters));
  mobileMedia.addEventListener('change', syncFilterPanelMount);

  document.addEventListener('click', (event) => {
    if (
      filterPanel &&
      !filterPanel.hidden &&
      !mobileMedia.matches &&
      event.target instanceof Node &&
      !filterPanel.contains(event.target) &&
      !filterToggle?.contains(event.target)
    ) {
      closeFilters(false);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && filterPanel && !filterPanel.hidden) {
      closeFilters();
    }
  });

  filterPanel?.addEventListener('keydown', (event) => {
    if (event.key !== 'Tab' || !mobileMedia.matches) return;

    const focusable = Array.from(
      filterPanel.querySelectorAll<HTMLElement>(
        'button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])'
      )
    ).filter((element) => !element.hasAttribute('hidden'));

    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  const url = new URL(window.location.href);

  Object.entries(parameterByType).forEach(([type, parameter]) => {
    url.searchParams
      .get(parameter)
      ?.split(',')
      .map((value) => value.trim())
      .filter(Boolean)
      .forEach((value) => selected[type].add(value));
  });

  if (search) search.value = url.searchParams.get('q') ?? '';

  let savedView: string | null = null;
  try {
    savedView = localStorage.getItem('institutional-beliefs-view');
  } catch {}

  const requestedView = url.searchParams.get('view');
  const initialView =
    requestedView === 'cards' || requestedView === 'compact'
      ? requestedView
      : savedView === 'cards' || savedView === 'compact'
        ? savedView
        : mobileMedia.matches
          ? 'compact'
          : 'cards';

  setView(initialView, false);
  apply();
</script>

