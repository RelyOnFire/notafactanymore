---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CompactClaim from '../components/CompactClaim.astro';
import FactCard from '../components/FactCard.astro';

const entries = await getCollection('entries');

const featured = entries
  .filter((entry) => entry.data.featured)
  .sort((a, b) => (a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999));

const claimCollator = new Intl.Collator('en', {
  sensitivity: 'base',
  numeric: true,
});

const claimSortKey = (claim: string) => {
  let key = claim.trim();

  const leadingWords = /^(?:a|an|all|every|most|the|there)(?:\s+|\b)\s*/i;
  let previous = '';

  while (key !== previous) {
    previous = key;
    key = key.replace(leadingWords, '');
  }

  return key.replace(/^[^\p{L}\p{N}]+/u, '').trim() || claim.trim();
};

const compareBySubject = (
  a: (typeof entries)[number],
  b: (typeof entries)[number],
) => {
  const bySubject = claimCollator.compare(
    claimSortKey(a.data.claim),
    claimSortKey(b.data.claim),
  );

  return bySubject || claimCollator.compare(a.data.claim, b.data.claim);
};

const compareByRecencyThenSubject = (
  a: (typeof entries)[number],
  b: (typeof entries)[number],
) => {
  const byDate = b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
  return byDate || compareBySubject(a, b);
};

const PREVIEW_SIZE = 12;
const RECENT_POOL_SIZE = 60;
const MAX_PER_CATEGORY = 2;

const recentPool = [...entries]
  .sort(compareByRecencyThenSubject)
  .slice(0, RECENT_POOL_SIZE);

const categoryQueues = new Map<string, typeof recentPool>();

for (const entry of recentPool) {
  const queue = categoryQueues.get(entry.data.category) ?? [];
  queue.push(entry);
  categoryQueues.set(entry.data.category, queue);
}

const categoryOrder = [...categoryQueues.keys()].sort((a, b) => {
  const newestA = categoryQueues.get(a)?.[0];
  const newestB = categoryQueues.get(b)?.[0];

  if (newestA && newestB) {
    const byDate =
      newestB.data.publishedAt.getTime() - newestA.data.publishedAt.getTime();

    if (byDate !== 0) {
      return byDate;
    }
  }

  return claimCollator.compare(a, b);
});

const diverseRecent: typeof recentPool = [];

for (
  let round = 0;
  round < MAX_PER_CATEGORY && diverseRecent.length < PREVIEW_SIZE;
  round += 1
) {
  for (const category of categoryOrder) {
    const entry = categoryQueues.get(category)?.[round];

    if (entry) {
      diverseRecent.push(entry);
    }

    if (diverseRecent.length >= PREVIEW_SIZE) {
      break;
    }
  }
}

if (diverseRecent.length < PREVIEW_SIZE) {
  const selectedIds = new Set(diverseRecent.map((entry) => entry.id));

  for (const entry of recentPool) {
    if (!selectedIds.has(entry.id)) {
      diverseRecent.push(entry);
      selectedIds.add(entry.id);
    }

    if (diverseRecent.length >= PREVIEW_SIZE) {
      break;
    }
  }
}

const recent = diverseRecent.sort(compareBySubject);

const timelineTeaserIds = [
  'earth-centered-universe',
  'doctors-do-not-spread-puerperal-fever',
  'humans-have-48-chromosomes',
  'universe-expansion-slowing',
  'kilogram-must-be-a-metal-cylinder',
];

const timelineTeaser = timelineTeaserIds
  .map((id) => entries.find((entry) => entry.id === id))
  .filter((entry): entry is (typeof entries)[number] => Boolean(entry))
  .sort((a, b) => a.data.timelineYear - b.data.timelineYear);

const currentYear = new Date().getFullYear();
---
<BaseLayout>
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow">Facts have a history.</p>
      <h1>Knowledge changes.<br />The record should too.</h1>
      <p class="intro">
        A catalogue of claims that were once reasonably accepted as factual but
        were later overturned, replaced, narrowed, reclassified, or corrected
        by better evidence.
      </p>
    </div>

    <div class="hero-art" aria-hidden="true">
      <img
        src="/images/cat-oracle-hero-site-bg.webp"
        alt=""
        width="1200"
        height="800"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <div class="actions">
      <a class="button" href="/browse">Browse the catalogue</a>
      <a class="button secondary" href="/submit">Submit a claim</a>
    </div>
  </section>

  <section class="principle">
    <div class="narrow">
      <p>
        This is not a collection of myths, failed predictions, or things
        somebody once said. Every entry must show that the previous claim was
        genuinely supported or treated as authoritative, and that the present
        understanding is backed by stronger evidence.
      </p>
      <strong>Being wrong is not the failure. Refusing to update is.</strong>
    </div>
  </section>

  <section class="school-feature">
    <div class="container school-feature-inner">
      <div class="school-feature-copy">
        <p class="eyebrow">Your scientific timeline</p>
        <h2>What changed since you started school?</h2>
        <p>
          See which parts of the scientific record changed during or after
          your education.
        </p>
      </div>

      <form class="school-form" action="/timeline" method="get">
        <label for="school-year">I started school in</label>
        <div class="school-form-row">
          <input
            id="school-year"
            name="since"
            type="number"
            min="1900"
            max={currentYear}
            placeholder="1994"
            inputmode="numeric"
            required
          />
          <input type="hidden" name="direction" value="oldest" />
          <button type="submit">See what changed →</button>
        </div>
      </form>
    </div>
  </section>

  <section class="container featured">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Featured entries</p>
        <h2>Clear examples of knowledge updating</h2>
      </div>
      <a href="/browse">View all entries →</a>
    </div>

    <div class="cards">
      {featured.map((entry) => <FactCard entry={entry} expanded />)}
    </div>
  </section>

  <section class="timeline-preview">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">The record through time</p>
          <h2>Centuries of changing knowledge</h2>
          <p class="section-intro">
            Follow a few landmark corrections across the historical record, or
            explore every entry in chronological order.
          </p>
        </div>
        <a href="/timeline">Explore the full timeline →</a>
      </div>

      <div class="timeline-strip">
        {timelineTeaser.map((entry) => (
          <a class="timeline-point" href={`/entries/${entry.id}/`}>
            <span class="timeline-point-year">{entry.data.timelineYear}</span>
            <span class="timeline-dot" aria-hidden="true"></span>
            <span class="timeline-point-claim">{entry.data.claim}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="catalogue-preview">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">The growing catalogue</p>
          <h2>Explore all {entries.length} former facts</h2>
          <p class="section-intro">
            A varied sample of recently added entries across the catalogue. The
            full collection can be searched and filtered in either card or
            compact view.
          </p>
        </div>
        <a href="/browse?view=compact">Open compact index →</a>
      </div>

      <div class="compact-preview">
        {recent.map((entry) => <CompactClaim entry={entry} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(19rem, 0.92fr);
    grid-template-areas:
      "copy art"
      "actions art";
    align-items: center;
    column-gap: clamp(1.5rem, 4vw, 4.5rem);
    row-gap: 0;
    padding: clamp(3rem, 7vw, 6.5rem) 0;
  }

  .hero-copy {
    grid-area: copy;
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .hero h1 {
    margin: .3rem 0 1.5rem;
    max-width: 14ch;
  }

  .intro {
    font-size: clamp(1.1rem, 2.5vw, 1.45rem);
    color: var(--muted);
    max-width: 46rem;
  }

  .actions {
    grid-area: actions;
    display: flex;
    gap: .75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .hero-art {
    grid-area: art;
    min-width: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-art img {
    display: block;
    width: min(100%, 37rem);
    height: auto;
    object-fit: contain;
  }

  .principle {
    background: var(--ink);
    color: white;
    padding: 3.5rem 0;
  }

  .principle p {
    font-size: 1.2rem;
    color: #ddd7ca;
  }

  .principle strong {
    font-size: 1.35rem;
  }

  .school-feature {
    padding: 4rem 0;
    border-bottom: 1px solid var(--line);
    background: var(--card);
  }

  .school-feature-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  .school-feature-copy h2 {
    margin: 0.2rem 0 0.75rem;
  }

  .school-feature-copy p:last-child {
    max-width: 48rem;
    margin-bottom: 0;
    color: var(--muted);
    font-size: 1.05rem;
  }

  .school-form {
    padding: 1.4rem;
    border: 1px solid var(--line);
    background: var(--paper);
  }

  .school-form label {
    display: block;
    margin-bottom: 0.55rem;
    font-weight: 850;
  }

  .school-form-row {
    display: flex;
    gap: 0.65rem;
  }

  .school-form input[type="number"] {
    min-width: 0;
    width: 8rem;
    min-height: 3rem;
    border: 1px solid var(--line);
    border-radius: 0.55rem;
    padding: 0.65rem 0.75rem;
    color: var(--ink);
    background: var(--card);
    font: inherit;
    font-size: 1.05rem;
    font-variant-numeric: tabular-nums;
  }

  .school-form input[type="number"]:focus {
    outline: 2px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-color: var(--accent-dark);
  }

  .school-form button {
    min-height: 3rem;
    border: 0;
    border-radius: 0.55rem;
    padding: 0.65rem 1rem;
    color: white;
    background: var(--ink);
    font: inherit;
    font-weight: 850;
    cursor: pointer;
  }

  .school-form button:hover {
    background: var(--accent-dark);
  }

  .featured {
    padding: 5rem 0;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .section-heading h2 {
    margin: .2rem 0 0;
  }

  .section-heading > a {
    flex: 0 0 auto;
    font-weight: 800;
    color: var(--accent-dark);
  }

  .section-intro {
    margin-bottom: 0;
    color: var(--muted);
  }

  .cards {
    display: grid;
    gap: 2rem;
  }

  .timeline-preview {
    padding: 4.5rem 0 5rem;
    border-top: 1px solid var(--line);
    background: var(--card);
  }

  .timeline-strip {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1rem;
  }

  .timeline-strip::before {
    content: '';
    position: absolute;
    top: 2.65rem;
    left: 7%;
    right: 7%;
    height: 1px;
    background: var(--line);
  }

  .timeline-point {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: auto auto 1fr;
    justify-items: center;
    gap: 0.55rem;
    padding: 0.45rem;
    color: inherit;
    text-align: center;
    text-decoration: none;
  }

  .timeline-point-year {
    color: var(--accent-dark);
    font-weight: 900;
    font-variant-numeric: tabular-nums;
  }

  .timeline-dot {
    width: 0.85rem;
    height: 0.85rem;
    border: 3px solid var(--card);
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }

  .timeline-point-claim {
    max-width: 18ch;
    font-size: 0.92rem;
    line-height: 1.35;
    font-weight: 750;
  }

  .timeline-point:hover .timeline-point-claim {
    color: var(--accent-dark);
  }

  .catalogue-preview {
    padding: 4.5rem 0 5rem;
    border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--card) 45%, transparent);
  }

  .compact-preview {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
  }

  @media (max-width: 900px) {
    .school-feature-inner {
      grid-template-columns: 1fr;
    }

    .hero {
      grid-template-columns: 1fr;
      grid-template-areas:
        "copy"
        "art"
        "actions";
      gap: 1.25rem;
      padding-bottom: 3.5rem;
    }

    .hero-art img {
      width: min(100%, 34rem);
    }

    .actions {
      margin-top: 0;
    }

    .timeline-strip {
      grid-template-columns: 1fr;
      gap: 0;
      border-left: 1px solid var(--line);
      margin-left: 0.45rem;
    }

    .timeline-strip::before {
      display: none;
    }

    .timeline-point {
      grid-template-columns: 4rem auto 1fr;
      grid-template-rows: 1fr;
      justify-items: start;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 0 0.75rem 0.85rem;
      text-align: left;
    }

    .timeline-dot {
      margin-left: -1.3rem;
      border-color: var(--card);
    }

    .timeline-point-claim {
      max-width: none;
    }
  }

  @media (max-width: 700px) {
    .section-heading {
      align-items: start;
      flex-direction: column;
    }

    .compact-preview {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .school-form-row {
      align-items: stretch;
      flex-direction: column;
    }

    .school-form input[type="number"] {
      width: 100%;
    }

    .hero {
      padding-top: 2.5rem;
    }

    .hero-art img {
      width: min(110%, 30rem);
    }
  }
</style>
