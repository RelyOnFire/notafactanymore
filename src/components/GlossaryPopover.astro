---
import { getCollection } from 'astro:content';
import type { SiteLocale } from '../lib/i18n';

interface Props { locale?: SiteLocale; }
const { locale = 'en' } = Astro.props;
const entries = await getCollection('glossary');
const translations = locale === 'de'
  ? await getCollection('glossaryTranslations', (entry) => entry.data.locale === 'de')
  : [];
const translationsById = new Map(translations.map((entry) => [entry.data.entryId, entry.data]));
const glossaryData = Object.fromEntries(entries.map((entry) => {
  const translated = translationsById.get(entry.id);
  return [entry.id, {
    term: translated?.term ?? entry.data.term,
    definition: translated?.shortDefinition ?? entry.data.shortDefinition,
    href: `${locale === 'de' ? '/de/glossary/' : '/glossary/'}#${entry.id}`,
  }];
}));
const serializedGlossary = JSON.stringify(glossaryData).replace(/</g, '\\u003c');
const fullLabel = locale === 'de' ? 'Vollständigen Glossareintrag öffnen →' : 'Open full glossary entry →';
---
<div id="glossary-popover" class="glossary-popover" hidden>
  <div class="glossary-popover-card">
    <p class="glossary-popover-term" data-glossary-popover-term aria-hidden="true"></p>
    <p id="glossary-popover-definition" class="glossary-popover-definition" data-glossary-popover-definition></p>
    <a class="glossary-popover-link" data-glossary-popover-link href="/glossary/">{fullLabel}</a>
  </div>
</div>
<script id="glossary-data" type="application/json" set:html={serializedGlossary}></script>
<script>
  const popover = document.querySelector('#glossary-popover');
  const dataNode = document.querySelector('#glossary-data');
  if (popover instanceof HTMLElement && dataNode instanceof HTMLScriptElement) {
    const glossary = JSON.parse(dataNode.textContent || '{}');
    const termNode = popover.querySelector('[data-glossary-popover-term]');
    const definitionNode = popover.querySelector('[data-glossary-popover-definition]');
    const fullLink = popover.querySelector('[data-glossary-popover-link]');
    const triggers = Array.from(document.querySelectorAll('.glossary-term[data-glossary-id]'));
    const touchLike = window.matchMedia('(hover: none), (pointer: coarse)');
    const mobile = window.matchMedia('(max-width: 700px)');
    let active = null;
    let pinned = null;

    const position = () => {
      if (!(active instanceof HTMLElement) || popover.hidden) return;
      if (mobile.matches || touchLike.matches) {
        Object.assign(popover.style,{left:'0',right:'0',top:'auto',bottom:'0'});
        return;
      }
      popover.style.right='auto'; popover.style.bottom='auto';
      const a=active.getBoundingClientRect(), b=popover.getBoundingClientRect(), gutter=12, offset=10;
      let left=a.left+a.width/2-b.width/2;
      left=Math.max(gutter,Math.min(left,window.innerWidth-b.width-gutter));
      let top=a.top-b.height-offset;
      if(top<gutter) top=a.bottom+offset;
      popover.style.left=`${Math.round(left)}px`; popover.style.top=`${Math.round(top)}px`;
    };
    const open = (trigger, pin=false) => {
      const id=trigger?.dataset?.glossaryId, item=id?glossary[id]:null;
      if(!item || !(termNode instanceof HTMLElement) || !(definitionNode instanceof HTMLElement) || !(fullLink instanceof HTMLAnchorElement)) return;
      active=trigger; if(pin) pinned=trigger;
      termNode.textContent=item.term; definitionNode.textContent=item.definition; fullLink.href=item.href;
      popover.hidden=false; requestAnimationFrame(position);
    };
    const close = () => { popover.hidden=true; popover.removeAttribute('style'); active=null; pinned=null; };

    for (const trigger of triggers) {
      trigger.addEventListener('mouseenter',()=>{ if(!touchLike.matches && !pinned) open(trigger); });
      trigger.addEventListener('mouseleave',()=>{ if(!touchLike.matches && !pinned && document.activeElement!==trigger) close(); });
      trigger.addEventListener('focus',()=>{ if(!touchLike.matches) open(trigger); });
      trigger.addEventListener('blur',()=>{ if(!touchLike.matches && !popover.matches(':hover')) close(); });
      trigger.addEventListener('click',(event)=>{
        if(!touchLike.matches) return; // real link on desktop/keyboard
        if(pinned!==trigger){ event.preventDefault(); open(trigger,true); }
      });
    }
    popover.addEventListener('mouseleave',()=>{ if(!touchLike.matches && document.activeElement!==active) close(); });
    document.addEventListener('pointerdown',(event)=>{
      if(!pinned) return;
      const target=event.target;
      if(target instanceof Node && !pinned.contains(target) && !popover.contains(target)) close();
    });
    document.addEventListener('keydown',(event)=>{ if(event.key==='Escape' && !popover.hidden) close(); });
    window.addEventListener('resize',position); window.addEventListener('scroll',position,{passive:true});
  }
</script>
<style is:global>
  .glossary-term {
    color: inherit;
    text-decoration-line: underline;
    text-decoration-style: dotted;
    text-decoration-thickness: 1px;
    text-decoration-color: color-mix(in srgb, currentColor 58%, transparent);
    text-underline-offset: .18em;
    cursor: help;
  }
  .glossary-term:hover,.glossary-term:focus-visible {
    color: var(--accent-dark); text-decoration-style: solid; text-decoration-color: currentColor;
  }
  .glossary-popover[hidden]{display:none!important}
  .glossary-popover{position:fixed;z-index:120;width:min(22rem,calc(100vw - 2rem));pointer-events:auto}
  .glossary-popover-card{padding:.85rem 1rem .9rem;border:1px solid var(--ink);border-radius:.65rem;background:var(--card);color:var(--ink);box-shadow:0 14px 38px rgb(23 23 23 / 16%)}
  .glossary-popover-term{margin:0 0 .2rem;color:var(--accent-dark);font-size:.78rem;font-weight:900;letter-spacing:.055em;text-transform:uppercase}
  .glossary-popover-definition{margin:0;max-width:none;font-size:.94rem;line-height:1.48}
  .glossary-popover-link{display:inline-block;margin-top:.55rem;color:var(--accent-dark);font-size:.84rem;font-weight:800;text-underline-offset:.18em}
  @media (max-width:700px),(hover:none),(pointer:coarse){
    .glossary-popover{width:100%;padding:0 .65rem max(.65rem,env(safe-area-inset-bottom))}
    .glossary-popover-card{border-radius:.9rem;box-shadow:0 -10px 34px rgb(23 23 23 / 15%)}
  }
</style>
