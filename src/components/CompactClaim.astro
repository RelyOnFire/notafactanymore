---
import type { CollectionEntry } from 'astro:content';
import { lifespanYears } from '../lib/lifespans';
import {
  categoryLabel,
  formatApproxYearsLocalized,
  statusLabel,
  type EntryTranslation,
  type SiteLocale,
} from '../lib/i18n';

interface Props {
  entry: CollectionEntry<'entries'>;
  locale?: SiteLocale;
  translation?: EntryTranslation;
}

const { entry, locale = 'en', translation } = Astro.props;
const { data } = entry;
const translated = locale === 'de' ? translation?.data : undefined;
const lifespan = lifespanYears(data.acceptedYear, data.timelineYear);
const lifespanComparable = data.lifespanComparable !== false;
const href = locale === 'de' ? `/de/entries/${entry.id}/` : `/entries/${entry.id}/`;
const lifespanText = lifespanComparable
  ? formatApproxYearsLocalized(lifespan, locale)
  : locale === 'de' ? 'Dauer nicht quantifiziert' : 'Lifespan not quantified';
---

<a class="compact-claim" href={href}>
  <strong>{translated?.claim ?? data.claim}</strong>
  <span>{categoryLabel(data.category, locale)} · {statusLabel(data.status, locale)} · {lifespanText}</span>
</a>

<style>
  .compact-claim {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 4.25rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--card) 78%, transparent);
    text-decoration: none;
    transition:
      border-color 140ms ease,
      background 140ms ease,
      transform 140ms ease;
  }

  .compact-claim:hover,
  .compact-claim:focus-visible {
    border-color: var(--accent-dark);
    background: var(--card);
    transform: translateY(-1px);
  }

  strong {
    font-size: 0.96rem;
    line-height: 1.28;
  }

  span {
    margin-top: 0.28rem;
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 650;
    line-height: 1.2;
  }
</style>
