---
import { getCollection } from 'astro:content';
import type { SiteLocale } from '../lib/i18n';
import {
  currentInstitutionalTranslationMap,
  normalizeInstitutionalBelief,
  type NormalizedInstitutionalEvidence,
} from '../lib/institutionalBeliefs';

interface Props {
  locale?: SiteLocale;
}

const { locale = 'en' } = Astro.props;

const PILOT_IDS = [
  'visual-fire-patterns-arson-indicators',
  'routine-oxygen-heart-attack',
  'beriberi-infectious-disease',
  'yellow-fever-fomite-transmission',
] as const;

const allBeliefs = await getCollection('institutionalBeliefs');
const translations = locale === 'de'
  ? await getCollection(
      'institutionalBeliefTranslations',
      (translation) => translation.data.locale === 'de',
    )
  : [];
const translationById = currentInstitutionalTranslationMap(allBeliefs, translations);
const beliefById = new Map(allBeliefs.map((belief) => [belief.id, belief]));

const missingBeliefs = PILOT_IDS.filter((id) => !beliefById.has(id));
if (missingBeliefs.length > 0) {
  throw new Error(`Institutional v2 preview is missing canonical pilots: ${missingBeliefs.join(', ')}`);
}

if (locale === 'de') {
  const missingTranslations = PILOT_IDS.filter((id) => !translationById.has(id));
  if (missingTranslations.length > 0) {
    throw new Error(
      `Institutional v2 preview is missing current German pilots: ${missingTranslations.join(', ')}`,
    );
  }
}

const copy = locale === 'de'
  ? {
      eyebrow: 'Zielbild-Vorschau · Institutionelle Überzeugungen v2',
      title: 'Von einer Quellenliste zu einer Evidenzlandkarte',
      intro:
        'Diese vier Pilotfälle zeigen, wie die Rubrik nach der vollständigen Umstellung aussehen könnte: Die historische Überzeugung, ihre heutige Korrektur, der institutionelle Mechanismus und jede einzelne Evidenzbeziehung werden getrennt und nachvollziehbar dargestellt.',
      previewOnly: 'Nur Vorschau',
      previewNote:
        'Diese Seite ist nicht indexiert und verändert die bestehenden Karten nicht. Sie dient dazu, Informationsdichte, Begriffe und Lesefluss vor einer breiteren Migration zu beurteilen.',
      reviewTitle: 'Worauf Sie achten sollten',
      reviewQuestions: [
        'Sind historische Überzeugung und heutige Korrektur klar voneinander getrennt?',
        'Liefern „Warum sich die Annahme hielt“ und „Wie die Korrektur verlief“ nützlichen Kontext?',
        'Ist die Evidenz nah genug an der jeweiligen Aussage, ohne die Erzählung zu überladen?',
        'Sollte ein Abschnitt vor der breiteren Einführung gekürzt, umbenannt oder eingeklappt werden?',
      ],
      pilotCases: 'Vier Pilotfälle',
      pilotIntro:
        'Die Kurzansichten führen zu vollständigen Vorschauen weiter unten. Gemeinsam decken sie einfache und komplexe Fälle, mehrere Episoden und unterschiedliche Korrekturwege ab.',
      episodes: (count: number) => `${count} ${count === 1 ? 'Episode' : 'Episoden'}`,
      evidenceLinks: (count: number) => `${count} Evidenz${count === 1 ? 'beziehung' : 'beziehungen'}`,
      sources: (count: number) => `${count} ${count === 1 ? 'Quelle' : 'Quellen'}`,
      openCase: 'Vollständigen Fall ansehen',
      schema: 'Schema v2',
      accepted: 'Was Institutionen akzeptierten',
      current: 'Was die Evidenz heute stützt',
      beliefEvidence: 'Evidenz zur übergeordneten Überzeugung',
      impact: 'Auswirkungen',
      impactContext: 'Einordnung',
      impactCaution:
        'Historische Zahlen und Wirkungen werden als kontextgebundene Evidenz dargestellt, nicht als universelle Kausalbehauptung.',
      episode: 'Institutionelle Episode',
      institutions: 'Beteiligte Institutionen',
      institutionalContext: 'Institutioneller Kontext',
      consequences: 'Folgen',
      why: 'Warum sich die Annahme hielt',
      how: 'Wie die institutionelle Korrektur verlief',
      action: 'Maßnahme',
      evidenceForEpisode: 'Evidenz für diese Episode',
      locator: 'Fundstelle',
      sourceRegistry: 'Quellenregister',
      sourceRegistryIntro:
        'Jede Quelle wird einmal geführt und kann mehrere präzise Evidenzbeziehungen tragen.',
      usedBy: (count: number) => `${count} ${count === 1 ? 'Evidenzbeziehung' : 'Evidenzbeziehungen'}`,
      reviewed: 'Inhalt geprüft',
      compareCurrent: 'Mit der aktuellen Karte vergleichen',
      backToCases: 'Zurück zu den Pilotfällen',
    }
  : {
      eyebrow: 'End-state review · Institutional beliefs v2',
      title: 'From a source list to an evidence map',
      intro:
        'These four pilot cases show what the section could become after full migration: the historical belief, present correction, institutional mechanism, and every individual evidence relationship are separated and traceable.',
      previewOnly: 'Preview only',
      previewNote:
        'This page is not indexed and does not alter the existing cards. It exists to review information density, terminology, and reading flow before any wider migration.',
      reviewTitle: 'What to assess',
      reviewQuestions: [
        'Is the historical belief clearly separated from the present correction?',
        'Do “Why it persisted” and “How correction happened” add useful context?',
        'Is evidence attached closely enough without overwhelming the narrative?',
        'Should any section be shortened, renamed, or collapsed before wider rollout?',
      ],
      pilotCases: 'Four pilot cases',
      pilotIntro:
        'The compact views jump to complete previews below. Together they cover simple and complex cases, multiple episodes, and different paths to correction.',
      episodes: (count: number) => `${count} ${count === 1 ? 'episode' : 'episodes'}`,
      evidenceLinks: (count: number) => `${count} evidence ${count === 1 ? 'link' : 'links'}`,
      sources: (count: number) => `${count} ${count === 1 ? 'source' : 'sources'}`,
      openCase: 'Review full case',
      schema: 'Schema v2',
      accepted: 'What institutions accepted',
      current: 'What the evidence supports now',
      beliefEvidence: 'Evidence for the overall belief',
      impact: 'Impact',
      impactContext: 'Context',
      impactCaution:
        'Historical totals and effects are presented as contextual evidence, not as universal causal claims.',
      episode: 'Institutional episode',
      institutions: 'Institutions involved',
      institutionalContext: 'Institutional context',
      consequences: 'Consequences',
      why: 'Why this persisted',
      how: 'How correction happened',
      action: 'Action',
      evidenceForEpisode: 'Evidence for this episode',
      locator: 'Where in the source',
      sourceRegistry: 'Source registry',
      sourceRegistryIntro:
        'Each source is registered once and can carry several precise evidence relationships.',
      usedBy: (count: number) => `${count} evidence ${count === 1 ? 'link' : 'links'}`,
      reviewed: 'Content reviewed',
      compareCurrent: 'Compare current production card',
      backToCases: 'Back to pilot cases',
    };

const strengthLabels: Record<string, string> = locale === 'de'
  ? {
      'institutionally-influential': 'Institutionell einflussreich',
      'officially-endorsed': 'Offiziell unterstützt',
      'policy-basis': 'Grundlage staatlicher Praxis',
      'enforced-doctrine': 'Durchgesetzte Doktrin',
    }
  : {
      'institutionally-influential': 'Institutionally influential',
      'officially-endorsed': 'Officially endorsed',
      'policy-basis': 'Policy basis',
      'enforced-doctrine': 'Enforced doctrine',
    };

const institutionTypeLabels: Record<string, string> = locale === 'de'
  ? {
      government: 'Staat',
      court: 'Gericht',
      academy: 'Akademie',
      university: 'Universität',
      medical: 'Medizin',
      professional: 'Fachinstitution',
      education: 'Bildung',
      military: 'Militär',
    }
  : {
      government: 'Government',
      court: 'Court',
      academy: 'Academy',
      university: 'University',
      medical: 'Medical',
      professional: 'Professional',
      education: 'Education',
      military: 'Military',
    };

const mechanismLabels: Record<string, string> = locale === 'de'
  ? {
      endorsement: 'Befürwortung',
      classification: 'Klassifizierung',
      'standard-setting': 'Standardsetzung',
      'administrative-adoption': 'Administrative Übernahme',
      education: 'Ausbildung',
      publication: 'Veröffentlichung',
      funding: 'Finanzierung',
      credentialing: 'Qualifikationsvergabe',
      enforcement: 'Durchsetzung',
      suppression: 'Unterdrückung',
      other: 'Anderer Mechanismus',
    }
  : {
      endorsement: 'Endorsement',
      classification: 'Classification',
      'standard-setting': 'Standard-setting',
      'administrative-adoption': 'Administrative adoption',
      education: 'Education',
      publication: 'Publication',
      funding: 'Funding',
      credentialing: 'Credentialing',
      enforcement: 'Enforcement',
      suppression: 'Suppression',
      other: 'Other mechanism',
    };

const correctionStatusLabels: Record<string, string> = locale === 'de'
  ? {
      corrected: 'Korrigiert',
      partial: 'Teilweise korrigiert',
      uncorrected: 'Nicht korrigiert',
      ongoing: 'Laufend',
      undocumented: 'Nicht dokumentiert',
    }
  : {
      corrected: 'Corrected',
      partial: 'Partially corrected',
      uncorrected: 'Uncorrected',
      ongoing: 'Ongoing',
      undocumented: 'Undocumented',
    };

const relationLabels: Record<string, string> = locale === 'de'
  ? {
      documents: 'Dokumentiert',
      supports: 'Stützt',
      contextualizes: 'Ordnet ein',
      disputes: 'Widerspricht',
    }
  : {
      documents: 'Documents',
      supports: 'Supports',
      contextualizes: 'Contextualizes',
      disputes: 'Disputes',
    };

const targetLabels: Record<string, string> = locale === 'de'
  ? {
      proposition: 'Historische Überzeugung',
      correction: 'Heutige Korrektur',
      impact: 'Auswirkungen',
      carrier: 'Institutioneller Träger',
      mechanism: 'Mechanismus',
      consequences: 'Folgen',
      'institutional-correction': 'Institutionelle Korrektur',
      context: 'Kontext',
    }
  : {
      proposition: 'Historical belief',
      correction: 'Present correction',
      impact: 'Impact',
      carrier: 'Institutional carrier',
      mechanism: 'Mechanism',
      consequences: 'Consequences',
      'institutional-correction': 'Institutional correction',
      context: 'Context',
    };

const germanCategoryLabels: Record<string, string> = {
  'Forensic science and fire investigation': 'Forensik und Brandursachenermittlung',
  'Emergency cardiology and treatment guidelines': 'Notfallkardiologie und Behandlungsleitlinien',
  'Medicine, nutrition and military health': 'Medizin, Ernährung und Militärgesundheit',
  'Public health, military medicine and infectious disease':
    'Öffentliche Gesundheit, Militärmedizin und Infektionskrankheiten',
};

const categoryLabel = (category: string) =>
  locale === 'de' ? germanCategoryLabels[category] ?? category : category;
const targetLabel = (evidence: NormalizedInstitutionalEvidence) =>
  targetLabels[evidence.target.aspect] ?? evidence.target.aspect;
const reviewedDate = (date: Date) => date.toLocaleDateString(
  locale === 'de' ? 'de-DE' : 'en-GB',
  { dateStyle: 'long' },
);

const cases = PILOT_IDS.map((id) => {
  const canonical = beliefById.get(id);
  if (!canonical) throw new Error(`Institutional v2 preview cannot load canonical pilot: ${id}`);
  if (canonical.data.schemaVersion !== 2) {
    throw new Error(`Institutional v2 preview requires schemaVersion 2: ${id}`);
  }

  const normalized = normalizeInstitutionalBelief(
    canonical,
    locale,
    translationById.get(id),
  );
  if (normalized.schemaVersion !== 2) {
    throw new Error(`Institutional v2 preview normalized an unexpected schema: ${id}`);
  }

  const sourceById = new Map(normalized.sources.map((source) => [source.id, source]));
  const missingSourceIds = normalized.evidence
    .filter((evidence) => !sourceById.has(evidence.sourceId))
    .map((evidence) => evidence.sourceId);
  if (missingSourceIds.length > 0) {
    throw new Error(
      `Institutional v2 preview has unresolved sources for ${id}: ${missingSourceIds.join(', ')}`,
    );
  }

  const enrichEvidence = (items: NormalizedInstitutionalEvidence[]) => items.map((item) => ({
    ...item,
    source: sourceById.get(item.sourceId)!,
  }));

  return {
    ...normalized,
    categoryLabel: categoryLabel(normalized.category),
    productionPath: locale === 'de'
      ? `/de/institutions/${normalized.id}/`
      : `/institutions/${normalized.id}/`,
    beliefEvidence: enrichEvidence(
      normalized.evidence.filter((evidence) => evidence.target.scope === 'belief'),
    ),
    episodes: normalized.episodes.map((episode) => ({
      ...episode,
      evidence: enrichEvidence(
        normalized.evidence.filter(
          (evidence) =>
            evidence.target.scope === 'episode' &&
            evidence.target.episodeId === episode.id,
        ),
      ),
    })),
    sourceRows: normalized.sources.map((source) => ({
      source,
      evidenceCount: normalized.evidence.filter(
        (evidence) => evidence.sourceId === source.id,
      ).length,
    })),
  };
});
---

<div class="v2-preview container">
  <section class="preview-hero" aria-labelledby="preview-title">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1 id="preview-title">{copy.title}</h1>
    <p class="preview-intro">{copy.intro}</p>

    <div class="preview-note" role="note">
      <strong>{copy.previewOnly}</strong>
      <p>{copy.previewNote}</p>
    </div>

    <aside class="review-guide" aria-labelledby="review-guide-title">
      <h2 id="review-guide-title">{copy.reviewTitle}</h2>
      <ol>
        {copy.reviewQuestions.map((question) => <li>{question}</li>)}
      </ol>
    </aside>
  </section>

  <section class="pilot-overview" id="pilot-cases" aria-labelledby="pilot-cases-title">
    <header class="section-heading">
      <p class="section-kicker">{copy.schema}</p>
      <h2 id="pilot-cases-title">{copy.pilotCases}</h2>
      <p>{copy.pilotIntro}</p>
    </header>

    <div class="pilot-grid">
      {cases.map((entry, index) => (
        <a class="pilot-card" href={`#case-${entry.id}`}>
          <span class="pilot-number" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <div>
            <p class="pilot-category">{entry.categoryLabel}</p>
            <h3>{entry.title}</h3>
            <p class="pilot-proposition">{entry.proposition}</p>
            <div class="pilot-counts" aria-label={`${copy.episodes(entry.episodes.length)}, ${copy.evidenceLinks(entry.evidence.length)}, ${copy.sources(entry.sources.length)}`}>
              <span>{copy.episodes(entry.episodes.length)}</span>
              <span>{copy.evidenceLinks(entry.evidence.length)}</span>
              <span>{copy.sources(entry.sources.length)}</span>
            </div>
            <span class="pilot-link">{copy.openCase} ↓</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="case-previews" aria-label={copy.pilotCases}>
    {cases.map((entry, caseIndex) => (
      <article
        class="case-preview"
        id={`case-${entry.id}`}
        aria-labelledby={`case-title-${entry.id}`}
      >
        <header class="case-header">
          <div class="case-index" aria-hidden="true">
            {String(caseIndex + 1).padStart(2, '0')}
          </div>
          <div class="case-heading-copy">
            <div class="case-flags">
              <span class="schema-badge">{copy.schema}</span>
              <span>{entry.categoryLabel}</span>
            </div>
            <h2 id={`case-title-${entry.id}`}>{entry.title}</h2>
            <div class="case-actions">
              <a href={entry.productionPath}>{copy.compareCurrent} ↗</a>
              <a href="#pilot-cases">{copy.backToCases} ↑</a>
            </div>
          </div>
        </header>

        <div class="narrative-grid">
          <section class="narrative-panel proposition-panel" aria-labelledby={`proposition-${entry.id}`}>
            <p class="section-kicker">01</p>
            <h3 id={`proposition-${entry.id}`}>{copy.accepted}</h3>
            <p>{entry.proposition}</p>
          </section>
          <section class="narrative-panel correction-panel" aria-labelledby={`correction-${entry.id}`}>
            <p class="section-kicker">02</p>
            <h3 id={`correction-${entry.id}`}>{copy.current}</h3>
            <p>{entry.correction}</p>
          </section>
        </div>

        {entry.beliefEvidence.length > 0 && (
          <section class="belief-evidence evidence-section" aria-labelledby={`belief-evidence-${entry.id}`}>
            <div class="subsection-heading">
              <p class="section-kicker">03</p>
              <h3 id={`belief-evidence-${entry.id}`}>{copy.beliefEvidence}</h3>
              <span>{copy.evidenceLinks(entry.beliefEvidence.length)}</span>
            </div>
            <ol class="evidence-list">
              {entry.beliefEvidence.map((evidence) => (
                <li class="evidence-item" id={`${entry.id}-${evidence.id}`}>
                  <div class="evidence-badges">
                    <span class={`relation-badge relation-${evidence.relation}`}>
                      {relationLabels[evidence.relation]}
                    </span>
                    <span class="target-badge">{targetLabel(evidence)}</span>
                  </div>
                  <a class="evidence-source" href={evidence.source.url} target="_blank" rel="noopener noreferrer">
                    {evidence.source.title}
                  </a>
                  <span class="evidence-publisher">{evidence.source.publisher}</span>
                  {evidence.locator && (
                    <p class="evidence-locator"><strong>{copy.locator}:</strong> {evidence.locator}</p>
                  )}
                  {evidence.note && <p class="evidence-note-copy">{evidence.note}</p>}
                </li>
              ))}
            </ol>
          </section>
        )}

        {entry.impact && (
          <section class="impact-section" aria-labelledby={`impact-${entry.id}`}>
            <div class="subsection-heading">
              <p class="section-kicker">04</p>
              <h3 id={`impact-${entry.id}`}>{copy.impact}</h3>
            </div>
            <p class="impact-summary">{entry.impact.summary}</p>

            {entry.impact.context.length > 0 && (
              <div class="impact-context">
                <h4>{copy.impactContext}</h4>
                <div>
                  {entry.impact.context.map((paragraph) => <p>{paragraph}</p>)}
                </div>
              </div>
            )}

            {entry.impact.highlights.length > 0 && (
              <div class="impact-grid">
                {entry.impact.highlights.map((highlight) => (
                  <article class="impact-highlight">
                    <strong>{highlight.value}</strong>
                    <h4>{highlight.label}</h4>
                    {highlight.note && <p>{highlight.note}</p>}
                  </article>
                ))}
              </div>
            )}
            <p class="impact-caution">{copy.impactCaution}</p>
          </section>
        )}

        <section class="episodes-section" aria-label={copy.episodes(entry.episodes.length)}>
          {entry.episodes.map((episode, episodeIndex) => (
            <article class="episode-preview" id={`${entry.id}-${episode.id}`}>
              <header class="episode-header">
                <div>
                  <p class="section-kicker">
                    {copy.episode} {String(episodeIndex + 1).padStart(2, '0')}
                  </p>
                  <h3>{episode.polity}</h3>
                  <p class="episode-region">{episode.regionLabel}</p>
                </div>
                <div class="episode-meta">
                  <span class="period-badge">{episode.period}</span>
                  <span class={`strength-badge strength-${episode.strength}`}>
                    {strengthLabels[episode.strength] ?? episode.strength}
                  </span>
                </div>
              </header>

              <p class="episode-summary">{episode.summary}</p>

              <div class="institution-block">
                <div>
                  <h4>{copy.institutions}</h4>
                  <div class="type-badges">
                    {episode.institutionTypes.map((type) => (
                      <span>{institutionTypeLabels[type] ?? type}</span>
                    ))}
                  </div>
                </div>
                <ul>
                  {episode.institutions.map((institution) => <li>{institution}</li>)}
                </ul>
              </div>

              {episode.institutionalContext && (
                <section class="context-block">
                  <h4>{copy.institutionalContext}</h4>
                  <p>{episode.institutionalContext}</p>
                </section>
              )}

              <div class="explanation-grid">
                {episode.mechanism && (
                  <section class="explanation-panel mechanism-panel">
                    <div class="explanation-title">
                      <h4>{copy.why}</h4>
                      {episode.mechanism.kind && (
                        <span>{mechanismLabels[episode.mechanism.kind] ?? episode.mechanism.kind}</span>
                      )}
                    </div>
                    <p>{episode.mechanism.summary}</p>
                  </section>
                )}

                {episode.institutionalCorrection && (
                  <section class="explanation-panel correction-process-panel">
                    <div class="explanation-title">
                      <h4>{copy.how}</h4>
                      <span class={`status-badge status-${episode.institutionalCorrection.status}`}>
                        {correctionStatusLabels[episode.institutionalCorrection.status]}
                      </span>
                    </div>
                    {episode.institutionalCorrection.periodLabel && (
                      <p class="correction-period">{episode.institutionalCorrection.periodLabel}</p>
                    )}
                    {episode.institutionalCorrection.action && (
                      <p class="correction-action">
                        <strong>{copy.action}:</strong> {episode.institutionalCorrection.action}
                      </p>
                    )}
                    <p>{episode.institutionalCorrection.summary}</p>
                  </section>
                )}
              </div>

              <section class="consequences-block">
                <h4>{copy.consequences}</h4>
                <ul>
                  {episode.consequences.map((consequence) => <li>{consequence}</li>)}
                </ul>
              </section>

              <section class="evidence-section episode-evidence" aria-labelledby={`episode-evidence-${entry.id}-${episode.id}`}>
                <div class="subsection-heading">
                  <h4 id={`episode-evidence-${entry.id}-${episode.id}`}>{copy.evidenceForEpisode}</h4>
                  <span>{copy.evidenceLinks(episode.evidence.length)}</span>
                </div>
                <ol class="evidence-list">
                  {episode.evidence.map((evidence) => (
                    <li class="evidence-item" id={`${entry.id}-${evidence.id}`}>
                      <div class="evidence-badges">
                        <span class={`relation-badge relation-${evidence.relation}`}>
                          {relationLabels[evidence.relation]}
                        </span>
                        <span class="target-badge">{targetLabel(evidence)}</span>
                      </div>
                      <a class="evidence-source" href={evidence.source.url} target="_blank" rel="noopener noreferrer">
                        {evidence.source.title}
                      </a>
                      <span class="evidence-publisher">{evidence.source.publisher}</span>
                      {evidence.locator && (
                        <p class="evidence-locator"><strong>{copy.locator}:</strong> {evidence.locator}</p>
                      )}
                      {evidence.note && <p class="evidence-note-copy">{evidence.note}</p>}
                    </li>
                  ))}
                </ol>
              </section>
            </article>
          ))}
        </section>

        <details class="source-registry">
          <summary>
            <span>
              <strong>{copy.sourceRegistry}</strong>
              <small>{copy.sourceRegistryIntro}</small>
            </span>
            <span>{copy.sources(entry.sourceRows.length)}</span>
          </summary>
          <ol>
            {entry.sourceRows.map(({ source, evidenceCount }, sourceIndex) => (
              <li id={`${entry.id}-source-${source.id}`}>
                <span class="source-number">{String(sourceIndex + 1).padStart(2, '0')}</span>
                <div>
                  <a href={source.url} target="_blank" rel="noopener noreferrer">
                    {source.title}
                  </a>
                  <span>{source.publisher}</span>
                </div>
                <small>{copy.usedBy(evidenceCount)}</small>
              </li>
            ))}
          </ol>
        </details>

        <footer class="case-footer">
          <span>{copy.reviewed}: {reviewedDate(entry.reviewedAt)}</span>
          <a href="#pilot-cases">{copy.backToCases} ↑</a>
        </footer>
      </article>
    ))}
  </section>
</div>

<style>
  .v2-preview {
    max-width: 1180px;
    padding: 3.5rem 0 6rem;
  }

  .preview-hero {
    padding-bottom: 3.5rem;
    border-bottom: 3px solid var(--ink);
  }

  .preview-hero h1 {
    margin: 0.35rem 0 1.25rem;
    max-width: 980px;
    font-size: clamp(3rem, 8vw, 6.2rem);
    line-height: 0.94;
  }

  .preview-intro {
    margin: 0;
    max-width: 850px;
    color: var(--muted);
