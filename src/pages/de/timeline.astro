---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  categoryLabel,
  statusLabel,
  translationMatchesEntry,
} from '../../lib/i18n';

const entries = await getCollection('entries');
const translations = await getCollection(
  'entryTranslations',
  (translation) => translation.data.locale === 'de',
);

const items = translations
  .map((translation) => {
    const entry = entries.find((candidate) => candidate.id === translation.data.entryId);
    return entry && translationMatchesEntry(entry, translation) ? { entry, translation } : null;
  })
  .filter((item): item is NonNullable<typeof item> => Boolean(item))
  .sort((a, b) =>
    b.entry.data.timelineYear - a.entry.data.timelineYear ||
    a.translation.data.claim.localeCompare(b.translation.data.claim, 'de', { sensitivity: 'base' })
  );

const categories = [...new Set(items.map(({ entry }) => entry.data.category))]
  .sort((a, b) => categoryLabel(a, 'de').localeCompare(categoryLabel(b, 'de'), 'de'));
const statuses = [...new Set(items.map(({ entry }) => entry.data.status))]
  .sort((a, b) => statusLabel(a, 'de').localeCompare(statusLabel(b, 'de'), 'de'));

const decadeFor = (year: number) => year < 0
  ? -Math.floor(Math.abs(year) / 10) * 10
  : Math.floor(year / 10) * 10;

const formatHistoricalYearDe = (year: number) => year < 0 ? `${Math.abs(year)} v. Chr.` : String(year);
const formatDecadeDe = (decade: number) => decade < 0 ? `${Math.abs(decade)}er v. Chr.` : `${decade}er`;

const decades = [...new Set(items.map(({ entry }) => decadeFor(entry.data.timelineYear)))].sort((a, b) => b - a);
---
<BaseLayout
  locale="de"
  title="Zeitleiste"
  description="Erkunde chronologisch, wann wissenschaftliche und historische Aussagen durch stärkere Evidenz korrigiert, eingeschränkt, neu eingeordnet oder abgelöst wurden."
  alternatePath="/timeline"
>
  <header class="timeline-head container">
    <p class="eyebrow">Der historische Verlauf</p>
    <h1>Wie sich Wissen verändert hat</h1>
    <p class="timeline-intro">
      Erkunde den Katalog chronologisch. Das angezeigte Jahr ist ein repräsentativer
      Anker für die Sortierung; der ursprüngliche ungefähre Änderungszeitraum bleibt
      bei jedem Eintrag erhalten.
    </p>
  </header>

  <section class="school-context container" hidden>
    <div class="school-context-inner">
      <div>
        <p class="eyebrow">Wissenschaft seit dem Schulbeginn</p>
        <h2 class="school-context-title"></h2>
        <p class="school-context-copy">
          Diese Einträge änderten sich ab dem gewählten Schulbeginn. Das bedeutet nicht zwingend,
          dass die frühere Auffassung tatsächlich im Unterricht vermittelt wurde: wissenschaftliche
          Akzeptanz, Lehrbücher, Lehrpläne und Unterricht ändern sich nicht immer gleichzeitig.
        </p>
      </div>
      <button class="clear-since" type="button">Gesamte Zeitleiste anzeigen</button>
    </div>
  </section>

  <section class="timeline-controls" aria-label="Steuerung der Zeitleiste">
    <div class="container controls-inner">
      <label class="search-field">
        <span class="sr-only">Zeitleiste durchsuchen</span>
        <input type="search" class="timeline-search" placeholder="Zeitleiste durchsuchen…" autocomplete="off" />
      </label>

      <label class="direction-field">
        <span class="sr-only">Richtung der Zeitleiste</span>
        <select class="direction-select" aria-label="Richtung der Zeitleiste">
          <option value="newest">Neueste Änderung zuerst</option>
          <option value="oldest">Älteste Änderung zuerst</option>
        </select>
      </label>

      <button class="filter-toggle" type="button" aria-expanded="false" aria-controls="timeline-filter-panel">
        <span>Filter</span><span class="filter-count" hidden>0</span>
      </button>

      <div class="active-filter-row" hidden>
        <div class="active-filter-chips" aria-label="Aktive Filter der Zeitleiste"></div>
        <button class="clear-filters clear-filters-inline" type="button">Alle löschen</button>
      </div>

      <p class="results-summary" aria-live="polite">Alle {items.length} Einträge werden angezeigt</p>

      <div class="filter-panel" id="timeline-filter-panel" hidden role="dialog" aria-labelledby="timeline-filter-title-de">
        <div class="filter-panel-header">
          <div>
            <p class="filter-label" id="timeline-filter-title-de">Zeitleiste filtern</p>
            <p class="filter-help">Kategorien und Status lassen sich beliebig kombinieren.</p>
          </div>
          <button class="filter-close" type="button" aria-label="Filter schließen">×</button>
        </div>

        <div class="filter-panel-scroll">
          <div class="filter-groups">
            <div>
              <p class="group-label">Kategorien</p>
              <div class="filters" role="group" aria-label="Zeitleiste nach Kategorie filtern">
                {categories.map((category) => {
                  const count = items.filter(({ entry }) => entry.data.category === category).length;
                  const label = categoryLabel(category, 'de');
                  return (
                    <button class="filter-button" type="button" data-filter-type="category" data-filter-value={category} data-filter-label={label} aria-pressed="false">
                      {label}<span class="count">{count}</span>
                    </button>
                  );
                })}
              </div>
            </div>

            <div>
              <p class="group-label">Status</p>
              <div class="filters" role="group" aria-label="Zeitleiste nach Status filtern">
                {statuses.map((status) => {
                  const count = items.filter(({ entry }) => entry.data.status === status).length;
                  const label = statusLabel(status, 'de');
                  return (
                    <button class="filter-button" type="button" data-filter-type="status" data-filter-value={status} data-filter-label={label} aria-pressed="false">
                      {label}<span class="count">{count}</span>
                    </button>
                  );
                })}
              </div>
            </div>
          </div>
        </div>

        <div class="filter-panel-actions">
          <button class="clear-filters" type="button">Alle löschen</button>
          <button class="apply-filters" type="button">Alle {items.length} Einträge anzeigen</button>
        </div>
      </div>
    </div>
  </section>

  <div class="timeline container" data-direction="newest">
    {decades.map((decade) => {
      const decadeItems = items.filter(({ entry }) => decadeFor(entry.data.timelineYear) === decade);
      return (
        <section class="decade-group" data-decade={decade}>
          <header class="decade-heading">
            <h2>{formatDecadeDe(decade)}</h2><span aria-hidden="true"></span>
          </header>

          <div class="decade-entries">
            {decadeItems.map(({ entry, translation }) => (
              <article
                class="timeline-entry"
                data-entry-id={entry.id}
                data-year={entry.data.timelineYear}
                data-category={entry.data.category}
                data-status={entry.data.status}
                data-search={`${translation.data.claim} ${translation.data.currentUnderstanding} ${translation.data.summary} ${categoryLabel(entry.data.category, 'de')} ${statusLabel(entry.data.status, 'de')} ${translation.data.changedApproximately}`.toLocaleLowerCase('de')}
              >
                <div class="timeline-year" aria-label={`Repräsentatives Jahr ${formatHistoricalYearDe(entry.data.timelineYear)}`}>
                  {formatHistoricalYearDe(entry.data.timelineYear)}
                </div>

                <div class="timeline-content">
                  <h3><a href={`/de/entries/${entry.id}/`}>{translation.data.claim}</a></h3>
                  <p class="timeline-meta">
                    <span>{categoryLabel(entry.data.category, 'de')}</span>
                    <span aria-hidden="true">·</span>
                    <span>{statusLabel(entry.data.status, 'de')}</span>
                  </p>
                  <p class="timeline-summary">{translation.data.summary}</p>
                  <p class="change-period"><strong>Ungefähr geändert:</strong> {translation.data.changedApproximately}</p>
                </div>
              </article>
            ))}
          </div>
        </section>
      );
    })}
  </div>

  <div class="container empty-state" hidden>
    <p>Keine Einträge entsprechen diesen Filtern.</p>
    <button class="empty-reset" type="button">Gesamte Zeitleiste anzeigen</button>
  </div>

  <noscript>
    <p class="container noscript-note">
      Suche, Filter und die Richtung der Zeitleiste benötigen JavaScript. Ohne JavaScript wird die vollständige Zeitleiste mit den neuesten Änderungen zuerst angezeigt.
    </p>
  </noscript>

  <script>
    const timeline = document.querySelector<HTMLElement>('.timeline');
    const searchInput = document.querySelector<HTMLInputElement>('.timeline-search');
    const directionSelect = document.querySelector<HTMLSelectElement>('.direction-select');
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-button'));
    const filterToggle = document.querySelector<HTMLButtonElement>('.filter-toggle');
    const filterPanel = document.querySelector<HTMLElement>('.filter-panel');
    const filterClose = document.querySelector<HTMLButtonElement>('.filter-close');
    const applyButton = document.querySelector<HTMLButtonElement>('.apply-filters');
    const clearButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.clear-filters'));
    const filterCount = document.querySelector<HTMLElement>('.filter-count');
    const activeFilterRow = document.querySelector<HTMLElement>('.active-filter-row');
    const activeFilterChips = document.querySelector<HTMLElement>('.active-filter-chips');
    const resultsSummary = document.querySelector<HTMLElement>('.results-summary');
    const emptyState = document.querySelector<HTMLElement>('.empty-state');
    const schoolContext = document.querySelector<HTMLElement>('.school-context');
    const schoolContextTitle = document.querySelector<HTMLElement>('.school-context-title');
    const clearSinceButton = document.querySelector<HTMLButtonElement>('.clear-since');
    const emptyResetButton = document.querySelector<HTMLButtonElement>('.empty-reset');

    const selectedCategories = new Set<string>();
    const selectedStatuses = new Set<string>();
    let direction: 'newest' | 'oldest' = 'newest';
    let sinceYear: number | null = null;

    const allEntries = () => Array.from(document.querySelectorAll<HTMLElement>('.timeline-entry'));
    const displayLabel = (type: string, value: string) =>
      filterButtons.find((button) => button.dataset.filterType === type && button.dataset.filterValue === value)?.dataset.filterLabel ?? value;

    const updateURL = () => {
      const url = new URL(window.location.href);
      const search = searchInput?.value.trim() ?? '';
      const setList = (key: string, values: Set<string>) => {
        values.size ? url.searchParams.set(key, [...values].sort().join(',')) : url.searchParams.delete(key);
      };
      setList('categories', selectedCategories);
      setList('statuses', selectedStatuses);
      search ? url.searchParams.set('q', search) : url.searchParams.delete('q');
      sinceYear !== null ? url.searchParams.set('since', String(sinceYear)) : url.searchParams.delete('since');
      direction === 'oldest' ? url.searchParams.set('direction', 'oldest') : url.searchParams.delete('direction');
      window.history.replaceState({}, '', url);
    };

    const openFilters = () => {
      if (!filterPanel || !filterToggle) return;
      filterPanel.hidden = false;
      filterToggle.setAttribute('aria-expanded', 'true');
      document.body.classList.add('timeline-filters-open');
      filterPanel.querySelector<HTMLButtonElement>('.filter-button')?.focus();
    };

    const closeFilters = (returnFocus = true) => {
      if (!filterPanel || !filterToggle) return;
      filterPanel.hidden = true;
      filterToggle.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('timeline-filters-open');
      if (returnFocus) filterToggle.focus();
    };

    const reorderTimeline = () => {
      if (!timeline) return;
      const groups = Array.from(timeline.querySelectorAll<HTMLElement>('.decade-group'));
      groups.sort((a, b) => {
        const aDecade = Number(a.dataset.decade ?? 0);
        const bDecade = Number(b.dataset.decade ?? 0);
        return direction === 'newest' ? bDecade - aDecade : aDecade - bDecade;
      }).forEach((group) => {
        const container = group.querySelector<HTMLElement>('.decade-entries');
        if (container) {
          const entries = Array.from(container.querySelectorAll<HTMLElement>('.timeline-entry'));
          entries.sort((a, b) => {
            const yearA = Number(a.dataset.year ?? 0);
            const yearB = Number(b.dataset.year ?? 0);
            const yearOrder = direction === 'newest' ? yearB - yearA : yearA - yearB;
            return yearOrder || (a.textContent ?? '').localeCompare(b.textContent ?? '', 'de', { sensitivity: 'base' });
          }).forEach((entry) => container.append(entry));
        }
        timeline.append(group);
      });
      timeline.dataset.direction = direction;
    };

    const removeFilter = (type: string, value: string) => {
      (type === 'category' ? selectedCategories : selectedStatuses).delete(value);
      updateDisplay();
    };

    const renderActiveFilters = () => {
      const selections = [
        ...[...selectedCategories].sort().map((value) => ({ type: 'category', value })),
        ...[...selectedStatuses].sort().map((value) => ({ type: 'status', value })),
      ];
      if (filterCount) {
        filterCount.textContent = String(selections.length);
        filterCount.hidden = selections.length === 0;
      }
      if (activeFilterRow) activeFilterRow.hidden = selections.length === 0;
      if (!activeFilterChips) return;
      activeFilterChips.replaceChildren();
      selections.forEach(({ type, value }) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'active-filter-chip';
        const labelText = displayLabel(type, value);
        button.setAttribute('aria-label', `Filter ${labelText} entfernen`);
        const label = document.createElement('span');
        label.textContent = labelText;
        const x = document.createElement('span');
        x.setAttribute('aria-hidden', 'true');
        x.textContent = '×';
        button.append(label, x);
        button.addEventListener('click', () => removeFilter(type, value));
        activeFilterChips.append(button);
      });
    };

    const updateFilterCounts = (query: string) => {
      const entries = allEntries();
      filterButtons.forEach((button) => {
        const type = button.dataset.filterType;
        const value = button.dataset.filterValue ?? '';
        if (!value || (type !== 'category' && type !== 'status')) return;
        const count = entries.filter((entry) => {
          const year = Number(entry.dataset.year ?? 0);
          const sinceMatch = sinceYear === null || year >= sinceYear;
          const searchMatch = !query || (entry.dataset.search ?? '').includes(query);
          const categoryMatch = type === 'category'
            ? entry.dataset.category === value
            : selectedCategories.size === 0 || selectedCategories.has(entry.dataset.category ?? '');
          const statusMatch = type === 'status'
            ? entry.dataset.status === value
            : selectedStatuses.size === 0 || selectedStatuses.has(entry.dataset.status ?? '');
          return sinceMatch && searchMatch && categoryMatch && statusMatch;
        }).length;
        const countElement = button.querySelector<HTMLElement>('.count');
        if (countElement) countElement.textContent = String(count);
      });
    };

    const updateDisplay = () => {
      const query = searchInput?.value.trim().toLocaleLowerCase('de') ?? '';
      let visibleCount = 0;
      allEntries().forEach((entry) => {
        const categoryMatch = selectedCategories.size === 0 || selectedCategories.has(entry.dataset.category ?? '');
        const statusMatch = selectedStatuses.size === 0 || selectedStatuses.has(entry.dataset.status ?? '');
        const searchMatch = !query || (entry.dataset.search ?? '').includes(query);
        const year = Number(entry.dataset.year ?? 0);
        const sinceMatch = sinceYear === null || year >= sinceYear;
        const visible = categoryMatch && statusMatch && searchMatch && sinceMatch;
        entry.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      document.querySelectorAll<HTMLElement>('.decade-group').forEach((group) => {
        group.hidden = !Array.from(group.querySelectorAll<HTMLElement>('.timeline-entry')).some((entry) => !entry.hidden);
      });

      filterButtons.forEach((button) => {
        const value = button.dataset.filterValue ?? '';
        const active = button.dataset.filterType === 'category' ? selectedCategories.has(value) : selectedStatuses.has(value);
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });

      updateFilterCounts(query);
      const hasFilters = selectedCategories.size > 0 || selectedStatuses.size > 0 || query.length > 0 || sinceYear !== null;
      if (resultsSummary) {
        if (sinceYear !== null) resultsSummary.textContent = `${visibleCount} ${visibleCount === 1 ? 'Eintrag wurde' : 'Einträge wurden'} seit ${sinceYear} geändert`;
        else if (hasFilters) resultsSummary.textContent = `${visibleCount} von ${allEntries().length} ${visibleCount === 1 ? 'Eintrag' : 'Einträgen'} werden angezeigt`;
        else resultsSummary.textContent = `Alle ${allEntries().length} Einträge werden angezeigt`;
      }

      if (schoolContext && schoolContextTitle) {
        if (sinceYear !== null) {
          schoolContext.hidden = false;
          schoolContextTitle.textContent = `Was änderte sich seit dem Schulbeginn im Jahr ${sinceYear}?`;
        } else schoolContext.hidden = true;
      }
      if (applyButton) applyButton.textContent = visibleCount === 1 ? '1 Ergebnis anzeigen' : `${visibleCount} Ergebnisse anzeigen`;
      if (emptyState) emptyState.hidden = visibleCount !== 0;
      renderActiveFilters();
      updateURL();
    };

    const clearFilters = () => {
      selectedCategories.clear();
      selectedStatuses.clear();
      updateDisplay();
    };

    filterButtons.forEach((button) => button.addEventListener('click', () => {
      const value = button.dataset.filterValue;
      if (!value) return;
      const target = button.dataset.filterType === 'category' ? selectedCategories : selectedStatuses;
      target.has(value) ? target.delete(value) : target.add(value);
      updateDisplay();
    }));
    searchInput?.addEventListener('input', updateDisplay);
    directionSelect?.addEventListener('change', () => {
      direction = directionSelect.value === 'oldest' ? 'oldest' : 'newest';
      reorderTimeline();
      updateURL();
    });
    filterToggle?.addEventListener('click', () => filterPanel?.hidden ? openFilters() : closeFilters());
    filterClose?.addEventListener('click', () => closeFilters());
    applyButton?.addEventListener('click', () => closeFilters());
    clearButtons.forEach((button) => button.addEventListener('click', clearFilters));
    clearSinceButton?.addEventListener('click', () => { sinceYear = null; updateDisplay(); });
    emptyResetButton?.addEventListener('click', () => {
      selectedCategories.clear();
      selectedStatuses.clear();
      sinceYear = null;
      if (searchInput) searchInput.value = '';
      updateDisplay();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && filterPanel && !filterPanel.hidden) closeFilters();
    });

    filterPanel?.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab' || !window.matchMedia('(max-width: 760px)').matches) return;

      const focusable = Array.from(
        filterPanel.querySelectorAll<HTMLElement>(
          'button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])'
        )
      ).filter((element) => !element.hasAttribute('hidden'));

      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    const url = new URL(window.location.href);
    const readList = (key: string, target: Set<string>) => {
      url.searchParams.get(key)?.split(',').map((value) => value.trim()).filter(Boolean).forEach((value) => target.add(value));
    };
    readList('categories', selectedCategories);
    readList('statuses', selectedStatuses);
    const rawSince = url.searchParams.get('since');
    if (rawSince) {
      const parsed = Number(rawSince);
      const currentYear = new Date().getFullYear();
      if (Number.isInteger(parsed) && parsed >= 1900 && parsed <= currentYear) sinceYear = parsed;
    }
    if (searchInput) searchInput.value = url.searchParams.get('q') ?? '';
    direction = url.searchParams.get('direction') === 'oldest' ? 'oldest' : 'newest';
    if (directionSelect) directionSelect.value = direction;
    reorderTimeline();
    updateDisplay();
  </script>
</BaseLayout>

<style>
  .timeline-head { padding: 5rem 0 2.5rem; }
  .timeline-head h1 { margin: .2rem 0 1rem; }
  .timeline-intro { font-size: 1.2rem; color: var(--muted); }
  .school-context { padding-bottom: 2.5rem; }
  .school-context[hidden] { display: none; }
  .school-context-inner { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding: clamp(1.4rem,4vw,2rem); border: 1px solid var(--line); border-left: 5px solid var(--accent); background: var(--card); }
  .school-context h2 { margin: .15rem 0 .55rem; font-size: clamp(1.5rem,3vw,2.15rem); }
  .school-context-copy { max-width: 68ch; margin: 0; color: var(--muted); }
  .clear-since { flex: 0 0 auto; border: 1px solid var(--line); border-radius: 999px; padding: .6rem .9rem; color: var(--ink); background: var(--paper); font: inherit; font-weight: 800; cursor: pointer; }
  .clear-since:hover { border-color: var(--accent-dark); color: var(--accent-dark); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .timeline-controls { position: sticky; top: 0; z-index: 20; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: color-mix(in srgb,var(--paper) 95%,transparent); backdrop-filter: blur(10px); }
  .controls-inner { position: relative; display: grid; grid-template-columns: minmax(14rem,1fr) auto auto; gap: .65rem; align-items: center; padding: .8rem 0 .65rem; }
  .timeline-search, .direction-select { min-height: 2.75rem; border: 1px solid var(--line); border-radius: .65rem; padding: .62rem .8rem; color: var(--ink); background: var(--card); font: inherit; }
  .timeline-search { width: 100%; }
  .direction-select { cursor: pointer; }
  .filter-toggle { min-height: 2.75rem; display: inline-flex; align-items: center; justify-content: center; gap: .45rem; border: 1px solid var(--line); border-radius: 999px; padding: .55rem .9rem; color: var(--ink); background: var(--card); font: inherit; font-weight: 800; cursor: pointer; }
  .filter-count { min-width: 1.35rem; padding: .05rem .35rem; border-radius: 999px; color: white; background: var(--accent-dark); font-size: .72rem; line-height: 1.2; text-align: center; }
  .active-filter-row { grid-column: 1 / -1; display: flex; align-items: center; gap: .6rem; }
  .active-filter-row[hidden] { display: none; }
  .active-filter-chips { display: flex; gap: .4rem; overflow-x: auto; scrollbar-width: thin; flex: 1; }
  :global(.active-filter-chip) { flex: 0 0 auto; display: inline-flex; align-items: center; gap: .35rem; border: 1px solid var(--line); border-radius: 999px; padding: .28rem .6rem; color: var(--ink); background: var(--card); font: inherit; font-size: .82rem; font-weight: 750; cursor: pointer; }
  .clear-filters { border: 0; color: var(--accent-dark); background: transparent; font: inherit; font-size: .86rem; font-weight: 800; cursor: pointer; white-space: nowrap; }
  .results-summary { grid-column: 1 / -1; margin: 0; color: var(--muted); font-size: .86rem; }
  .filter-panel { position: absolute; right: 0; top: calc(100% + .45rem); width: min(52rem,100%); max-height: min(72vh,42rem); display: grid; grid-template-rows: auto minmax(0,1fr) auto; border: 1px solid var(--line); border-radius: .9rem; background: var(--card); box-shadow: 0 1.2rem 3rem color-mix(in srgb,var(--ink) 18%,transparent); overflow: hidden; }
  .filter-panel[hidden] { display: none; }
  .filter-panel-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: 1rem 1rem .8rem; border-bottom: 1px solid var(--line); }
  .filter-label, .group-label { margin: 0; font-weight: 850; }
  .filter-help { margin: .12rem 0 0; color: var(--muted); font-size: .88rem; }
  .filter-close { width: 2.1rem; height: 2.1rem; border: 0; border-radius: 999px; color: var(--ink); background: var(--paper); font: inherit; font-size: 1.35rem; cursor: pointer; }
  .filter-panel-scroll { overflow: auto; padding: 1rem; }
  .filter-groups { display: grid; gap: 1.2rem; }
