---
import type { CollectionEntry } from 'astro:content';
import { lifespanYears } from '../lib/lifespans';
import {
  categoryLabel,
  formatApproxYearsLocalized,
  statusLabel,
  type EntryTranslation,
  type SiteLocale,
} from '../lib/i18n';

interface Props {
  entry: CollectionEntry<'entries'>;
  expanded?: boolean;
  locale?: SiteLocale;
  translation?: EntryTranslation;
}

const { entry, expanded = false, locale = 'en', translation } = Astro.props;
const { data } = entry;
const translated = locale === 'de' ? translation?.data : undefined;
const lifespan = lifespanYears(data.acceptedYear, data.timelineYear);
const lifespanComparable = data.lifespanComparable !== false;
const entryHref = locale === 'de' ? `/de/entries/${entry.id}/` : `/entries/${entry.id}/`;
const categoryHref = locale === 'de'
  ? `/de/browse?category=${encodeURIComponent(data.category)}`
  : `/categories/${data.category.toLowerCase()}/`;

const labels = locale === 'de'
  ? {
      stamp: 'Keine Tatsache mehr',
      now: 'Was wir heute wissen',
      why: 'Warum sich das änderte',
      status: 'Status',
      category: 'Kategorie',
      acceptedFor: 'Akzeptiert für',
      acceptedApproximately: 'Ungefähr akzeptiert',
      changedApproximately: 'Ungefähr geändert',
      notQuantified: 'Nicht quantifiziert',
      read: 'Belege ansehen →',
    }
  : {
      stamp: 'Not a fact anymore',
      now: 'What we know now',
      why: 'Why it changed',
      status: 'Status',
      category: 'Category',
      acceptedFor: 'Accepted for',
      acceptedApproximately: 'Accepted approximately',
      changedApproximately: 'Changed approximately',
      notQuantified: 'Not quantified',
      read: 'Read the evidence →',
    };
---
<article class:list={["fact-card", { expanded }]}>
  <p class="stamp">{labels.stamp}</p>
  <h2><a href={entryHref}>{translated?.claim ?? data.claim}</a></h2>

  <div class="explanation-grid">
    <section>
      <h3>{labels.now}</h3>
      <p>{translated?.currentUnderstanding ?? data.currentUnderstanding}</p>
    </section>

    {expanded && (
      <section>
        <h3>{labels.why}</h3>
        <p>{translated?.whyItChanged ?? data.whyItChanged}</p>
      </section>
    )}
  </div>

  <dl>
    <div><dt>{labels.status}</dt><dd><span class="pill">{statusLabel(data.status, locale)}</span></dd></div>
    <div><dt>{labels.category}</dt><dd><a href={categoryHref}>{categoryLabel(data.category, locale)}</a></dd></div>
    <div><dt>{labels.acceptedFor}</dt><dd><span class="lifespan-pill">{lifespanComparable ? formatApproxYearsLocalized(lifespan, locale) : labels.notQuantified}</span></dd></div>
    {expanded && <div><dt>{labels.acceptedApproximately}</dt><dd>{translated?.acceptedApproximately ?? data.acceptedApproximately}</dd></div>}
    <div><dt>{labels.changedApproximately}</dt><dd>{translated?.changedApproximately ?? data.changedApproximately}</dd></div>
  </dl>

  {!expanded && <a class="read" href={entryHref}>{labels.read}</a>}
</article>

<style>
  .fact-card {
    background: var(--card);
    border: 1px solid var(--line);
    border-top: 7px solid var(--accent);
    padding: clamp(1.3rem, 4vw, 2.2rem);
    box-shadow: 0 12px 30px rgb(30 24 13 / 6%);
  }

  .stamp {
    margin: 0 0 1rem;
    text-transform: uppercase;
    letter-spacing: .13em;
    font-size: .74rem;
    font-weight: 950;
    color: var(--accent-dark);
  }

  h2 {
    margin: 0 0 2rem;
    font-size: clamp(1.65rem, 4vw, 2.55rem);
    max-width: 38ch;
  }

  h2 a {
    text-decoration: none;
  }

  h2 a:hover {
    color: var(--accent-dark);
  }

  h3 {
    margin: 1.5rem 0 .25rem;
    font-size: .8rem;
    text-transform: uppercase;
    letter-spacing: .08em;
  }

  p {
    margin-top: 0;
  }

  .explanation-grid {
    min-width: 0;
  }

  .explanation-grid section {
    min-width: 0;
  }

  dl {
    border-top: 1px solid var(--line);
    margin: 1.6rem 0 0;
    padding-top: .8rem;
  }

  dl div {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) 2fr;
    gap: 1rem;
    padding: .35rem 0;
  }

  dt {
    color: var(--muted);
  }

  dd {
    margin: 0;
    font-weight: 650;
  }

  .pill,
  .lifespan-pill {
    display: inline-block;
    padding: .15rem .55rem;
    border-radius: 999px;
  }

  .pill {
    background: #eee7d8;
  }

  .lifespan-pill {
    background: color-mix(in srgb, var(--accent) 12%, var(--card));
    color: var(--accent-dark);
    font-variant-numeric: tabular-nums;
  }

  .read {
    display: inline-block;
    margin-top: 1.5rem;
    font-weight: 800;
    color: var(--accent-dark);
  }

  .expanded {
    box-shadow: none;
  }

  @media (min-width: 900px) {
    .expanded .explanation-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(2.5rem, 5vw, 5rem);
      align-items: start;
    }

    .expanded .explanation-grid h3 {
      margin-top: 0;
    }

    .expanded .explanation-grid p {
      max-width: 68ch;
    }
  }

  @media (max-width: 600px) {
    dl div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
