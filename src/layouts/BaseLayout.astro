---
import { siteConfig } from '../site-config';
import BackToTop from '../components/BackToTop.astro';
import GlossaryPopover from '../components/GlossaryPopover.astro';
import { localeMeta, localizedPath, type SiteLocale } from '../lib/i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonicalURL?: string | URL;
  type?: 'website' | 'article';
  noindex?: boolean;
  locale?: SiteLocale;
  alternatePath?: string;
}

const {
  locale = 'en',
  title = siteConfig.name,
  description = locale === 'de'
    ? 'Ein Katalog wissenschaftlicher Aussagen, die einst vernünftigerweise als Tatsachen galten, später aber durch bessere Evidenz widerlegt, ersetzt, eingeschränkt, neu eingeordnet oder korrigiert wurden.'
    : siteConfig.description,
  image = '/social-card.png',
  imageAlt = locale === 'de'
    ? `${siteConfig.name} - Fakten haben eine Geschichte.`
    : `${siteConfig.name} - Facts have a history.`,
  canonicalURL,
  type = 'website',
  noindex = false,
  alternatePath,
} = Astro.props;

const isLocaleHome = locale === 'de'
  ? Astro.url.pathname === '/de/' || Astro.url.pathname === '/de'
  : Astro.url.pathname === '/';

const pageTitle = isLocaleHome
  ? locale === 'de'
    ? `${siteConfig.name}: Wenn sich wissenschaftliches Wissen verändert`
    : `${siteConfig.name}: When Scientific Knowledge Changes`
  : title === siteConfig.name
    ? title
    : `${title} | ${siteConfig.name}`;

const siteURL = Astro.site ?? new URL('https://notafactanymore.com');

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Not a Fact Anymore',
  alternateName: 'notafactanymore.com',
  url: 'https://notafactanymore.com/',
  description: siteConfig.description,
};

const pageURL = canonicalURL
  ? new URL(canonicalURL.toString(), siteURL)
  : new URL(Astro.url.pathname, siteURL);

const socialImageURL = new URL(image, siteURL);
const otherLocale: SiteLocale = locale === 'de' ? 'en' : 'de';
const normalizedPath = Astro.url.pathname.length > 1
  ? Astro.url.pathname.replace(/\/$/, '')
  : Astro.url.pathname;
const germanShellRoutes = new Set([
  '/',
  '/browse',
  '/timeline',
  '/lifespans',
  '/about',
  '/methodology',
  '/submit',
  '/impressum',
]);
const englishEquivalent = localizedPath(normalizedPath, 'en');
const isKnownGermanPair = germanShellRoutes.has(englishEquivalent);
const resolvedAlternatePath = alternatePath ?? (isKnownGermanPair
  ? localizedPath(normalizedPath, otherLocale)
  : undefined);
const languageHref = resolvedAlternatePath ?? (locale === 'de' ? '/' : '/de/');

const englishPath = resolvedAlternatePath
  ? locale === 'en' ? Astro.url.pathname : resolvedAlternatePath
  : undefined;
const germanPath = resolvedAlternatePath
  ? locale === 'de' ? Astro.url.pathname : resolvedAlternatePath
  : undefined;

const navItems = locale === 'de'
  ? [
      ['/de/browse', 'Katalog'],
      ['/de/timeline', 'Zeitleiste'],
      ['/de/lifespans', 'Lebensdauer'],
      ['/de/methodology', 'Methodik'],
      ['/de/submit', 'Beitrag vorschlagen'],
      ['/de/about', 'Über das Projekt'],
    ]
  : [
      ['/browse', 'Browse'],
      ['/timeline', 'Timeline'],
      ['/lifespans', 'Lifespans'],
      ['/methodology', 'Methodology'],
      ['/submit', 'Submit a claim'],
      ['/about', 'About'],
    ];

const brandHome = locale === 'de' ? '/de/' : '/';
const navLabel = locale === 'de' ? 'Hauptnavigation' : 'Main navigation';
const brandLabel = locale === 'de' ? `${siteConfig.name} Startseite` : `${siteConfig.name} home`;
const skipLabel = locale === 'de' ? 'Zum Inhalt' : 'Skip to content';
---
<!doctype html>
<html lang={localeMeta[locale].htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    {locale === 'en' && Astro.url.pathname === '/' && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(websiteJsonLd)}
      />
    )}

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={pageURL.toString()} />
    {englishPath && germanPath && (
      <>
        <link rel="alternate" hreflang="en" href={new URL(englishPath, siteURL).toString()} />
        <link rel="alternate" hreflang="de" href={new URL(germanPath, siteURL).toString()} />
        <link rel="alternate" hreflang="x-default" href={new URL(englishPath, siteURL).toString()} />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#f5f1e8" />

    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={localeMeta[locale].ogLocale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageURL.toString()} />
    <meta property="og:image" content={socialImageURL.toString()} />
    <meta property="og:image:secure_url" content={socialImageURL.toString()} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL.toString()} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{skipLabel}</a>
    <header class="site-header">
      <a class="brand" href={brandHome} aria-label={brandLabel}>
        <span class="brand-mark" aria-hidden="true">NF</span>
        <span>{siteConfig.name}</span>
      </a>

      <div class="header-actions">
        <nav aria-label={navLabel}>
          {navItems.map(([href, label]) => {
            const current = normalizedPath === href;
            return <a href={href} aria-current={current ? 'page' : undefined}>{label}</a>;
          })}
        </nav>
        <a
          class="language-switch"
          href={languageHref}
          hreflang={otherLocale}
          lang={localeMeta[otherLocale].htmlLang}
          aria-label={locale === 'de' ? 'English version' : 'Deutsche Version'}
        >
          {localeMeta[otherLocale].shortName}
        </a>
      </div>
    </header>

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <GlossaryPopover locale={locale} />
    <BackToTop locale={locale} />

    <footer>
      {locale === 'de' ? (
        <>
          <p>
            <strong>{siteConfig.name}</strong> dokumentiert, wie sich belastbares Wissen verändert,
            wenn bessere Evidenz verfügbar wird.
          </p>
          <p>Jeder Eintrag ist datiert, belegt und offen für Korrekturen.</p>
          <p><a href="/de/impressum">Impressum</a></p>
        </>
      ) : (
        <>
          <p>
            <strong>{siteConfig.name}</strong> documents how defensible knowledge
            changes when stronger evidence arrives.
          </p>
          <p>Every entry is dated, sourced, and open to correction.</p>
          <p><a href="/impressum">Impressum</a></p>
        </>
      )}
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #171717;
    --muted: #646464;
    --paper: #f5f1e8;
    --card: #fffdf7;
    --accent: #d8482f;
    --accent-dark: #a92e1d;
    --line: #cec7b8;
    --max: 1120px;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system,
      BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--ink);
    background: var(--paper);
  }

  * { box-sizing: border-box; }
  html { background: var(--paper); }
  body {
    margin: 0;
    line-height: 1.6;
    overflow-wrap: break-word;
    background: var(--paper);
  }
  a { color: inherit; }

  :where(a, button, input, select, textarea) {
    transition:
      color 150ms ease,
      background-color 150ms ease,
      border-color 150ms ease,
      box-shadow 150ms ease,
      opacity 150ms ease;
  }

  :where(a, button, input, select, textarea):focus-visible {
    outline: 3px solid color-mix(in srgb, var(--accent) 42%, transparent);
    outline-offset: 3px;
  }

  .skip-link {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--ink);
    border-radius: 0.35rem;
    color: white;
    background: var(--ink);
    font-weight: 800;
    text-decoration: none;
    transform: translateY(calc(-100% - 1rem));
  }

  .skip-link {
    transition:
      transform 150ms ease,
      color 150ms ease,
      background-color 150ms ease,
      border-color 150ms ease;
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  .site-header {
    width: min(var(--max), calc(100% - 2rem));
    margin: 0 auto;
    min-height: 78px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-weight: 850;
    text-decoration: none;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    background: var(--accent);
    color: white;
    border-radius: 50%;
    font-size: 0.8rem;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  nav {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  nav a {
    color: var(--muted);
    text-decoration: none;
    font-weight: 650;
  }

  nav a:hover { color: var(--accent-dark); }

  nav a[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35rem;
  }

  .language-switch {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding: 0.25rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--ink);
    background: var(--card);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.06em;
  }

  .language-switch:hover,
  .language-switch:focus-visible {
    border-color: var(--accent-dark);
    color: var(--accent-dark);
  }

  main { min-height: 70vh; }

  .container {
    width: min(var(--max), calc(100% - 2rem));
    margin: 0 auto;
  }

  .narrow {
    width: min(760px, calc(100% - 2rem));
    margin: 0 auto;
  }

  h1, h2, h3 {
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  h1, h2 {
    text-wrap: balance;
  }

  h1 { font-size: clamp(2.5rem, 7vw, 5.75rem); }
  h2 { font-size: clamp(1.7rem, 4vw, 2.8rem); }
  p { max-width: 72ch; }

  .lead,
  .intro,
  .section-intro,
  .timeline-intro {
    text-wrap: pretty;
  }

  .eyebrow {
    text-transform: uppercase;
    font-weight: 900;
    letter-spacing: 0.12em;
    font-size: 0.75rem;
    color: var(--accent-dark);
  }

  .button {
    display: inline-block;
    background: var(--ink);
    color: white;
    border: 0;
    border-radius: 999px;
    padding: 0.8rem 1.2rem;
    font: inherit;
    font-weight: 750;
    text-decoration: none;
    cursor: pointer;
  }

  .button:hover { background: var(--accent-dark); }

  .button.secondary {
    color: var(--ink);
    background: transparent;
    border: 1px solid var(--ink);
  }

  .button.secondary:hover {
    border-color: var(--accent-dark);
    color: white;
    background: var(--accent-dark);
  }

  footer {
    width: min(var(--max), calc(100% - 2rem));
    margin: 5rem auto 0;
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  footer p { margin: 0; max-width: 35rem; }
  footer a { text-underline-offset: 0.18em; }

  @media (prefers-reduced-motion: reduce) {
    :where(a, button, input, select, textarea),
    .skip-link {
      transition: none !important;
    }
  }

  @media (max-width: 900px) {
    .site-header,
    .header-actions { align-items: flex-start; }

    .header-actions {
      width: 100%;
      justify-content: space-between;
    }
  }

  @media (max-width: 760px) {
    .site-header {
      align-items: flex-start;
      flex-direction: column;
      padding: 1rem 0;
    }

    .header-actions { gap: 0.75rem; }
    nav { gap: 0.8rem 1rem; }
  }
</style>
