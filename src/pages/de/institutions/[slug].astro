---
import { getCollection } from 'astro:content';
import InstitutionalBeliefDetailPage from '../../../components/InstitutionalBeliefDetailPage.astro';
import { currentInstitutionalTranslationMap } from '../../../lib/institutionalBeliefs';

export async function getStaticPaths() {
  const beliefs = await getCollection('institutionalBeliefs');
  const translations = await getCollection(
    'institutionalBeliefTranslations',
    (translation) => translation.data.locale === 'de',
  );
  const currentTranslations = currentInstitutionalTranslationMap(beliefs, translations);

  return beliefs.flatMap((belief) => {
    const translation = currentTranslations.get(belief.id);
    return translation
      ? [{
          params: { slug: belief.id },
          props: { belief, translation },
        }]
      : [];
  });
}

const { belief, translation } = Astro.props;
---

<InstitutionalBeliefDetailPage
  belief={belief}
  translation={translation}
  locale="de"
/>
