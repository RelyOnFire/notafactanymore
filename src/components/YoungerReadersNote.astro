---
import { localizedPath, type SiteLocale } from '../lib/i18n';
const { locale = 'en' } = Astro.props as { locale?: SiteLocale };
---
<aside class="younger-readers container">
  <p>{locale === 'de' ? 'Liest du mit Kindern? Einige Einträge behandeln Tod, Diskriminierung oder schädliche medizinische Praktiken.' : 'Reading with children? Some entries discuss death, discrimination or harmful medical practices.'} <a href={localizedPath('/kids/', locale)}>{locale === 'de' ? 'Junge Entdecker bietet eine eigene Auswahl für jüngere Leserinnen und Leser.' : 'Young Explorers offers a separate selection for younger readers.'}</a></p>
</aside>
<style>
  .younger-readers { border-left: 3px solid #6b8b73; background: #e5ece5; padding: .85rem 1.1rem; margin-top: 1.5rem; margin-bottom: 1.5rem; }
  p { font-size: .9rem; margin: 0; max-width: none; } a { font-weight: 700; text-underline-offset: .2rem; }
</style>
