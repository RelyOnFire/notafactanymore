---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompactClaim from '../../components/CompactClaim.astro';
import FactCard from '../../components/FactCard.astro';
import {
  categoryLabel,
  statusLabel,
  translationMatchesEntry,
} from '../../lib/i18n';

const claimCollator = new Intl.Collator('de', {
  sensitivity: 'base',
  numeric: true,
});

const claimSortKey = (claim: string) => {
  let key = claim.trim();
  const leadingWords = /^(?:(?:der|die|das|ein(?:e|er|es|em|en)?|alle|jeder|jede|jedes|es)\s+)+/i;
  const stripped = key.replace(leadingWords, '');
  key = stripped || key;
  return key.replace(/^[^\p{L}\p{N}]+/u, '').trim() || claim.trim();
};

const entries = await getCollection('entries');
const translations = await getCollection(
  'entryTranslations',
  (translation) => translation.data.locale === 'de',
);

const items = translations
  .map((translation) => {
    const entry = entries.find((candidate) => candidate.id === translation.data.entryId);
    return entry && translationMatchesEntry(entry, translation) ? { entry, translation } : null;
  })
  .filter((item): item is NonNullable<typeof item> => Boolean(item))
  .sort((a, b) => {
    const bySubject = claimCollator.compare(
      claimSortKey(a.translation.data.claim),
      claimSortKey(b.translation.data.claim),
    );
    return bySubject || claimCollator.compare(a.translation.data.claim, b.translation.data.claim);
  });

const categories = [...new Set(items.map(({ entry }) => entry.data.category))]
  .sort((a, b) => categoryLabel(a, 'de').localeCompare(categoryLabel(b, 'de'), 'de'));

const statuses = [...new Set(items.map(({ entry }) => entry.data.status))]
  .sort((a, b) => statusLabel(a, 'de').localeCompare(statusLabel(b, 'de'), 'de'));
---
<BaseLayout
  locale="de"
  title="Katalog"
  description="Durchsuche den vollständigen deutschsprachigen Katalog wissenschaftlicher und historischer Aussagen, deren Bewertung sich durch bessere Evidenz verändert hat."
  alternatePath="/browse"
>
  <header class="page-head container">
    <p class="eyebrow">Der Katalog</p>
    <h1>Einträge durchsuchen</h1>
    <p>
      Durchsuche die vollständige Sammlung, grenze sie nach Kategorie oder Status ein,
      ändere die Sortierung und wechsle zwischen ausführlichen Karten und einer kompakten Liste.
    </p>
  </header>

  <section class="filter-region" aria-label="Katalogsteuerung">
    <div class="container filter-inner">
      <div class="primary-controls">
        <label class="search-field">
          <span class="sr-only">Aussagen durchsuchen</span>
          <input
            type="search"
            class="catalogue-search"
            placeholder="Aussagen und heutigen Wissensstand durchsuchen…"
            autocomplete="off"
          />
        </label>

        <label class="sort-field">
          <span class="sr-only">Katalog sortieren</span>
          <select class="sort-select" aria-label="Katalog sortieren">
            <option value="subject">Thema A–Z</option>
            <option value="newest-change">Neueste Änderung</option>
            <option value="oldest-change">Älteste Änderung</option>
            <option value="shortest-lived">Kürzeste Lebensdauer</option>
            <option value="longest-lived">Längste Lebensdauer</option>
            <option value="recently-added">Zuletzt hinzugefügt</option>
          </select>
        </label>

        <fieldset class="view-switcher">
          <legend class="sr-only">Ansicht</legend>
          <div class="view-buttons">
            <button class="view-button" type="button" data-view="cards" aria-pressed="true">Karten</button>
            <button class="view-button" type="button" data-view="compact" aria-pressed="false">Kompakt</button>
          </div>
        </fieldset>

        <button
          class="filter-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="catalogue-filter-panel"
        >
          <span>Filter</span>
          <span class="filter-count" hidden>0</span>
        </button>
      </div>

      <div class="active-filter-row" hidden>
        <div class="active-filter-chips" aria-label="Aktive Filter"></div>
        <button class="clear-filters clear-filters-inline" type="button">Alle löschen</button>
      </div>

      <div class="catalogue-summary-row">
        <p class="results-summary" aria-live="polite">Alle {items.length} Einträge werden angezeigt</p>
      </div>

      <div
        class="filter-panel"
        id="catalogue-filter-panel"
        hidden
        aria-label="Katalog filtern"
      >
        <div class="filter-panel-header">
          <div>
            <p class="filter-label">Katalog filtern</p>
            <p class="filter-help">Kategorien und Status lassen sich beliebig kombinieren.</p>
          </div>
          <button class="filter-close" type="button" aria-label="Filter schließen">×</button>
        </div>

        <div class="filter-panel-scroll">
          <div class="filter-groups">
            <div>
              <p class="group-label">Kategorien</p>
              <div class="filters" role="group" aria-label="Einträge nach Kategorie filtern">
                {categories.map((category) => {
                  const count = items.filter(({ entry }) => entry.data.category === category).length;
                  const label = categoryLabel(category, 'de');
                  return (
                    <button
                      class="filter-button"
                      type="button"
                      data-filter-type="category"
                      data-filter-value={category}
                      data-filter-label={label}
                      aria-pressed="false"
                    >
                      {label}<span class="count">{count}</span>
                    </button>
                  );
                })}
              </div>
            </div>

            <div>
              <p class="group-label">Status</p>
              <div class="filters" role="group" aria-label="Einträge nach Status filtern">
                {statuses.map((status) => {
                  const count = items.filter(({ entry }) => entry.data.status === status).length;
                  const label = statusLabel(status, 'de');
                  return (
                    <button
                      class="filter-button"
                      type="button"
                      data-filter-type="status"
                      data-filter-value={status}
                      data-filter-label={label}
                      aria-pressed="false"
                    >
                      {label}<span class="count">{count}</span>
                    </button>
                  );
                })}
              </div>
            </div>
          </div>
        </div>

        <div class="filter-panel-actions">
          <button class="clear-filters clear-filters-panel" type="button">Alle löschen</button>
          <button class="apply-filters" type="button">Alle {items.length} Einträge anzeigen</button>
        </div>
      </div>
    </div>
  </section>

  <section class="container catalogue catalogue-cards" aria-label="Katalog als Karten">
    {items.map(({ entry, translation }) => (
      <div
        class="entry-wrapper"
        data-entry-id={entry.id}
        data-category={entry.data.category}
        data-status={entry.data.status}
        data-search={`${translation.data.claim} ${translation.data.currentUnderstanding} ${translation.data.summary} ${categoryLabel(entry.data.category, 'de')} ${statusLabel(entry.data.status, 'de')} ${entry.data.category} ${entry.data.status}`.toLocaleLowerCase('de')}
        data-claim={translation.data.claim}
        data-subject={claimSortKey(translation.data.claim)}
        data-timeline-year={entry.data.timelineYear}
        data-lifespan={entry.data.lifespanComparable === false ? '' : entry.data.timelineYear - entry.data.acceptedYear}
        data-published-at={entry.data.publishedAt.getTime()}
      >
        <FactCard entry={entry} translation={translation} locale="de" />
      </div>
    ))}
  </section>

  <section class="container catalogue catalogue-compact" aria-label="Kompakte Katalogansicht" hidden>
    {items.map(({ entry, translation }) => (
      <div
        class="entry-wrapper"
        data-entry-id={entry.id}
        data-category={entry.data.category}
        data-status={entry.data.status}
        data-search={`${translation.data.claim} ${translation.data.currentUnderstanding} ${translation.data.summary} ${categoryLabel(entry.data.category, 'de')} ${statusLabel(entry.data.status, 'de')} ${entry.data.category} ${entry.data.status}`.toLocaleLowerCase('de')}
        data-claim={translation.data.claim}
        data-subject={claimSortKey(translation.data.claim)}
        data-timeline-year={entry.data.timelineYear}
        data-lifespan={entry.data.lifespanComparable === false ? '' : entry.data.timelineYear - entry.data.acceptedYear}
        data-published-at={entry.data.publishedAt.getTime()}
      >
        <CompactClaim entry={entry} translation={translation} locale="de" />
      </div>
    ))}
  </section>

  <p class="container empty-state" hidden>Keine Einträge entsprechen diesen Filtern.</p>

  <noscript>
    <p class="container noscript-note">
      Suche, Filter, Sortierung und die kompakte Ansicht benötigen JavaScript.
      Ohne JavaScript werden alle Einträge als Karten angezeigt.
    </p>
  </noscript>

  <script>
    const filterButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-button'));
    const viewButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.view-button'));
    const catalogues = Array.from(document.querySelectorAll<HTMLElement>('.catalogue'));
    const searchInput = document.querySelector<HTMLInputElement>('.catalogue-search');
    const sortSelect = document.querySelector<HTMLSelectElement>('.sort-select');
    const filterToggle = document.querySelector<HTMLButtonElement>('.filter-toggle');
    const filterPanel = document.querySelector<HTMLElement>('.filter-panel');
    const filterClose = document.querySelector<HTMLButtonElement>('.filter-close');
    const applyButton = document.querySelector<HTMLButtonElement>('.apply-filters');
    const clearButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.clear-filters'));
    const filterCount = document.querySelector<HTMLElement>('.filter-count');
    const activeFilterRow = document.querySelector<HTMLElement>('.active-filter-row');
    const activeFilterChips = document.querySelector<HTMLElement>('.active-filter-chips');
    const resultsSummary = document.querySelector<HTMLElement>('.results-summary');
    const emptyState = document.querySelector<HTMLElement>('.empty-state');

    const selectedCategories = new Set<string>();
    const selectedStatuses = new Set<string>();

    type SortMode = 'subject' | 'newest-change' | 'oldest-change' | 'shortest-lived' | 'longest-lived' | 'recently-added';
    let currentView: 'cards' | 'compact' = 'cards';
    let currentSort: SortMode = 'subject';
    let visibleCount = 0;

    const allWrappers = () => Array.from(document.querySelectorAll<HTMLElement>('.entry-wrapper'));
    const deCompare = (a: string, b: string) => a.localeCompare(b, 'de', { sensitivity: 'base', numeric: true });

    const compareWrappers = (a: HTMLElement, b: HTMLElement) => {
      const claimA = a.dataset.claim ?? '';
      const claimB = b.dataset.claim ?? '';
      const subjectA = a.dataset.subject ?? claimA;
      const subjectB = b.dataset.subject ?? claimB;
      const yearA = Number(a.dataset.timelineYear ?? 0);
      const yearB = Number(b.dataset.timelineYear ?? 0);
      const comparableA = Boolean(a.dataset.lifespan);
      const comparableB = Boolean(b.dataset.lifespan);
      const lifespanA = comparableA ? Number(a.dataset.lifespan) : 0;
      const lifespanB = comparableB ? Number(b.dataset.lifespan) : 0;
      const publishedA = Number(a.dataset.publishedAt ?? 0);
      const publishedB = Number(b.dataset.publishedAt ?? 0);

      if (currentSort === 'newest-change') return yearB - yearA || deCompare(subjectA, subjectB);
      if (currentSort === 'oldest-change') return yearA - yearB || deCompare(subjectA, subjectB);
      if (currentSort === 'shortest-lived') {
        if (comparableA !== comparableB) return comparableA ? -1 : 1;
        return lifespanA - lifespanB || yearA - yearB || deCompare(subjectA, subjectB);
      }
      if (currentSort === 'longest-lived') {
        if (comparableA !== comparableB) return comparableA ? -1 : 1;
        return lifespanB - lifespanA || yearB - yearA || deCompare(subjectA, subjectB);
      }
      if (currentSort === 'recently-added') return publishedB - publishedA || deCompare(subjectA, subjectB);
      return deCompare(subjectA, subjectB) || deCompare(claimA, claimB);
    };

    const sortCatalogues = () => {
      catalogues.forEach((catalogue) => {
        const wrappers = Array.from(catalogue.querySelectorAll<HTMLElement>('.entry-wrapper'));
        wrappers.sort(compareWrappers).forEach((wrapper) => catalogue.append(wrapper));
      });
    };

    const updateURL = () => {
      const url = new URL(window.location.href);
      const search = searchInput?.value.trim() ?? '';
      const setList = (key: string, values: Set<string>) => {
        if (values.size) url.searchParams.set(key, [...values].sort().join(','));
        else url.searchParams.delete(key);
      };
      setList('categories', selectedCategories);
      setList('statuses', selectedStatuses);
      search ? url.searchParams.set('q', search) : url.searchParams.delete('q');
      currentView === 'compact' ? url.searchParams.set('view', 'compact') : url.searchParams.delete('view');
      currentSort !== 'subject' ? url.searchParams.set('sort', currentSort) : url.searchParams.delete('sort');
      window.history.replaceState({}, '', url);
    };

    const openFilters = () => {
      if (!filterPanel || !filterToggle) return;
      filterPanel.hidden = false;
      filterToggle.setAttribute('aria-expanded', 'true');
      document.body.classList.add('filters-open');
      filterPanel.querySelector<HTMLButtonElement>('.filter-button')?.focus();
    };

    const closeFilters = (returnFocus = true) => {
      if (!filterPanel || !filterToggle) return;
      filterPanel.hidden = true;
      filterToggle.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('filters-open');
      if (returnFocus) filterToggle.focus();
    };

    const setView = (view: 'cards' | 'compact') => {
      currentView = view;
      catalogues.forEach((catalogue) => {
        catalogue.hidden = !catalogue.classList.contains(`catalogue-${view}`);
      });
      viewButtons.forEach((button) => {
        const active = button.dataset.view === view;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      try { localStorage.setItem('catalogue-view', view); } catch {}
      updateDisplay();
    };

    const setSort = (sort: SortMode) => {
      currentSort = sort;
      if (sortSelect) sortSelect.value = sort;
      sortCatalogues();
      updateURL();
    };

    const removeFilter = (type: string, value: string) => {
      (type === 'category' ? selectedCategories : selectedStatuses).delete(value);
      updateDisplay();
    };

    const displayLabel = (type: string, value: string) =>
      filterButtons.find((button) => button.dataset.filterType === type && button.dataset.filterValue === value)?.dataset.filterLabel ?? value;

    const renderActiveFilters = () => {
      const selections = [
        ...[...selectedCategories].sort().map((value) => ({ type: 'category', value })),
        ...[...selectedStatuses].sort().map((value) => ({ type: 'status', value })),
      ];
      const count = selections.length;
      if (filterCount) {
        filterCount.textContent = String(count);
        filterCount.hidden = count === 0;
      }
      if (activeFilterRow) activeFilterRow.hidden = count === 0;
      if (!activeFilterChips) return;
      activeFilterChips.replaceChildren();
      selections.forEach(({ type, value }) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'active-filter-chip';
        const labelText = displayLabel(type, value);
        button.setAttribute('aria-label', `Filter ${labelText} entfernen`);
        const label = document.createElement('span');
        label.textContent = labelText;
        const removeIcon = document.createElement('span');
        removeIcon.setAttribute('aria-hidden', 'true');
        removeIcon.textContent = '×';
        button.append(label, removeIcon);
        button.addEventListener('click', () => removeFilter(type, value));
        activeFilterChips.append(button);
      });
    };

    const updateDisplay = () => {
      const query = searchInput?.value.trim().toLocaleLowerCase('de') ?? '';
      const visibility = new Map<string, boolean>();
      visibleCount = 0;

      allWrappers().forEach((wrapper) => {
        const id = wrapper.dataset.entryId ?? '';
        if (visibility.has(id)) {
          wrapper.hidden = !visibility.get(id);
          return;
        }
        const categoryMatch = selectedCategories.size === 0 || selectedCategories.has(wrapper.dataset.category ?? '');
        const statusMatch = selectedStatuses.size === 0 || selectedStatuses.has(wrapper.dataset.status ?? '');
        const searchMatch = !query || (wrapper.dataset.search ?? '').includes(query);
        const visible = categoryMatch && statusMatch && searchMatch;
        visibility.set(id, visible);
        wrapper.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      filterButtons.forEach((button) => {
        const value = button.dataset.filterValue ?? '';
        const active = button.dataset.filterType === 'category'
          ? selectedCategories.has(value)
          : selectedStatuses.has(value);
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });

      const hasFilters = selectedCategories.size > 0 || selectedStatuses.size > 0 || query.length > 0;
      if (emptyState) emptyState.hidden = visibleCount !== 0;
      if (resultsSummary) {
        resultsSummary.textContent = hasFilters
          ? `${visibleCount} von ${visibility.size} ${visibleCount === 1 ? 'Eintrag' : 'Einträgen'} werden angezeigt`
          : `Alle ${visibility.size} Einträge werden angezeigt`;
      }
      if (applyButton) applyButton.textContent = visibleCount === 1 ? '1 Ergebnis anzeigen' : `${visibleCount} Ergebnisse anzeigen`;
      sortCatalogues();
      renderActiveFilters();
      updateURL();
    };

    const clearFilters = () => {
      selectedCategories.clear();
      selectedStatuses.clear();
      updateDisplay();
    };

    filterButtons.forEach((button) => button.addEventListener('click', () => {
      const value = button.dataset.filterValue;
      if (!value) return;
      const target = button.dataset.filterType === 'category' ? selectedCategories : selectedStatuses;
      target.has(value) ? target.delete(value) : target.add(value);
      updateDisplay();
    }));

    viewButtons.forEach((button) => button.addEventListener('click', () => {
      const view = button.dataset.view;
      if (view === 'cards' || view === 'compact') setView(view);
    }));

    sortSelect?.addEventListener('change', () => {
      const value = sortSelect.value as SortMode;
      if (['subject', 'newest-change', 'oldest-change', 'shortest-lived', 'longest-lived', 'recently-added'].includes(value)) setSort(value);
    });
    searchInput?.addEventListener('input', updateDisplay);
    filterToggle?.addEventListener('click', () => filterPanel?.hidden ? openFilters() : closeFilters());
    filterClose?.addEventListener('click', () => closeFilters());
    applyButton?.addEventListener('click', () => closeFilters());
    clearButtons.forEach((button) => button.addEventListener('click', clearFilters));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && filterPanel && !filterPanel.hidden) closeFilters();
    });

    const url = new URL(window.location.href);
    const readList = (key: string, target: Set<string>) => {
      url.searchParams.get(key)?.split(',').map((value) => value.trim()).filter(Boolean).forEach((value) => target.add(value));
    };
    readList('categories', selectedCategories);
    readList('statuses', selectedStatuses);
    if (searchInput) searchInput.value = url.searchParams.get('q') ?? '';

    const requestedSort = url.searchParams.get('sort');
    if (requestedSort && ['newest-change', 'oldest-change', 'shortest-lived', 'longest-lived', 'recently-added'].includes(requestedSort)) {
      currentSort = requestedSort as SortMode;
    }
    if (sortSelect) sortSelect.value = currentSort;

    let savedView: string | null = null;
    try { savedView = localStorage.getItem('catalogue-view'); } catch {}
    const requestedView = url.searchParams.get('view') ?? savedView;
    sortCatalogues();
    setView(requestedView === 'compact' ? 'compact' : 'cards');
  </script>
</BaseLayout>

<style>
  .page-head { padding: 5rem 0 2rem; }
  .page-head h1 { margin: .2rem 0 1rem; }
  .page-head > p:not(.eyebrow) { font-size: 1.2rem; color: var(--muted); }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .filter-region { position: sticky; top: 0; z-index: 20; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--paper) 95%, transparent); backdrop-filter: blur(10px); }
  .filter-inner { position: relative; padding: .8rem 0 .65rem; }
  .primary-controls { display: grid; grid-template-columns: minmax(14rem,1fr) auto auto auto; gap: .65rem; align-items: center; }
  .search-field, .sort-field { display: block; }
  .catalogue-search, .sort-select { width: 100%; min-height: 2.75rem; border: 1px solid var(--line); border-radius: .65rem; padding: .62rem .8rem; color: var(--ink); background: var(--card); font: inherit; }
  .sort-select { width: auto; min-width: 12rem; cursor: pointer; }
  .catalogue-search:focus, .sort-select:focus { outline: 2px solid color-mix(in srgb, var(--accent) 45%, transparent); border-color: var(--accent-dark); }
  .view-switcher { margin: 0; padding: 0; border: 0; }
  .view-buttons { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; overflow: hidden; background: var(--card); }
  .view-button { border: 0; padding: .55rem .85rem; color: var(--ink); background: transparent; font: inherit; font-weight: 800; cursor: pointer; }
  .view-button.is-active { color: white; background: var(--ink); }
  .filter-toggle { min-height: 2.75rem; display: inline-flex; align-items: center; justify-content: center; gap: .45rem; border: 1px solid var(--line); border-radius: 999px; padding: .55rem .9rem; color: var(--ink); background: var(--card); font: inherit; font-weight: 800; cursor: pointer; }
  .filter-toggle:hover, .filter-toggle:focus-visible { border-color: var(--accent-dark); }
  .filter-count { min-width: 1.35rem; padding: .05rem .35rem; border-radius: 999px; color: white; background: var(--accent-dark); font-size: .72rem; line-height: 1.2; text-align: center; }
  .active-filter-row { display: flex; align-items: center; gap: .6rem; margin-top: .55rem; }
  .active-filter-row[hidden] { display: none; }
  .active-filter-chips { display: flex; gap: .4rem; overflow-x: auto; scrollbar-width: thin; flex: 1; padding-bottom: .1rem; }
  :global(.active-filter-chip) { flex: 0 0 auto; display: inline-flex; align-items: center; gap: .35rem; border: 1px solid var(--line); border-radius: 999px; padding: .28rem .6rem; color: var(--ink); background: var(--card); font: inherit; font-size: .82rem; font-weight: 750; cursor: pointer; }
  :global(.active-filter-chip:hover), :global(.active-filter-chip:focus-visible) { border-color: var(--accent-dark); }
  .clear-filters { border: 0; color: var(--accent-dark); background: transparent; font: inherit; font-size: .86rem; font-weight: 800; cursor: pointer; white-space: nowrap; }
  .clear-filters:hover, .clear-filters:focus-visible { text-decoration: underline; }
  .catalogue-summary-row { display: flex; justify-content: space-between; align-items: center; }
  .results-summary { margin: .5rem 0 0; color: var(--muted); font-size: .86rem; }
  .filter-panel { position: absolute; right: 0; top: calc(100% + .45rem); width: min(52rem,100%); max-height: min(72vh,42rem); display: grid; grid-template-rows: auto minmax(0,1fr) auto; border: 1px solid var(--line); border-radius: .9rem; background: var(--card); box-shadow: 0 1.2rem 3rem color-mix(in srgb, var(--ink) 18%, transparent); overflow: hidden; }
  .filter-panel[hidden] { display: none; }
  .filter-panel-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; padding: 1rem 1rem .8rem; border-bottom: 1px solid var(--line); }
  .filter-label, .group-label { margin: 0; font-weight: 850; }
  .filter-help { margin: .12rem 0 0; color: var(--muted); font-size: .88rem; }
  .filter-close { width: 2.1rem; height: 2.1rem; border: 0; border-radius: 999px; color: var(--ink); background: var(--paper); font: inherit; font-size: 1.35rem; line-height: 1; cursor: pointer; }
  .filter-panel-scroll { overflow: auto; padding: 1rem; }
  .filter-groups { display: grid; gap: 1.2rem; }
  .group-label { font-size: .78rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
