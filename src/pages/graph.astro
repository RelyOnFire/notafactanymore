---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import KnowledgeGraph from '../components/KnowledgeGraph.astro';
import { buildKnowledgeGraph } from '../lib/knowledgeGraph';

const entries = await getCollection('entries');
const glossaryEntries = await getCollection('glossary');
const data = buildKnowledgeGraph({ entries, glossaryEntries, locale: 'en' });
---

<BaseLayout
  title="Knowledge Map"
  description="Explore how corrected scientific claims connect through fields and shared concepts across Not a Fact Anymore."
  locale="en"
  alternatePath="/de/graph/"
>
  <KnowledgeGraph data={data} locale="en" />
</BaseLayout>
