---
import type { SiteLocale } from '../lib/i18n';

interface Props {
  id: string;
  context: string;
  kind?: 'note' | 'source' | 'episode' | 'section';
  locale?: SiteLocale;
}

const { id, context, kind = 'note', locale = 'en' } = Astro.props;
const labels = locale === 'de' ? {
  note: 'Link zur Erläuterung',
  source: 'Link zum Quelleneintrag',
  episode: 'Link zur Episode',
  section: 'Link zum Abschnitt',
  copy: 'Link kopieren',
  copied: 'Kopiert',
  success: 'Link kopiert.',
  failure: 'Kopieren fehlgeschlagen. Öffne den Link und kopiere die Seitenadresse.',
} : {
  note: 'Link to this note',
  source: 'Link to this source entry',
  episode: 'Link to this episode',
  section: 'Link to this section',
  copy: 'Copy link',
  copied: 'Copied',
  success: 'Link copied.',
  failure: 'Could not copy. Open the link and copy the page address.',
};
const url = new URL(Astro.url.pathname, Astro.site ?? 'https://notafactanymore.com');
url.hash = id;
---
<div class="permalink-actions">
  <a class="permalink-link" href={`#${encodeURIComponent(id)}`} aria-label={`${labels[kind]}: ${context}`}>{labels[kind]}</a>
  <button
    class="permalink-copy" type="button" hidden
    aria-label={`${labels.copy}: ${context}`}
    data-url={url.toString()}
    data-copy-label={labels.copy}
    data-copied-label={labels.copied}
    data-success={labels.success}
    data-failure={labels.failure}
  >{labels.copy}</button>
  <span class="permalink-status" role="status" aria-live="polite" aria-atomic="true"></span>
</div>

<script>
  if (typeof navigator.clipboard?.writeText === 'function') {
    for (const button of document.querySelectorAll<HTMLButtonElement>('.permalink-copy')) {
      button.hidden = false;
      let timer: number | undefined;
      button.addEventListener('click', async () => {
        const status = button.parentElement?.querySelector<HTMLElement>('.permalink-status');
        if (status) status.textContent = '';
        try {
          await navigator.clipboard.writeText(button.dataset.url!);
          button.textContent = button.dataset.copiedLabel!;
          if (status) status.textContent = button.dataset.success!;
          if (timer) window.clearTimeout(timer);
          timer = window.setTimeout(() => { button.textContent = button.dataset.copyLabel!; }, 1800);
        } catch {
          if (timer) window.clearTimeout(timer);
          button.textContent = button.dataset.copyLabel!;
          if (status) status.textContent = button.dataset.failure!;
        }
      });
    }
  }

  // Preserve a selected citation when its case has a matching language counterpart.
  const languageLink = document.querySelector<HTMLAnchorElement>('.language-switch');
  const languageHref = languageLink?.href;
  languageLink?.addEventListener('click', () => {
    const destination = new URL(languageHref!);
    const withoutLocale = (path: string) => path.replace(/^\/de(?=\/|$)/, '').replace(/\/+$/, '') || '/';
    const hasPermalink = Array.from(document.querySelectorAll<HTMLAnchorElement>('.permalink-link'))
      .some(link => link.hash === window.location.hash);
    if (window.location.hash && hasPermalink && withoutLocale(destination.pathname) === withoutLocale(window.location.pathname)) {
      destination.hash = window.location.hash;
    }
    languageLink.href = destination.toString();
  });
</script>

<style>
  .permalink-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem .75rem; margin-top: .8rem; font-size: .78rem; }
  .permalink-link { color: var(--accent-dark); font-weight: 700; text-underline-offset: .2em; }
  .permalink-copy { border: 1px solid var(--line); border-radius: .3rem; padding: .3rem .55rem; min-height: 2rem; color: var(--accent-dark); background: var(--card); font: inherit; font-weight: 750; cursor: pointer; }
  .permalink-copy:hover { border-color: var(--accent-dark); }
  .permalink-copy[hidden] { display: none; }
  .permalink-status:empty { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .permalink-status { flex-basis: 100%; color: var(--muted); overflow-wrap: anywhere; }
  @media print { .permalink-actions { display: none; } }
</style>
