---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { centuryNumber, lifespanYears, median } from '../../lib/lifespans';
import {
  categoryLabel,
  formatApproxYearsLocalized,
  statusLabel,
  translationMatchesEntry,
} from '../../lib/i18n';

const entries = await getCollection('entries');
const translations = await getCollection(
  'entryTranslations',
  (translation) => translation.data.locale === 'de',
);

const items = translations
  .map((translation) => {
    const entry = entries.find((candidate) => candidate.id === translation.data.entryId);
    return entry && translationMatchesEntry(entry, translation) ? { entry, translation } : null;
  })
  .filter((item): item is NonNullable<typeof item> => Boolean(item));

const comparableItems = items.filter(({ entry }) => entry.data.lifespanComparable !== false);
const nonComparableItems = items.filter(({ entry }) => entry.data.lifespanComparable === false);

const records = comparableItems.map(({ entry, translation }) => ({
  entry,
  translation,
  acceptedYear: entry.data.acceptedYear,
  changedYear: entry.data.timelineYear,
  lifespan: lifespanYears(entry.data.acceptedYear, entry.data.timelineYear),
}));

const byShortest = [...records].sort((a, b) =>
  a.lifespan - b.lifespan ||
  a.changedYear - b.changedYear ||
  a.translation.data.claim.localeCompare(b.translation.data.claim, 'de', { sensitivity: 'base' })
);
const byLongest = [...records].sort((a, b) =>
  b.lifespan - a.lifespan ||
  b.changedYear - a.changedYear ||
  a.translation.data.claim.localeCompare(b.translation.data.claim, 'de', { sensitivity: 'base' })
);

const shortest = byShortest.slice(0, 5);
const longest = byLongest.slice(0, 5);
const overallMedian = median(records.map((record) => record.lifespan));

const categories = [...new Set(comparableItems.map(({ entry }) => entry.data.category))]
  .sort((a, b) => categoryLabel(a, 'de').localeCompare(categoryLabel(b, 'de'), 'de'));
const statuses = [...new Set(comparableItems.map(({ entry }) => entry.data.status))]
  .sort((a, b) => statusLabel(a, 'de').localeCompare(statusLabel(b, 'de'), 'de'));

const categoryStats = categories
  .map((category) => {
    const values = records
      .filter((record) => record.entry.data.category === category)
      .map((record) => record.lifespan)
      .sort((a, b) => a - b);
    return {
      category,
      label: categoryLabel(category, 'de'),
      count: values.length,
      median: median(values),
      min: values[0] ?? 0,
      max: values.at(-1) ?? 0,
    };
  })
  .sort((a, b) => a.median - b.median || a.label.localeCompare(b.label, 'de'));

const comparisonCategoryStats = [...categoryStats].sort((a, b) => a.label.localeCompare(b.label, 'de'));

const lifespanBands = [
  { key: 'under25', label: '<25 Jahre', test: (years: number) => years < 25 },
  { key: '25to49', label: '25–49 Jahre', test: (years: number) => years >= 25 && years < 50 },
  { key: '50to99', label: '50–99 Jahre', test: (years: number) => years >= 50 && years < 100 },
  { key: '100to249', label: '100–249 Jahre', test: (years: number) => years >= 100 && years < 250 },
  { key: '250plus', label: '250+ Jahre', test: (years: number) => years >= 250 },
];

const centuries = [...new Set(records.map((record) => centuryNumber(record.changedYear)))]
  .filter((century) => century > 0)
  .sort((a, b) => a - b);

const centuryStats = centuries.map((century) => {
  const group = records.filter((record) => centuryNumber(record.changedYear) === century);
  return {
    century,
    label: `${century}. Jahrhundert`,
    count: group.length,
    median: median(group.map((record) => record.lifespan)),
    bands: lifespanBands.map((band) => ({ ...band, count: group.filter((record) => band.test(record.lifespan)).length })),
  };
});

const defaultComparisonA = categoryStats.find((item) => item.category === 'Medicine') ?? categoryStats[0];
const defaultComparisonB = categoryStats.find((item) => item.category === 'Astronomy') ?? categoryStats.find((item) => item.category !== defaultComparisonA?.category);
const comparisonReady = Boolean(defaultComparisonA && defaultComparisonB);

const formatCategoryDetail = (item: (typeof categoryStats)[number]) => item.count === 1
  ? '1 Eintrag · beobachtete Spannweite nicht ausgewiesen'
  : `${item.count} Einträge · Spannweite ${formatApproxYearsLocalized(item.min, 'de')} bis ${formatApproxYearsLocalized(item.max, 'de')}`;

const initialComparisonResult = defaultComparisonA && defaultComparisonB
  ? defaultComparisonA.median === defaultComparisonB.median
    ? 'Die Mediane sind in diesem Katalog gleich.'
    : `${defaultComparisonA.median < defaultComparisonB.median ? defaultComparisonA.label : defaultComparisonB.label} ist in diesem Katalog im Median um ${formatApproxYearsLocalized(Math.abs(defaultComparisonA.median - defaultComparisonB.median), 'de')} kürzer.`
  : '';

const formatHistoricalYearDe = (year: number) => year < 0 ? `${Math.abs(year)} v. Chr.` : String(year);
const DISPLAY_CAP = 250;
---
<BaseLayout
  locale="de"
  title="Lebensdauer"
  description="Erkunde, wie lange ehemals akzeptierte wissenschaftliche und historische Aussagen ungefähr Bestand hatten, bevor sie korrigiert, eingeschränkt, neu eingeordnet oder abgelöst wurden."
  alternatePath="/lifespans"
>
  <header class="page-head container">
    <p class="eyebrow">Wie lange hielt eine Tatsache?</p>
    <h1>Lebensdauer akzeptierter Aussagen</h1>
    <p>
      Vergleiche den ungefähren Zeitraum zwischen der Etablierung einer Aussage und dem
      repräsentativen Zeitpunkt, an dem stärkere Evidenz den Wissensstand veränderte.
    </p>
  </header>

  <section class="container stats-grid" aria-label="Zusammenfassung der Lebensdauern">
    <article>
      <span>Median des Katalogs</span>
      <strong>{formatApproxYearsLocalized(overallMedian, 'de')}</strong>
      <small>Über {records.length} quantitativ vergleichbare Einträge</small>
    </article>
    <article>
      <span>Kürzeste Dauer</span>
      <strong>{formatApproxYearsLocalized(shortest[0]?.lifespan ?? 0, 'de')}</strong>
      <small>{shortest[0]?.translation.data.claim}</small>
    </article>
    <article>
      <span>Längste Dauer</span>
      <strong>{formatApproxYearsLocalized(longest[0]?.lifespan ?? 0, 'de')}</strong>
      <small>{longest[0]?.translation.data.claim}</small>
    </article>
    <article>
      <span>Kategorien mit Messwerten</span>
      <strong>{categoryStats.length}</strong>
      <small>Deskriptiv für diesen Katalog</small>
    </article>
  </section>

  <section class="container methodology-note">
    <p>
      <strong>Diese Zeitspannen sind Näherungswerte.</strong> Jeder quantitativ vergleichbare Eintrag
      behält seine lesbaren historischen Zeiträume; <code>acceptedYear</code> und <code>timelineYear</code>
      dienen nur als repräsentative Anker für Sortierung und Vergleich. Ein Fachgebiet oder Unterricht
      kann eine ältere Auffassung noch verwenden, nachdem gegenteilige Evidenz erschienen ist. Die Zahlen
      sind daher keine exakten Zeitpunkte eines universellen Konsenses. {nonComparableItems.length} Einträge
      sind bewusst von den Lebensdauerstatistiken ausgeschlossen, weil ihre Akzeptanzgrenze zu diffus ist,
      die historische Formulierung konkurrierende Traditionen umfasst oder eine einzelne Zahl falsche
      Präzision erzeugen würde. Vergleiche zwischen Kategorien beschreiben diesen kuratierten Katalog und
      keine allgemeinen Änderungsraten ganzer Wissenschaftsgebiete.
    </p>
  </section>

  <section class="container extremes">
    <div class="section-heading">
      <div><p class="eyebrow">Die Extreme</p><h2>Kürzeste und längste Lebensdauer</h2></div>
    </div>
    <div class="extreme-columns">
      <section>
        <h3>Am kürzesten</h3>
        <ol class="ranked-list">
          {shortest.map((record) => (
            <li>
              <a href={`/de/entries/${record.entry.id}/`}>
                <strong>{record.translation.data.claim}</strong>
                <span>{formatHistoricalYearDe(record.acceptedYear)} → {formatHistoricalYearDe(record.changedYear)} · {categoryLabel(record.entry.data.category, 'de')}</span>
              </a>
              <span class="duration-badge">{formatApproxYearsLocalized(record.lifespan, 'de')}</span>
            </li>
          ))}
        </ol>
      </section>
      <section>
        <h3>Am längsten</h3>
        <ol class="ranked-list">
          {longest.map((record) => (
            <li>
              <a href={`/de/entries/${record.entry.id}/`}>
                <strong>{record.translation.data.claim}</strong>
                <span>{formatHistoricalYearDe(record.acceptedYear)} → {formatHistoricalYearDe(record.changedYear)} · {categoryLabel(record.entry.data.category, 'de')}</span>
              </a>
              <span class="duration-badge">{formatApproxYearsLocalized(record.lifespan, 'de')}</span>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </section>

  {comparisonReady && defaultComparisonA && defaultComparisonB && (
    <section class="comparison-section">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Kategorien vergleichen</p>
            <h2 class="comparison-heading">{defaultComparisonA.label} vs. {defaultComparisonB.label}</h2>
            <p class="section-intro">Wähle zwei Fachgebiete und vergleiche ihre Einträge in diesem Katalog.</p>
          </div>
        </div>

        <div class="comparison-controls" aria-label="Steuerung des Kategorienvergleichs">
          <label>
            <span>Erste Kategorie</span>
            <select class="comparison-select comparison-select-a">
              {comparisonCategoryStats.map((item) => (
                <option value={item.category} selected={item.category === defaultComparisonA.category} data-label={item.label} data-count={item.count} data-median={item.median} data-min={item.min} data-max={item.max}>{item.label}</option>
              ))}
            </select>
          </label>
          <label>
            <span>Zweite Kategorie</span>
            <select class="comparison-select comparison-select-b">
              {comparisonCategoryStats.map((item) => (
                <option value={item.category} selected={item.category === defaultComparisonB.category} data-label={item.label} data-count={item.count} data-median={item.median} data-min={item.min} data-max={item.max}>{item.label}</option>
              ))}
            </select>
          </label>
        </div>

        <div class="comparison-grid">
          <article class="comparison-card-a">
            <span class="comparison-category">{defaultComparisonA.label}</span>
            <strong class="comparison-median">{formatApproxYearsLocalized(defaultComparisonA.median, 'de')}</strong>
            <small class="comparison-detail">{formatCategoryDetail(defaultComparisonA)}</small>
          </article>
          <article class="comparison-card-b">
            <span class="comparison-category">{defaultComparisonB.label}</span>
            <strong class="comparison-median">{formatApproxYearsLocalized(defaultComparisonB.median, 'de')}</strong>
            <small class="comparison-detail">{formatCategoryDetail(defaultComparisonB)}</small>
          </article>
        </div>
        <p class="comparison-result" aria-live="polite">{initialComparisonResult}</p>
      </div>
    </section>
  )}

  <section class="container category-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Nach Fachgebiet</p>
        <h2>Median der Lebensdauer nach Kategorie</h2>
        <p class="section-intro">Sortiert vom kürzesten zum längsten Median. Kleine Kategorien können sich durch einen einzigen neuen Eintrag deutlich verschieben; deshalb wird die Zahl der Einträge mit angezeigt.</p>
      </div>
    </div>
    <div class="table-wrap">
      <table>
        <thead><tr><th scope="col">Kategorie</th><th scope="col">Einträge</th><th scope="col">Median</th><th scope="col">Beobachtete Spannweite</th></tr></thead>
        <tbody>
          {categoryStats.map((item) => (
            <tr>
              <th scope="row">{item.label}</th>
              <td>{item.count}</td>
              <td>{formatApproxYearsLocalized(item.median, 'de')}</td>
              <td>{item.count === 1 ? <span class="range-unavailable" title="Eine Spannweite erfordert mindestens zwei Einträge" aria-label="Beobachtete Spannweite nicht verfügbar">—</span> : <>{formatApproxYearsLocalized(item.min, 'de')} – {formatApproxYearsLocalized(item.max, 'de')}</>}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="century-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Im Zeitverlauf</p>
          <h2>Verteilung der Lebensdauern nach Jahrhundert der Änderung</h2>
          <p class="section-intro">Jede Zeile gruppiert Einträge nach dem Jahrhundert ihres repräsentativen Änderungsjahres und zeigt, wie sich ihre Lebensdauern verteilen.</p>
        </div>
      </div>
      <div class="band-legend" aria-label="Lebensdauerbereiche">
        {lifespanBands.map((band) => <span><i class={`legend-swatch band-${band.key}`} aria-hidden="true"></i>{band.label}</span>)}
      </div>
      <div class="century-list">
        {centuryStats.map((item) => (
          <article class="century-row">
            <div class="century-meta">
              <strong>{item.label}</strong>
              <span>{item.count} {item.count === 1 ? 'Eintrag' : 'Einträge'} · Median {formatApproxYearsLocalized(item.median, 'de')}</span>
            </div>
            <div class="distribution-bar" aria-label={`Verteilung der Lebensdauern im ${item.label}`}>
              {item.bands.map((band) => band.count > 0 && (
                <span class={`distribution-segment band-${band.key}`} style={`width: ${(band.count / item.count) * 100}%`} title={`${band.label}: ${band.count}`}></span>
              ))}
            </div>
            <div class="century-counts">
              {item.bands.filter((band) => band.count > 0).map((band) => <span>{band.label}: <strong>{band.count}</strong></span>)}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  {nonComparableItems.length > 0 && (
    <section class="container noncomparable-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Nicht in den Ranglisten</p>
          <h2>Einträge ohne quantitative Lebensdauer</h2>
          <p class="section-intro">Diese Einträge bleiben Teil des Katalogs, aber ihre Akzeptanzgrenze ist zu diffus, umstritten oder historisch gemischt für eine vertretbare einzelne Lebensdauer.</p>
        </div>
      </div>
      <div class="noncomparable-list">
        {nonComparableItems
          .sort((a, b) => a.translation.data.claim.localeCompare(b.translation.data.claim, 'de'))
          .map(({ entry, translation }) => (
            <a href={`/de/entries/${entry.id}/`}>
              <strong>{translation.data.claim}</strong>
              <span>{translation.data.acceptedApproximately} → {translation.data.changedApproximately}</span>
            </a>
          ))}
      </div>
    </section>
  )}

  <section class="container explorer">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Alle Lebensdauern erkunden</p>
        <h2>Akzeptanz → Änderung</h2>
        <p class="section-intro">Durchsuche den Katalog und sortiere von den kürzesten zu den längsten Lebensdauern. Die Balkenlänge stellt die Dauer dar und wird bei {DISPLAY_CAP} Jahren gedeckelt, damit moderne kurzlebige Aussagen sichtbar bleiben; Datumsangaben und Dauer zeigen immer die vollständige ungefähre Spanne.</p>
      </div>
    </div>

    <div class="lifespan-controls" aria-label="Steuerung des Lebensdauer-Explorers">
      <label><span class="sr-only">Aussagen durchsuchen</span><input class="lifespan-search" type="search" placeholder="Aussagen durchsuchen…" autocomplete="off" /></label>
      <label><span class="sr-only">Nach Kategorie filtern</span><select class="category-select"><option value="">Alle Kategorien</option>{categories.map((category) => <option value={category}>{categoryLabel(category, 'de')}</option>)}</select></label>
      <label><span class="sr-only">Nach Status filtern</span><select class="status-select"><option value="">Alle Status</option>{statuses.map((status) => <option value={status}>{statusLabel(status, 'de')}</option>)}</select></label>
      <label><span class="sr-only">Lebensdauern sortieren</span><select class="lifespan-sort"><option value="shortest">Kürzeste zuerst</option><option value="longest">Längste zuerst</option><option value="newest">Neueste Änderung zuerst</option><option value="oldest">Älteste Änderung zuerst</option></select></label>
    </div>

    <p class="lifespan-results" aria-live="polite">Alle {records.length} Einträge werden angezeigt</p>

    <div class="lifespan-list">
      {byShortest.map((record) => {
        const displayWidth = Math.max(4, Math.min(record.lifespan, DISPLAY_CAP) / DISPLAY_CAP * 100);
        return (
          <article
            class="lifespan-entry"
            data-entry-id={record.entry.id}
            data-category={record.entry.data.category}
            data-status={record.entry.data.status}
            data-lifespan={record.lifespan}
            data-accepted-year={record.acceptedYear}
            data-changed-year={record.changedYear}
            data-claim={record.translation.data.claim}
            data-search={`${record.translation.data.claim} ${categoryLabel(record.entry.data.category, 'de')} ${statusLabel(record.entry.data.status, 'de')} ${record.translation.data.summary} ${record.translation.data.acceptedApproximately} ${record.translation.data.changedApproximately}`.toLocaleLowerCase('de')}
          >
            <div class="entry-copy">
              <h3><a href={`/de/entries/${record.entry.id}/`}>{record.translation.data.claim}</a></h3>
              <p>{categoryLabel(record.entry.data.category, 'de')} · {statusLabel(record.entry.data.status, 'de')}</p>
            </div>
            <div class="lifespan-visual">
              <div class="range-label">
                <span><strong>{formatHistoricalYearDe(record.acceptedYear)}</strong><small>akzeptiert</small></span>
                <span aria-hidden="true">→</span>
                <span><strong>{formatHistoricalYearDe(record.changedYear)}</strong><small>geändert</small></span>
              </div>
              <div class="range-track" aria-hidden="true">
                <span class:list={['range-fill', { capped: record.lifespan > DISPLAY_CAP }]} style={`--span-width: ${displayWidth}%`}><i class="start-dot"></i><i class="end-dot"></i></span>
              </div>
              <span class="duration-badge">{formatApproxYearsLocalized(record.lifespan, 'de')}</span>
            </div>
          </article>
        );
      })}
    </div>

    <p class="lifespan-empty" hidden>Keine Einträge entsprechen diesen Filtern.</p>
    <noscript><p class="noscript-note">Suche, Filter und Sortierung benötigen JavaScript. Ohne JavaScript werden die Einträge mit der kürzesten Lebensdauer zuerst angezeigt.</p></noscript>
  </section>

  <script>
    const comparisonSelectA = document.querySelector<HTMLSelectElement>('.comparison-select-a');
    const comparisonSelectB = document.querySelector<HTMLSelectElement>('.comparison-select-b');
    const comparisonHeading = document.querySelector<HTMLElement>('.comparison-heading');
    const comparisonCardA = document.querySelector<HTMLElement>('.comparison-card-a');
    const comparisonCardB = document.querySelector<HTMLElement>('.comparison-card-b');
    const comparisonResult = document.querySelector<HTMLElement>('.comparison-result');

    type ComparisonStat = { category: string; label: string; count: number; median: number; min: number; max: number; };
    const formatApproxYearsClient = (years: number) => {
      const rounded = Number.isInteger(years) ? years : Math.round(years * 10) / 10;
      return `≈${rounded.toLocaleString('de-AT')} ${rounded === 1 ? 'Jahr' : 'Jahre'}`;
    };
    const getComparisonStat = (select: HTMLSelectElement): ComparisonStat | null => {
      const option = select.options[select.selectedIndex];
      if (!option) return null;
      return {
        category: option.value,
        label: option.dataset.label ?? option.textContent ?? option.value,
        count: Number(option.dataset.count ?? 0),
        median: Number(option.dataset.median ?? 0),
        min: Number(option.dataset.min ?? 0),
        max: Number(option.dataset.max ?? 0),
      };
    };
    const formatComparisonDetail = (stat: ComparisonStat) => stat.count === 1
      ? '1 Eintrag · beobachtete Spannweite nicht ausgewiesen'
      : `${stat.count} Einträge · Spannweite ${formatApproxYearsClient(stat.min)} bis ${formatApproxYearsClient(stat.max)}`;
    const updateComparisonCard = (card: HTMLElement | null, stat: ComparisonStat) => {
      if (!card) return;
      const category = card.querySelector<HTMLElement>('.comparison-category');
      const medianValue = card.querySelector<HTMLElement>('.comparison-median');
      const detail = card.querySelector<HTMLElement>('.comparison-detail');
      if (category) category.textContent = stat.label;
      if (medianValue) medianValue.textContent = formatApproxYearsClient(stat.median);
      if (detail) detail.textContent = formatComparisonDetail(stat);
    };
    const keepComparisonDistinct = (changed: HTMLSelectElement, other: HTMLSelectElement) => {
      if (changed.value !== other.value) return;
      const replacement = [...other.options].find((option) => option.value !== changed.value);
      if (replacement) other.value = replacement.value;
    };
    const updateComparison = () => {
      if (!comparisonSelectA || !comparisonSelectB) return;
      const statA = getComparisonStat(comparisonSelectA);
      const statB = getComparisonStat(comparisonSelectB);
      if (!statA || !statB) return;
      if (comparisonHeading) comparisonHeading.textContent = `${statA.label} vs. ${statB.label}`;
      updateComparisonCard(comparisonCardA, statA);
      updateComparisonCard(comparisonCardB, statB);
      if (comparisonResult) {
        if (statA.median === statB.median) comparisonResult.textContent = 'Die Mediane sind in diesem Katalog gleich.';
        else {
          const shorter = statA.median < statB.median ? statA : statB;
          const difference = Math.abs(statA.median - statB.median);
          comparisonResult.textContent = `${shorter.label} ist in diesem Katalog im Median um ${formatApproxYearsClient(difference)} kürzer.`;
        }
      }
    };
    comparisonSelectA?.addEventListener('change', () => { if (comparisonSelectB) keepComparisonDistinct(comparisonSelectA, comparisonSelectB); updateComparison(); });
    comparisonSelectB?.addEventListener('change', () => { if (comparisonSelectA) keepComparisonDistinct(comparisonSelectB, comparisonSelectA); updateComparison(); });

    const searchInput = document.querySelector<HTMLInputElement>('.lifespan-search');
    const categorySelect = document.querySelector<HTMLSelectElement>('.category-select');
    const statusSelect = document.querySelector<HTMLSelectElement>('.status-select');
    const sortSelect = document.querySelector<HTMLSelectElement>('.lifespan-sort');
    const list = document.querySelector<HTMLElement>('.lifespan-list');
    const results = document.querySelector<HTMLElement>('.lifespan-results');
    const emptyState = document.querySelector<HTMLElement>('.lifespan-empty');
    const rows = Array.from(document.querySelectorAll<HTMLElement>('.lifespan-entry'));
    type LifespanSort = 'shortest' | 'longest' | 'newest' | 'oldest';
    let currentSort: LifespanSort = 'shortest';

    const compareRows = (a: HTMLElement, b: HTMLElement) => {
      const lifespanA = Number(a.dataset.lifespan ?? 0);
      const lifespanB = Number(b.dataset.lifespan ?? 0);
      const changedA = Number(a.dataset.changedYear ?? 0);
      const changedB = Number(b.dataset.changedYear ?? 0);
      const claimA = a.dataset.claim ?? '';
      const claimB = b.dataset.claim ?? '';
      const claimCompare = () => claimA.localeCompare(claimB, 'de', { sensitivity: 'base' });
      if (currentSort === 'longest') return lifespanB - lifespanA || changedB - changedA || claimCompare();
      if (currentSort === 'newest') return changedB - changedA || lifespanA - lifespanB || claimCompare();
      if (currentSort === 'oldest') return changedA - changedB || lifespanA - lifespanB || claimCompare();
      return lifespanA - lifespanB || changedA - changedB || claimCompare();
    };

    const updateURL = () => {
      const url = new URL(window.location.href);
      const query = searchInput?.value.trim() ?? '';
      const category = categorySelect?.value ?? '';
      const status = statusSelect?.value ?? '';
      query ? url.searchParams.set('q', query) : url.searchParams.delete('q');
      category ? url.searchParams.set('category', category) : url.searchParams.delete('category');
      status ? url.searchParams.set('status', status) : url.searchParams.delete('status');
      currentSort !== 'shortest' ? url.searchParams.set('sort', currentSort) : url.searchParams.delete('sort');
      window.history.replaceState({}, '', url);
    };

    const updateDisplay = () => {
      const query = searchInput?.value.trim().toLocaleLowerCase('de') ?? '';
      const category = categorySelect?.value ?? '';
      const status = statusSelect?.value ?? '';
      let visible = 0;
      rows.sort(compareRows).forEach((row) => {
        const show = (!query || (row.dataset.search ?? '').includes(query)) && (!category || row.dataset.category === category) && (!status || row.dataset.status === status);
        row.hidden = !show;
        list?.append(row);
        if (show) visible += 1;
      });
      if (results) {
        const filtered = query || category || status;
        results.textContent = filtered
          ? `${visible} von ${rows.length} ${visible === 1 ? 'Eintrag' : 'Einträgen'} werden angezeigt`
          : `Alle ${rows.length} Einträge werden angezeigt`;
      }
      if (emptyState) emptyState.hidden = visible !== 0;
      updateURL();
    };

    const url = new URL(window.location.href);
    const requestedSort = url.searchParams.get('sort');
    if (requestedSort === 'longest' || requestedSort === 'newest' || requestedSort === 'oldest') currentSort = requestedSort;
    if (searchInput) searchInput.value = url.searchParams.get('q') ?? '';
    const requestedCategory = url.searchParams.get('category') ?? '';
    if (categorySelect && [...categorySelect.options].some((option) => option.value === requestedCategory)) categorySelect.value = requestedCategory;
    const requestedStatus = url.searchParams.get('status') ?? '';
    if (statusSelect && [...statusSelect.options].some((option) => option.value === requestedStatus)) statusSelect.value = requestedStatus;
    if (sortSelect) sortSelect.value = currentSort;
    searchInput?.addEventListener('input', updateDisplay);
    categorySelect?.addEventListener('change', updateDisplay);
    statusSelect?.addEventListener('change', updateDisplay);
    sortSelect?.addEventListener('change', () => {
      const value = sortSelect.value;
      if (value === 'shortest' || value === 'longest' || value === 'newest' || value === 'oldest') { currentSort = value; updateDisplay(); }
    });
    updateDisplay();
  </script>
</BaseLayout>

