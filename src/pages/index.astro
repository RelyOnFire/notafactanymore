---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CompactClaim from '../components/CompactClaim.astro';
import FactCard from '../components/FactCard.astro';

const entries = await getCollection('entries');
const featured = entries
  .filter((entry) => entry.data.featured)
  .sort((a, b) => (a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999));
const claimCollator = new Intl.Collator('en', {
  sensitivity: 'base',
  numeric: true,
});

const claimSortKey = (claim: string) => {
  let key = claim.trim();

  // Sort by the meaningful subject rather than sentence framing.
  // Apply repeatedly so claims such as “All the …” lose both openers.
  const leadingWords = /^(?:a|an|all|every|most|the|there)(?:\s+|\b)\s*/i;
  let previous = '';

  while (key !== previous) {
    previous = key;
    key = key.replace(leadingWords, '');
  }

  return key.replace(/^[^\p{L}\p{N}]+/u, '').trim() || claim.trim();
};

const compareBySubject = (a: (typeof entries)[number], b: (typeof entries)[number]) => {
  const bySubject = claimCollator.compare(
    claimSortKey(a.data.claim),
    claimSortKey(b.data.claim),
  );

  return bySubject || claimCollator.compare(a.data.claim, b.data.claim);
};

const compareByRecencyThenSubject = (
  a: (typeof entries)[number],
  b: (typeof entries)[number],
) => {
  const byDate = b.data.publishedAt.getTime() - a.data.publishedAt.getTime();
  return byDate || compareBySubject(a, b);
};

const PREVIEW_SIZE = 12;
const RECENT_POOL_SIZE = 60;
const MAX_PER_CATEGORY = 2;

const recentPool = [...entries]
  .sort(compareByRecencyThenSubject)
  .slice(0, RECENT_POOL_SIZE);

const categoryQueues = new Map<string, typeof recentPool>();

for (const entry of recentPool) {
  const queue = categoryQueues.get(entry.data.category) ?? [];
  queue.push(entry);
  categoryQueues.set(entry.data.category, queue);
}

const categoryOrder = [...categoryQueues.keys()].sort((a, b) => {
  const newestA = categoryQueues.get(a)?.[0];
  const newestB = categoryQueues.get(b)?.[0];

  if (newestA && newestB) {
    const byDate =
      newestB.data.publishedAt.getTime() - newestA.data.publishedAt.getTime();

    if (byDate !== 0) {
      return byDate;
    }
  }

  return claimCollator.compare(a, b);
});

const diverseRecent: typeof recentPool = [];

for (let round = 0; round < MAX_PER_CATEGORY && diverseRecent.length < PREVIEW_SIZE; round += 1) {
  for (const category of categoryOrder) {
    const entry = categoryQueues.get(category)?.[round];

    if (entry) {
      diverseRecent.push(entry);
    }

    if (diverseRecent.length >= PREVIEW_SIZE) {
      break;
    }
  }
}

if (diverseRecent.length < PREVIEW_SIZE) {
  const selectedIds = new Set(diverseRecent.map((entry) => entry.id));

  for (const entry of recentPool) {
    if (!selectedIds.has(entry.id)) {
      diverseRecent.push(entry);
      selectedIds.add(entry.id);
    }

    if (diverseRecent.length >= PREVIEW_SIZE) {
      break;
    }
  }
}

const recent = diverseRecent.sort(compareBySubject);
---
<BaseLayout>
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow">Facts have a history.</p>
      <h1>Knowledge changes.<br />The record should too.</h1>
      <p class="intro">A catalogue of claims that were once reasonably accepted as factual but were later overturned, replaced, narrowed, reclassified, or corrected by better evidence.</p>
    </div>

    <div class="hero-art" aria-hidden="true">
      <img
        src="/images/cat-oracle-hero-site-bg.webp"
        alt=""
        width="1200"
        height="800"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </div>

    <div class="actions">
      <a class="button" href="/browse">Browse the catalogue</a>
      <a class="button secondary" href="/submit">Submit a claim</a>
    </div>
  </section>

  <section class="principle">
    <div class="narrow">
      <p>This is not a collection of myths, failed predictions, or things somebody once said. Every entry must show that the previous claim was genuinely supported or treated as authoritative, and that the present understanding is backed by stronger evidence.</p>
      <strong>Being wrong is not the failure. Refusing to update is.</strong>
    </div>
  </section>

  <section class="container featured">
    <div class="section-heading">
      <div><p class="eyebrow">Featured entries</p><h2>Clear examples of knowledge updating</h2></div>
      <a href="/browse">View all entries →</a>
    </div>
    <div class="cards">
      {featured.map((entry) => <FactCard entry={entry} expanded />)}
    </div>
  </section>

  <section class="catalogue-preview">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">The growing catalogue</p>
          <h2>Explore all {entries.length} former facts</h2>
          <p class="section-intro">A varied sample of recently added entries across the catalogue. The full collection can be searched and filtered in either card or compact view.</p>
        </div>
        <a href="/browse?view=compact">Open compact index →</a>
      </div>
      <div class="compact-preview">
        {recent.map((entry) => <CompactClaim entry={entry} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(19rem, 0.92fr);
    grid-template-areas:
      "copy art"
      "actions art";
    align-items: center;
    column-gap: clamp(1.5rem, 4vw, 4.5rem);
    row-gap: 0;
    padding: clamp(3rem, 7vw, 6.5rem) 0;
  }

  .hero-copy {
    grid-area: copy;
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .hero h1 {
    margin: .3rem 0 1.5rem;
    max-width: 14ch;
  }

  .intro {
    font-size: clamp(1.1rem, 2.5vw, 1.45rem);
    color: var(--muted);
    max-width: 46rem;
  }

  .actions {
    grid-area: actions;
    display: flex;
    gap: .75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  .hero-art {
    grid-area: art;
    min-width: 0;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-art img {
    display: block;
    width: min(100%, 37rem);
    height: auto;
    object-fit: contain;
  }

  .principle {
    background: var(--ink);
    color: white;
    padding: 3.5rem 0;
  }

  .principle p {
    font-size: 1.2rem;
    color: #ddd7ca;
  }

  .principle strong {
    font-size: 1.35rem;
  }

  .featured {
    padding: 5rem 0;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .section-heading h2 {
    margin: .2rem 0 0;
  }

  .section-heading > a {
    flex: 0 0 auto;
    font-weight: 800;
    color: var(--accent-dark);
  }

  .section-intro {
    margin-bottom: 0;
    color: var(--muted);
  }

  .cards {
    display: grid;
    gap: 2rem;
  }

  .catalogue-preview {
    padding: 4.5rem 0 5rem;
    border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--card) 45%, transparent);
  }

  .compact-preview {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.55rem;
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      grid-template-areas:
        "copy"
        "art"
        "actions";
      gap: 1.25rem;
      padding-bottom: 3.5rem;
    }

    .hero-art img {
      width: min(100%, 34rem);
    }

    .actions {
      margin-top: 0;
    }
  }

  @media (max-width: 700px) {
    .section-heading {
      align-items: start;
      flex-direction: column;
    }

    .compact-preview {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .hero {
      padding-top: 2.5rem;
    }

    .hero-art img {
      width: min(110%, 30rem);
    }
  }
</style>
