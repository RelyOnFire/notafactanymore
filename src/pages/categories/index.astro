---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatHistoricalYear } from '../../lib/lifespans';

const entries = await getCollection('entries');

const subjects = [...new Set(entries.map((entry) => entry.data.category))]
  .map((category) => {
    const categoryEntries = entries.filter((entry) => entry.data.category === category);
    const sortedByChange = [...categoryEntries].sort(
      (a, b) =>
        b.data.timelineYear - a.data.timelineYear ||
        a.data.claim.localeCompare(b.data.claim, 'en', { sensitivity: 'base' }),
    );

    return {
      category,
      count: categoryEntries.length,
      oldestChange: Math.min(...categoryEntries.map((entry) => entry.data.timelineYear)),
      newestChange: Math.max(...categoryEntries.map((entry) => entry.data.timelineYear)),
      latest: sortedByChange[0],
    };
  })
  .sort((a, b) => a.category.localeCompare(b.category, 'en', { sensitivity: 'base' }));
---
<BaseLayout
  title="Subjects"
  description={`Browse ${entries.length} catalogue entries across ${subjects.length} scientific and scholarly subjects.`}
  alternatePath="/de/categories/"
>
  <header class="container page-head">
    <p class="eyebrow">Subjects</p>
    <h1>Browse by field</h1>
    <p class="page-intro">
      Start with a subject. Each field has its own chronology, status breakdown,
      lifespan summary, search, and sorting.
    </p>

    <p class="directory-summary">
      <strong>{subjects.length}</strong> subjects · <strong>{entries.length}</strong> entries
    </p>
  </header>

  <section class="subject-directory">
    <div class="container subject-grid">
      {subjects.map((subject) => (
        <a
          class="subject-row"
          href={`/categories/${encodeURIComponent(subject.category.toLowerCase())}/`}
        >
          <div class="subject-main">
            <h2>{subject.category}</h2>
            <p class="subject-range">
              {formatHistoricalYear(subject.oldestChange)}
              <span aria-hidden="true"> → </span>
              {formatHistoricalYear(subject.newestChange)}
            </p>
          </div>

          <div class="subject-count">
            <strong>{subject.count}</strong>
            <span>{subject.count === 1 ? 'entry' : 'entries'}</span>
          </div>

          {subject.latest && (
            <div class="subject-latest">
              <span>Latest change here</span>
              <strong>{subject.latest.data.claim}</strong>
            </div>
          )}

          <span class="subject-action">Open {subject.category} →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding: 5rem 0 4rem;
  }

  .page-head h1 {
    margin: 0.15rem 0 1rem;
    max-width: 10ch;
  }

  .page-intro {
    max-width: 54rem;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .directory-summary {
    margin: 1.6rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .directory-summary strong {
    color: var(--ink);
  }

  .subject-directory {
    padding: 1rem 0 5rem;
  }

  .subject-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2.5rem, 6vw, 5rem);
  }

  .subject-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "main count"
      "latest latest"
      "action action";
    min-width: 0;
    padding: 1.5rem 0 1.65rem;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }

  .subject-main { grid-area: main; min-width: 0; }

  .subject-row h2 {
    margin: 0;
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
  }

  .subject-range {
    margin: 0.45rem 0 0;
    color: var(--accent-dark);
    font-size: 0.82rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .subject-count {
    grid-area: count;
    align-self: start;
    padding-left: 1rem;
    text-align: right;
  }

  .subject-count strong {
    display: block;
    font-size: 1.8rem;
    line-height: 1;
  }

  .subject-count span {
    display: block;
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 750;
  }

  .subject-latest {
    grid-area: latest;
    margin-top: 1.15rem;
  }

  .subject-latest span {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .subject-latest strong {
    display: block;
    max-width: 34rem;
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .subject-action {
    grid-area: action;
    margin-top: 1rem;
    color: var(--accent-dark);
    font-size: 0.84rem;
    font-weight: 830;
  }

  .subject-row:hover h2,
  .subject-row:focus-visible h2 {
    color: var(--accent-dark);
  }

  @media (max-width: 760px) {
    .subject-grid {
      grid-template-columns: 1fr;
    }

    .page-head {
      padding-top: 3.5rem;
    }
  }
</style>
