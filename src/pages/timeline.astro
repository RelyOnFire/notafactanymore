---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entries = (await getCollection('entries')).sort((a, b) => {
  return (
    b.data.timelineYear - a.data.timelineYear ||
    a.data.claim.localeCompare(b.data.claim, 'en', { sensitivity: 'base' })
  );
});

const categories = [...new Set(entries.map((entry) => entry.data.category))].sort();
const statuses = [...new Set(entries.map((entry) => entry.data.status))].sort();

const decadeFor = (year: number) => Math.floor(year / 10) * 10;

const decades = [...new Set(entries.map((entry) => decadeFor(entry.data.timelineYear)))]
  .sort((a, b) => b - a);
---
<BaseLayout
  title="Timeline"
  description="Explore how accepted knowledge changed through time, from early modern science to recent decades."
>
  <header class="timeline-head container">
    <p class="eyebrow">The historical record</p>
    <h1>How knowledge changed</h1>
    <p class="timeline-intro">
      Explore the catalogue chronologically. The year shown is a representative
      anchor for sorting; the original approximate change period is preserved
      on each entry.
    </p>
  </header>

  <section class="school-context container" hidden>
    <div class="school-context-inner">
      <div>
        <p class="eyebrow">Your scientific timeline</p>
        <h2 class="school-context-title"></h2>
        <p class="school-context-copy">
          These entries changed from the year you started school onward. That
          does not necessarily mean you were taught the earlier view: scientific
          acceptance, textbooks, curricula, and classroom teaching do not
          always change at the same time.
        </p>
      </div>

      <button class="clear-since" type="button">Show the full timeline</button>
    </div>
  </section>

  <section class="timeline-controls" aria-label="Timeline controls">
    <div class="container controls-inner">
      <label class="search-field">
        <span class="sr-only">Search timeline</span>
        <input
          type="search"
          class="timeline-search"
          placeholder="Search the timeline…"
          autocomplete="off"
        />
      </label>

      <label class="direction-field">
        <span class="sr-only">Timeline direction</span>
        <select class="direction-select" aria-label="Timeline direction">
          <option value="newest">Newest change first</option>
          <option value="oldest">Oldest change first</option>
        </select>
      </label>

      <button
        class="filter-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="timeline-filter-panel"
      >
        <span>Filters</span>
        <span class="filter-count" hidden>0</span>
      </button>

      <div class="active-filter-row" hidden>
        <div class="active-filter-chips" aria-label="Active timeline filters"></div>
        <button class="clear-filters clear-filters-inline" type="button">Clear all</button>
      </div>

      <p class="results-summary" aria-live="polite">Showing all {entries.length} entries</p>

      <div class="filter-panel" id="timeline-filter-panel" hidden>
        <div class="filter-panel-header">
          <div>
            <p class="filter-label">Filter the timeline</p>
            <p class="filter-help">Choose any combination of categories and statuses.</p>
          </div>
          <button class="filter-close" type="button" aria-label="Close filters">×</button>
        </div>

        <div class="filter-panel-scroll">
          <div class="filter-groups">
            <div>
              <p class="group-label">Categories</p>
              <div class="filters" role="group" aria-label="Filter timeline by category">
                {categories.map((category) => {
                  const count = entries.filter((entry) => entry.data.category === category).length;
                  return (
                    <button
                      type="button"
                      class="filter-button"
                      data-filter-type="category"
                      data-filter-value={category}
                      aria-pressed="false"
                    >
                      {category}<span class="count">{count}</span>
                    </button>
                  );
                })}
              </div>
            </div>

            <div>
              <p class="group-label">Status</p>
              <div class="filters" role="group" aria-label="Filter timeline by status">
                {statuses.map((status) => {
                  const count = entries.filter((entry) => entry.data.status === status).length;
                  return (
                    <button
                      type="button"
                      class="filter-button"
                      data-filter-type="status"
                      data-filter-value={status}
                      aria-pressed="false"
                    >
                      {status}<span class="count">{count}</span>
                    </button>
                  );
                })}
              </div>
            </div>
          </div>
        </div>

        <div class="filter-panel-actions">
          <button class="clear-filters" type="button">Clear all</button>
          <button class="apply-filters" type="button">Show all {entries.length} entries</button>
        </div>
      </div>
    </div>
  </section>

  <div class="timeline container" data-direction="newest">
    {decades.map((decade) => {
      const decadeEntries = entries.filter(
        (entry) => decadeFor(entry.data.timelineYear) === decade
      );

      return (
        <section class="decade-group" data-decade={decade}>
          <header class="decade-heading">
            <p>{decade}s</p>
            <span aria-hidden="true"></span>
          </header>

          <div class="decade-entries">
            {decadeEntries.map((entry) => (
              <article
                class="timeline-entry"
                data-entry-id={entry.id}
                data-year={entry.data.timelineYear}
                data-category={entry.data.category}
                data-status={entry.data.status}
                data-search={`${entry.data.claim} ${entry.data.currentUnderstanding} ${entry.data.summary} ${entry.data.category} ${entry.data.status} ${entry.data.changedApproximately}`.toLowerCase()}
              >
                <div class="timeline-year" aria-label={`Representative timeline year ${entry.data.timelineYear}`}>
                  {entry.data.timelineYear}
                </div>

                <div class="timeline-content">
                  <h2>
                    <a href={`/entries/${entry.id}/`}>{entry.data.claim}</a>
                  </h2>

                  <p class="timeline-meta">
                    <span>{entry.data.category}</span>
                    <span aria-hidden="true">·</span>
                    <span>{entry.data.status}</span>
                  </p>

                  <p class="timeline-summary">{entry.data.summary}</p>

                  <p class="change-period">
                    <strong>Changed approximately:</strong> {entry.data.changedApproximately}
                  </p>
                </div>
              </article>
            ))}
          </div>
        </section>
      );
    })}
  </div>

  <p class="container empty-state" hidden>No entries match those filters.</p>

  <noscript>
    <p class="container noscript-note">
      Search, filtering, and timeline direction require JavaScript. The full
      timeline is shown newest-first.
    </p>
  </noscript>

  <script>
    const timeline = document.querySelector<HTMLElement>('.timeline');
    const searchInput = document.querySelector<HTMLInputElement>('.timeline-search');
    const directionSelect = document.querySelector<HTMLSelectElement>('.direction-select');
    const filterButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.filter-button')
    );
    const filterToggle = document.querySelector<HTMLButtonElement>('.filter-toggle');
    const filterPanel = document.querySelector<HTMLElement>('.filter-panel');
    const filterClose = document.querySelector<HTMLButtonElement>('.filter-close');
    const applyButton = document.querySelector<HTMLButtonElement>('.apply-filters');
    const clearButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.clear-filters')
    );
    const filterCount = document.querySelector<HTMLElement>('.filter-count');
    const activeFilterRow = document.querySelector<HTMLElement>('.active-filter-row');
    const activeFilterChips = document.querySelector<HTMLElement>('.active-filter-chips');
    const resultsSummary = document.querySelector<HTMLElement>('.results-summary');
    const emptyState = document.querySelector<HTMLElement>('.empty-state');
    const schoolContext = document.querySelector<HTMLElement>('.school-context');
    const schoolContextTitle = document.querySelector<HTMLElement>('.school-context-title');
    const clearSinceButton = document.querySelector<HTMLButtonElement>('.clear-since');

    const selectedCategories = new Set<string>();
    const selectedStatuses = new Set<string>();
    let direction: 'newest' | 'oldest' = 'newest';
    let sinceYear: number | null = null;

    const allEntries = () => Array.from(
      document.querySelectorAll<HTMLElement>('.timeline-entry')
    );

    const updateURL = () => {
      const url = new URL(window.location.href);
      const search = searchInput?.value.trim() ?? '';

      const setList = (key: string, values: Set<string>) => {
        if (values.size) url.searchParams.set(key, [...values].sort().join(','));
        else url.searchParams.delete(key);
      };

      setList('categories', selectedCategories);
      setList('statuses', selectedStatuses);

      if (search) url.searchParams.set('q', search);
      else url.searchParams.delete('q');

      if (sinceYear !== null) url.searchParams.set('since', String(sinceYear));
      else url.searchParams.delete('since');

      if (direction === 'oldest') url.searchParams.set('direction', 'oldest');
      else url.searchParams.delete('direction');

      window.history.replaceState({}, '', url);
    };

    const openFilters = () => {
      if (!filterPanel || !filterToggle) return;
      filterPanel.hidden = false;
      filterToggle.setAttribute('aria-expanded', 'true');
      document.body.classList.add('timeline-filters-open');
      filterPanel.querySelector<HTMLButtonElement>('.filter-button')?.focus();
    };

    const closeFilters = (returnFocus = true) => {
      if (!filterPanel || !filterToggle) return;
      filterPanel.hidden = true;
      filterToggle.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('timeline-filters-open');
      if (returnFocus) filterToggle.focus();
    };

    const reorderTimeline = () => {
      if (!timeline) return;

      const groups = Array.from(
        timeline.querySelectorAll<HTMLElement>('.decade-group')
      );

      groups
        .sort((a, b) => {
          const decadeA = Number(a.dataset.decade ?? 0);
          const decadeB = Number(b.dataset.decade ?? 0);
          return direction === 'newest' ? decadeB - decadeA : decadeA - decadeB;
        })
        .forEach((group) => {
          const entriesContainer = group.querySelector<HTMLElement>('.decade-entries');

          if (entriesContainer) {
            const entries = Array.from(
              entriesContainer.querySelectorAll<HTMLElement>('.timeline-entry')
            );

            entries
              .sort((a, b) => {
                const yearA = Number(a.dataset.year ?? 0);
                const yearB = Number(b.dataset.year ?? 0);
                const yearOrder = direction === 'newest' ? yearB - yearA : yearA - yearB;

                if (yearOrder !== 0) return yearOrder;

                return (a.textContent ?? '').localeCompare(
                  b.textContent ?? '',
                  undefined,
                  { sensitivity: 'base' }
                );
              })
              .forEach((entry) => entriesContainer.append(entry));
          }

          timeline.append(group);
        });

      timeline.dataset.direction = direction;
    };

    const removeFilter = (type: string, value: string) => {
      const target = type === 'category' ? selectedCategories : selectedStatuses;
      target.delete(value);
      updateDisplay();
    };

    const renderActiveFilters = () => {
      const selections = [
        ...[...selectedCategories].sort().map((value) => ({ type: 'category', value })),
        ...[...selectedStatuses].sort().map((value) => ({ type: 'status', value })),
      ];

      const count = selections.length;

      if (filterCount) {
        filterCount.textContent = String(count);
        filterCount.hidden = count === 0;
      }

      if (activeFilterRow) activeFilterRow.hidden = count === 0;
      if (!activeFilterChips) return;

      activeFilterChips.replaceChildren();

      selections.forEach(({ type, value }) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'active-filter-chip';
        button.setAttribute('aria-label', `Remove ${value} filter`);

        const label = document.createElement('span');
        label.textContent = value;

        const removeIcon = document.createElement('span');
        removeIcon.setAttribute('aria-hidden', 'true');
        removeIcon.textContent = '×';

        button.append(label, removeIcon);
        button.addEventListener('click', () => removeFilter(type, value));
        activeFilterChips.append(button);
      });
    };

    const updateFilterCounts = (query: string) => {
      const entries = allEntries();

      filterButtons.forEach((button) => {
        const type = button.dataset.filterType;
        const value = button.dataset.filterValue ?? '';

        if (!value || (type !== 'category' && type !== 'status')) return;

        const count = entries.filter((entry) => {
          const year = Number(entry.dataset.year ?? 0);
          const sinceMatch = sinceYear === null || year >= sinceYear;
          const searchMatch = !query || (entry.dataset.search ?? '').includes(query);

          const categoryMatch =
            type === 'category'
              ? entry.dataset.category === value
              : selectedCategories.size === 0 ||
                selectedCategories.has(entry.dataset.category ?? '');

          const statusMatch =
            type === 'status'
              ? entry.dataset.status === value
              : selectedStatuses.size === 0 ||
                selectedStatuses.has(entry.dataset.status ?? '');

          return sinceMatch && searchMatch && categoryMatch && statusMatch;
        }).length;

        const countElement = button.querySelector<HTMLElement>('.count');
        if (countElement) countElement.textContent = String(count);
      });
    };

    const updateDisplay = () => {
      const query = searchInput?.value.trim().toLowerCase() ?? '';
      let visibleCount = 0;

      allEntries().forEach((entry) => {
        const categoryMatch =
          selectedCategories.size === 0 || selectedCategories.has(entry.dataset.category ?? '');

        const statusMatch =
          selectedStatuses.size === 0 || selectedStatuses.has(entry.dataset.status ?? '');

        const searchMatch = !query || (entry.dataset.search ?? '').includes(query);
        const year = Number(entry.dataset.year ?? 0);
        const sinceMatch = sinceYear === null || year >= sinceYear;
        const visible = categoryMatch && statusMatch && searchMatch && sinceMatch;

        entry.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      document.querySelectorAll<HTMLElement>('.decade-group').forEach((group) => {
        const hasVisibleEntries = Array.from(
          group.querySelectorAll<HTMLElement>('.timeline-entry')
        ).some((entry) => !entry.hidden);

        group.hidden = !hasVisibleEntries;
      });

      filterButtons.forEach((button) => {
        const type = button.dataset.filterType;
        const value = button.dataset.filterValue ?? '';
        const active = type === 'category'
          ? selectedCategories.has(value)
          : selectedStatuses.has(value);

        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });

      updateFilterCounts(query);

      const hasFilters =
        selectedCategories.size > 0 ||
        selectedStatuses.size > 0 ||
        query.length > 0 ||
        sinceYear !== null;

      if (resultsSummary) {
        if (sinceYear !== null) {
          resultsSummary.textContent =
            `Showing ${visibleCount} ${visibleCount === 1 ? 'entry' : 'entries'} changed since ${sinceYear}`;
        } else if (hasFilters) {
          resultsSummary.textContent =
            `Showing ${visibleCount} of ${allEntries().length} ${visibleCount === 1 ? 'entry' : 'entries'}`;
        } else {
          resultsSummary.textContent = `Showing all ${allEntries().length} entries`;
        }
      }

      if (schoolContext && schoolContextTitle) {
        if (sinceYear !== null) {
          schoolContext.hidden = false;
          schoolContextTitle.textContent =
            `What changed since you started school in ${sinceYear}?`;
        } else {
          schoolContext.hidden = true;
        }
      }

      if (applyButton) {
        applyButton.textContent = visibleCount === 1
          ? 'Show 1 result'
          : `Show ${visibleCount} results`;
      }

      if (emptyState) emptyState.hidden = visibleCount !== 0;

      renderActiveFilters();
      updateURL();
    };

    const clearFilters = () => {
      selectedCategories.clear();
      selectedStatuses.clear();
      updateDisplay();
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const type = button.dataset.filterType;
        const value = button.dataset.filterValue;
        if (!value) return;

        const target = type === 'category' ? selectedCategories : selectedStatuses;
        target.has(value) ? target.delete(value) : target.add(value);
        updateDisplay();
      });
    });

    searchInput?.addEventListener('input', updateDisplay);

    directionSelect?.addEventListener('change', () => {
      direction = directionSelect.value === 'oldest' ? 'oldest' : 'newest';
      reorderTimeline();
      updateURL();
    });

    filterToggle?.addEventListener('click', () => {
      filterPanel?.hidden ? openFilters() : closeFilters();
    });

    filterClose?.addEventListener('click', () => closeFilters());
    applyButton?.addEventListener('click', () => closeFilters());
    clearButtons.forEach((button) => button.addEventListener('click', clearFilters));

    clearSinceButton?.addEventListener('click', () => {
      sinceYear = null;
      updateDisplay();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && filterPanel && !filterPanel.hidden) closeFilters();
    });

    const url = new URL(window.location.href);

    const readList = (key: string, target: Set<string>) => {
      url.searchParams
        .get(key)
        ?.split(',')
        .map((value) => value.trim())
        .filter(Boolean)
        .forEach((value) => target.add(value));
    };

    readList('categories', selectedCategories);
    readList('statuses', selectedStatuses);

    const rawSince = url.searchParams.get('since');
    if (rawSince) {
      const parsedSince = Number(rawSince);
      const currentYear = new Date().getFullYear();

      if (
        Number.isInteger(parsedSince) &&
        parsedSince >= 1900 &&
        parsedSince <= currentYear
      ) {
        sinceYear = parsedSince;
      }
    }

    if (searchInput) searchInput.value = url.searchParams.get('q') ?? '';

    direction = url.searchParams.get('direction') === 'oldest' ? 'oldest' : 'newest';
    if (directionSelect) directionSelect.value = direction;

    reorderTimeline();
    updateDisplay();
  </script>
</BaseLayout>

<style>
  .timeline-head {
    padding: 5rem 0 2.5rem;
  }

  .timeline-head h1 {
    margin: 0.2rem 0 1rem;
  }

  .timeline-intro {
    font-size: 1.2rem;
    color: var(--muted);
  }

  .school-context {
    padding-bottom: 2.5rem;
  }

  .school-context[hidden] {
    display: none;
  }

  .school-context-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    padding: clamp(1.4rem, 4vw, 2rem);
    border: 1px solid var(--line);
    border-left: 5px solid var(--accent);
    background: var(--card);
  }

  .school-context h2 {
    margin: 0.15rem 0 0.55rem;
    font-size: clamp(1.5rem, 3vw, 2.15rem);
  }

  .school-context-copy {
    max-width: 68ch;
    margin: 0;
    color: var(--muted);
  }

  .clear-since {
    flex: 0 0 auto;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.6rem 0.9rem;
    color: var(--ink);
    background: var(--paper);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .clear-since:hover {
    border-color: var(--accent-dark);
    color: var(--accent-dark);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .timeline-controls {
    position: sticky;
    top: 0;
    z-index: 20;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 95%, transparent);
    backdrop-filter: blur(10px);
  }

  .controls-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(14rem, 1fr) auto auto;
    gap: 0.65rem;
    align-items: center;
    padding: 0.8rem 0 0.65rem;
  }

  .search-field,
  .direction-field {
    display: block;
  }

  .timeline-search,
  .direction-select {
    min-height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    padding: 0.62rem 0.8rem;
    color: var(--ink);
    background: var(--card);
    font: inherit;
  }

  .timeline-search {
    width: 100%;
  }

  .direction-select {
    cursor: pointer;
  }

  .timeline-search:focus,
  .direction-select:focus {
    outline: 2px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-color: var(--accent-dark);
  }

  .filter-toggle {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.55rem 0.9rem;
    color: var(--ink);
    background: var(--card);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .filter-count {
    min-width: 1.35rem;
    padding: 0.05rem 0.35rem;
    border-radius: 999px;
    color: white;
    background: var(--accent-dark);
    font-size: 0.72rem;
    line-height: 1.2;
    text-align: center;
  }

  .active-filter-row {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .active-filter-row[hidden] {
    display: none;
  }

  .active-filter-chips {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    scrollbar-width: thin;
    flex: 1;
  }

  :global(.active-filter-chip) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.28rem 0.6rem;
    color: var(--ink);
    background: var(--card);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 750;
    cursor: pointer;
  }

  .clear-filters {
    border: 0;
    color: var(--accent-dark);
    background: transparent;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
  }

  .results-summary {
    grid-column: 1 / -1;
    margin: 0;
    color: var(--muted);
    font-size: 0.86rem;
  }

  .filter-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.45rem);
    width: min(52rem, 100%);
    max-height: min(72vh, 42rem);
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    border: 1px solid var(--line);
    border-radius: 0.9rem;
    background: var(--card);
    box-shadow: 0 1.2rem 3rem color-mix(in srgb, var(--ink) 18%, transparent);
    overflow: hidden;
  }

  .filter-panel[hidden] {
    display: none;
  }

  .filter-panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1rem 0.8rem;
    border-bottom: 1px solid var(--line);
  }

  .filter-label,
  .group-label {
    margin: 0;
    font-weight: 850;
  }

  .filter-help {
    margin: 0.12rem 0 0;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .filter-close {
    width: 2.1rem;
    height: 2.1rem;
    border: 0;
    border-radius: 999px;
    color: var(--ink);
    background: var(--paper);
    font: inherit;
    font-size: 1.35rem;
    cursor: pointer;
  }

  .filter-panel-scroll {
    overflow: auto;
    padding: 1rem;
  }

  .filter-groups {
    display: grid;
    gap: 1.2rem;
  }

  .group-label {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .filters {
    display: flex;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin-top: 0.45rem;
  }

  .filter-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.38rem 0.72rem;
    color: var(--ink);
    background: var(--paper);
    font: inherit;
    font-size: 0.88rem;
    font-weight: 750;
    cursor: pointer;
  }

  .filter-button.is-active {
