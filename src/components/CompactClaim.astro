---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'entries'>;
}

const { entry } = Astro.props;
const { data } = entry;
---

<a class="compact-claim" href={`/entries/${entry.id}/`}>
  <strong>{data.claim}</strong>
  <span>{data.category} · {data.status}</span>
</a>

<style>
  .compact-claim {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 4.25rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--card) 78%, transparent);
    text-decoration: none;
    transition:
      border-color 140ms ease,
      background 140ms ease,
      transform 140ms ease;
  }

  .compact-claim:hover,
  .compact-claim:focus-visible {
    border-color: var(--accent-dark);
    background: var(--card);
    transform: translateY(-1px);
  }

  strong {
    font-size: 0.96rem;
    line-height: 1.28;
  }

  span {
    margin-top: 0.28rem;
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 650;
    line-height: 1.2;
  }
</style>
