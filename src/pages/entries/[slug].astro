---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FactCard from '../../components/FactCard.astro';
import EntryMedia from '../../components/EntryMedia.astro';
import EntryDiscovery from '../../components/EntryDiscovery.astro';
import CorrectionLink from '../../components/CorrectionLink.astro';
import ReadingPathNav from '../../components/ReadingPathNav.astro';
import Permalink from '../../components/Permalink.astro';
import { sourceAnchor } from '../../lib/sourceAnchors';
import { translationMatchesEntry } from '../../lib/i18n';

export async function getStaticPaths() {
  const entries = await getCollection('entries');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const translations = await getCollection(
  'entryTranslations',
  (translation) =>
    translation.data.locale === 'de' &&
    translation.data.entryId === entry.id &&
    translationMatchesEntry(entry, translation),
);
const hasGermanTranslation = translations.length > 0;

const groupedSources = entry.data.sources.reduce<Record<string, typeof entry.data.sources>>((groups, source) => {
  (groups[source.purpose] ??= []).push(source);
  return groups;
}, {});
---
<BaseLayout
  title={entry.data.claim}
  description={entry.data.summary}
  type="article"
  alternatePath={hasGermanTranslation ? `/de/entries/${entry.id}/` : undefined}
>
  <div class="narrow entry-page">
    <FactCard entry={entry} expanded headingLevel={1} />

    <ReadingPathNav collection="entries" id={entry.id} compact />

    <EntryMedia media={entry.data.media} />

    <article class="context prose">
      <Content />
    </article>

    <section class="evidence" id="sources">
      <p class="eyebrow">Evidence</p>
      <h2>Sources and what they establish</h2>
      <Permalink id="sources" context="Sources and what they establish" kind="section" />
      {Object.entries(groupedSources).map(([purpose, sources]) => (
        <div class="source-group">
          <h3>{purpose}</h3>
          <ul>
            {sources?.map((source) => (
              <li class="source-note" id={sourceAnchor(source)}>
                <a href={source.url} target="_blank" rel="noopener noreferrer"><strong>{source.title}</strong></a>
                <span>{source.publisher}</span>
                <p>{source.note}</p>
                <Permalink id={sourceAnchor(source)} context={source.title} />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <ReadingPathNav collection="entries" id={entry.id} />

    <EntryDiscovery entry={entry} />

    <aside class="reviewed">
      Published {entry.data.publishedAt.toLocaleDateString('en-GB')} · Last reviewed {entry.data.reviewedAt.toLocaleDateString('en-GB')}
      <p><CorrectionLink /></p>
    </aside>
  </div>
</BaseLayout>

<style>
  .entry-page { padding: 4rem 0; }
  .context, .evidence { margin-top: 3rem; }
  .prose :global(p) { font-size: 1.1rem; }
  .evidence h2 { margin-top: .3rem; }
  .source-group { margin-top: 2.25rem; }
  .source-group h3 { border-bottom: 1px solid var(--line); padding-bottom: .5rem; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { padding: 1rem 0; border-bottom: 1px solid var(--line); }
  li a { color: var(--accent-dark); }
  li span { display: block; color: var(--muted); font-size: .92rem; }
  li p { margin: .35rem 0 0; }
  .source-note:target { outline: 2px solid var(--accent-dark); outline-offset: .35rem; scroll-margin-top: 1rem; }
  .reviewed { margin-top: 3rem; padding: 1rem; background: #e9e3d6; color: var(--muted); font-size: .9rem; }
</style>
