---
import ExplorerVisual from './ExplorerVisual.astro';
import { explorerCategories, explorerPath, getReviewedExplorerStories } from '../lib/young-explorers';
import { localizedPath, type SiteLocale } from '../lib/i18n';
const { locale } = Astro.props as { locale: SiteLocale };
const de = locale === 'de';
const items = await getReviewedExplorerStories();
const heroStory = items.find(({ story }) => story.visual === 'crystal')!.story;
const categories = explorerCategories[locale];
---
<div class="explorer-index container">
  <section class="explorer-hero" aria-labelledby="explorer-title">
    <div>
      <p class="eyebrow">{de ? 'Junge Entdecker' : 'Young Explorers'}</p>
      <h1 id="explorer-title">{de ? 'Kleine Spuren.' : 'Small clues.'}<br /><span>{de ? 'Große Entdeckungen.' : 'Big discoveries.'}</span></h1>
      <p class="hero-intro">{de ? 'Ein Vogel, ein Kristall, ein flackernder Stern. Entdecke die Belege, die Menschen zum Umdenken brachten.' : 'A bird, a crystal, a flickering star. Follow the evidence that made people think again.'}</p>
      <a class="button" href="#explorer-stories">{de ? 'Geschichten entdecken' : 'Find a story'} <span aria-hidden="true">↓</span></a>
    </div>
    <a class="hero-note" href={explorerPath(heroStory.id, locale)}>
      <span class="note-label">{de ? 'Genau hinsehen' : 'Look closer'}</span>
      <ExplorerVisual story={heroStory} locale={locale} decorative />
      <span class="note-caption">{heroStory[locale].title} <span aria-hidden="true">↗</span></span>
    </a>
  </section>

  <aside class="reading-note">
    <p>{de ? 'Kurze Geschichten für etwa 9–12 Jahre. Jüngere Kinder können gemeinsam mit Erwachsenen lesen.' : 'Short reads for roughly ages 9–12. Younger explorers can read with a grown-up.'}</p>
    <a href={localizedPath('/kids/for-grown-ups/', locale)}>{de ? 'Für Erwachsene' : 'For grown-ups'} <span aria-hidden="true">→</span></a>
  </aside>

  <nf-explorer-browser data-locale={locale} data-count-template={de ? '{n} von {total} Geschichten' : '{n} of {total} stories'}>
    <section class="story-shelf" id="explorer-stories" aria-labelledby="stories-title">
      <div class="shelf-heading">
        <div><p class="eyebrow">{de ? 'Der Anfang einer Sammlung' : 'A collection to begin with'}</p><h2 id="stories-title">{de ? 'Womit fängst du an?' : 'What will you explore?'}</h2></div>
        <button class="random-button" type="button" data-random hidden>{de ? 'Überrasch mich' : 'Surprise me'} <span aria-hidden="true">↗</span></button>
      </div>
      <form class="explorer-filters" data-controls hidden role="search" aria-label={de ? 'Kindergeschichten durchsuchen' : 'Search children’s stories'}>
        <div class="search-field"><label for="explorer-search">{de ? 'Geschichten durchsuchen' : 'Search the stories'}</label><input id="explorer-search" type="search" name="q" placeholder={de ? 'Zum Beispiel: Licht, Vogel, Stein …' : 'Try light, birds, stones…'} aria-controls="explorer-story-grid" autocomplete="off" /></div>
        <div><label for="explorer-category">{de ? 'Thema' : 'Topic'}</label><select id="explorer-category" name="category" aria-controls="explorer-story-grid"><option value="all">{de ? 'Alle Themen' : 'All topics'}</option>{Object.entries(categories).map(([key, label]) => <option value={key}>{label}</option>)}</select></div>
        <button class="reset-button" type="button" data-reset>{de ? 'Zurücksetzen' : 'Clear filters'}</button>
      </form>
      <p class="result-count" data-count role="status" aria-live="polite" aria-atomic="true">{de ? `${items.length} Geschichten` : `${items.length} stories`}</p>
      <noscript><p>{de ? 'Hier siehst du alle Geschichten. Suche und Zufallsauswahl benötigen JavaScript.' : 'All stories are shown below. Search and the surprise button need JavaScript.'}</p></noscript>
      <div class="explorer-grid" id="explorer-story-grid">
        {items.map(({ story }, i) => {
          const copy = story[locale];
          return <article class="explorer-card" data-story={story.id} data-category={story.category} data-search={[copy.title, copy.summary, copy.then, copy.evidence, copy.now, categories[story.category]].join(' ')}>
            <a href={explorerPath(story.id, locale)} aria-labelledby={`story-title-${story.id}`}>
              <div class="card-art"><ExplorerVisual story={story} locale={locale} decorative /></div>
              <div class="card-copy">
                <p class="card-meta"><span>{categories[story.category]}</span><span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span></p>
                <h3 id={`story-title-${story.id}`}>{copy.title}</h3>
                <p>{copy.summary}</p>
                <span class="read-story">{de ? 'Der Spur folgen' : 'Follow the clue'} <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </article>;
        })}
      </div>
      <div class="no-results" data-empty hidden><h3>{de ? 'Hier passt noch keine Geschichte.' : 'No stories match yet.'}</h3><p>{de ? 'Versuche ein anderes Wort oder setze die Filter zurück.' : 'Try another word or clear the filters to see every story.'}</p></div>
    </section>
  </nf-explorer-browser>
  <aside class="explorer-endnote"><p>{de ? 'Die spannendste Frage ist oft: Welcher Beleg hat etwas verändert?' : 'The most interesting question is often: what evidence changed the story?'}</p></aside>
</div>

<script>
  class ExplorerBrowser extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const form = this.querySelector<HTMLFormElement>('form')!;
      const search = form.querySelector<HTMLInputElement>('input')!;
      const category = form.querySelector<HTMLSelectElement>('select')!;
      const random = this.querySelector<HTMLButtonElement>('[data-random]')!;
      const reset = this.querySelector<HTMLButtonElement>('[data-reset]')!;
      const count = this.querySelector<HTMLElement>('[data-count]')!;
      const empty = this.querySelector<HTMLElement>('[data-empty]')!;
      const cards = [...this.querySelectorAll<HTMLElement>('[data-story]')];
      const fold = (value: string) => value.toLocaleLowerCase(this.dataset.locale).normalize('NFKD').replace(/\p{M}/gu, '');
      const searchable = new Map(cards.map((card) => [card, fold(card.dataset.search ?? '')]));
      const filter = () => {
        const words = fold(search.value.trim()).split(/\s+/).filter(Boolean);
        let visible = 0;
        for (const card of cards) {
          card.hidden = !(category.value === 'all' || category.value === card.dataset.category) || !words.every((word) => searchable.get(card)!.includes(word));
          if (!card.hidden) visible++;
        }
        count.textContent = this.dataset.countTemplate!.replace('{n}', String(visible)).replace('{total}', String(cards.length));
        empty.hidden = visible !== 0;
        random.disabled = visible === 0;
        reset.disabled = !search.value && category.value === 'all';
      };
      const readURL = () => {
        const params = new URLSearchParams(location.search);
        search.value = params.get('q') ?? '';
        const requested = params.get('category') ?? 'all';
        category.value = [...category.options].some((option) => option.value === requested) ? requested : 'all';
        filter();
      };
      const writeURL = (push = false) => {
        const url = new URL(location.href);
        search.value.trim() ? url.searchParams.set('q', search.value.trim()) : url.searchParams.delete('q');
        category.value !== 'all' ? url.searchParams.set('category', category.value) : url.searchParams.delete('category');
        if (url.href !== location.href) push ? history.pushState(null, '', url) : history.replaceState(null, '', url);
        filter();
      };
      search.addEventListener('input', () => writeURL());
      category.addEventListener('change', () => writeURL(true));
      form.addEventListener('submit', (event) => { event.preventDefault(); writeURL(); });
      reset.addEventListener('click', () => { search.value = ''; category.value = 'all'; writeURL(true); search.focus(); });
      random.addEventListener('click', () => {
        const visible = cards.filter((card) => !card.hidden);
        const card = visible[Math.floor(Math.random() * visible.length)];
        if (card) location.assign(card.querySelector<HTMLAnchorElement>('a')!.href);
      });
      window.addEventListener('popstate', readURL);
      window.addEventListener('pageshow', readURL);
      readURL();
      form.hidden = false;
      random.hidden = false;
    }
  }
  if (!customElements.get('nf-explorer-browser')) customElements.define('nf-explorer-browser', ExplorerBrowser);
</script>

<style>
  .explorer-index { padding-bottom: 3rem; }
  .explorer-hero { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: center; gap: 3rem; padding: 4rem 0 3rem; }
  .explorer-hero h1 { font-size: clamp(2.8rem, 5vw, 4.7rem); line-height: 1.04; margin: 1rem 0 1.5rem; text-wrap: initial; }
  h1 span { color: #315f53; }
  .hero-intro { font-size: 1.2rem; max-width: 42ch; margin-bottom: 1.75rem; }
  .hero-note { display: block; text-decoration: none; background: #fffdf7; border: 1px solid #a8b9a9; border-radius: 16px; box-shadow: 7px 9px 0 #e0d7c3; overflow: hidden; transform: rotate(2deg); }
  .hero-note:hover { border-color: #315f53; }
  .note-label { display: block; padding: 1rem 1.5rem; color: #315f53; font-size: .75rem; font-weight: 850; text-transform: uppercase; letter-spacing: .15em; }
  .note-caption { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.5rem; gap: 1rem; font-weight: 750; }
  .note-caption span { font-size: 1.5rem; }
  .reading-note { display: flex; align-items: center; gap: 1rem; justify-content: space-between; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 1rem 0; font-size: .9rem; }
  .reading-note p { margin: 0; } .reading-note a { flex-shrink: 0; font-weight: 700; text-underline-offset: .25rem; padding: .5rem 0; }
  nf-explorer-browser { display: block; }
  .story-shelf { padding-top: 3rem; scroll-margin-top: 1rem; }
  .shelf-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  h2 { margin: .5rem 0; font-size: clamp(1.7rem, 3vw, 2.3rem); }
  .eyebrow { margin: 0; }
  button { cursor: pointer; font: inherit; font-weight: 700; }
  .random-button { border: 1px solid #315f53; color: #214b43; background: #e5ece5; border-radius: 999px; padding: .8rem 1.25rem; flex-shrink: 0; }
  .random-button:hover:enabled { background: #d5e2d6; }
  button:disabled { cursor: default; opacity: .55; }
  .explorer-filters { display: grid; grid-template-columns: minmax(0, 1fr) minmax(190px, 260px) auto; gap: 1rem; align-items: end; padding: 1.25rem; border: 1px solid var(--line); border-radius: 12px; background: #ede9dd; }
  label { display: block; font-size: .82rem; font-weight: 750; margin-bottom: .45rem; }
  input, select { width: 100%; min-height: 48px; border: 1px solid #a3a498; background: var(--card); border-radius: 6px; padding: .6rem .8rem; color: var(--ink); font: inherit; }
  .reset-button { border: 0; background: transparent; color: #315f53; min-height: 48px; padding: .5rem; text-decoration: underline; text-underline-offset: .25rem; }
  .result-count { font-size: .85rem; color: #52584f; margin: 1rem 0; }
  .explorer-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; }
  .explorer-card { border: 1px solid #bbbfb0; border-radius: 12px; background: var(--card); overflow: hidden; }
  .explorer-card > a { display: flex; flex-direction: column; height: 100%; text-decoration: none; }
  .explorer-card:has(a:hover) { border-color: #315f53; box-shadow: 0 4px 0 #dbe1d2; }
  .explorer-card a:focus-visible { outline-offset: -5px; }
  .card-art { border-bottom: 1px solid #bfcbbb; }
  .card-copy { padding: 1.3rem; display: flex; flex-direction: column; flex: 1; }
  .card-meta { display: flex; justify-content: space-between; gap: .5rem; margin: 0; font-size: .7rem; font-weight: 800; text-transform: uppercase; letter-spacing: .055em; color: #315f53; }
  .card-meta span:last-child { font-variant-numeric: tabular-nums; }
  h3 { font-size: 1.42rem; line-height: 1.18; margin: .8rem 0 .65rem; }
  .card-copy > p:not(.card-meta) { margin: 0 0 1.5rem; font-size: .95rem; }
  .read-story { display: flex; justify-content: space-between; margin-top: auto; font-size: .85rem; font-weight: 750; color: #315f53; }
  .no-results { padding: 2rem; background: var(--card); border: 1px dashed #879e89; border-radius: 12px; }
  .no-results h3 { margin-top: 0; }
  .explorer-endnote { border-top: 1px solid var(--line); margin-top: 3rem; padding-top: 1rem; color: #315f53; font-weight: 650; }
  [hidden] { display: none !important; }
  @media (max-width: 900px) { .explorer-hero { gap: 2rem; } .explorer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .explorer-filters { grid-template-columns: minmax(0, 1fr) minmax(180px, 240px); } .reset-button { justify-self: start; min-height: 44px; } }
  @media (max-width: 650px) { .explorer-hero { grid-template-columns: minmax(0, 1fr); padding: 2.5rem 0 2rem; } .explorer-hero h1 { font-size: clamp(2rem, 10vw, 2.8rem); } .hero-note { transform: none; max-width: 440px; } .reading-note, .shelf-heading { align-items: flex-start; flex-direction: column; gap: .75rem; } .explorer-filters, .explorer-grid { grid-template-columns: minmax(0, 1fr); } .explorer-filters { gap: .8rem; } .explorer-grid { gap: 1.2rem; } .card-copy { padding: 1.25rem; } h3 { font-size: 1.55rem; } .story-shelf { padding-top: 2rem; } }
</style>
