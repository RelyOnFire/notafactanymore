---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FactCard from '../../../components/FactCard.astro';
import CompactClaim from '../../../components/CompactClaim.astro';
import {
  categoryLabel,
  formatApproxYearsLocalized,
  statusLabel,
  translationMatchesEntry,
} from '../../../lib/i18n';
import {
  centuryLabel,
  formatApproxYears,
  formatHistoricalYear,
  lifespanYears,
  median,
} from '../../../lib/lifespans';

export async function getStaticPaths() {
  const entries = await getCollection('entries');
  const translations = await getCollection(
    'entryTranslations',
    (translation) => translation.data.locale === 'de',
  );

  const translatedEntries = entries.flatMap((entry) => {
    const translation = translations.find(
      (candidate) =>
        candidate.data.entryId === entry.id &&
        translationMatchesEntry(entry, candidate),
    );
    return translation ? [{ entry, translation }] : [];
  });

  const categories = [...new Set(translatedEntries.map(({ entry }) => entry.data.category))].sort();

  return categories.map((category) => ({
    params: { category: category.toLowerCase() },
    props: {
      category,
      items: translatedEntries.filter(({ entry }) => entry.data.category === category),
    },
  }));
}

const { category, items } = Astro.props;
const entries = items.map(({ entry }) => entry);

const statusStats = [...new Set(entries.map((entry) => entry.data.status))]
  .map((status) => ({
    status,
    count: entries.filter((entry) => entry.data.status === status).length,
  }))
  .sort((a, b) => b.count - a.count || statusLabel(a.status, 'de').localeCompare(statusLabel(b.status, 'de'), 'de'));

const comparableEntries = entries.filter((entry) => entry.data.lifespanComparable !== false);
const categoryMedian = comparableEntries.length
  ? median(comparableEntries.map((entry) => lifespanYears(entry.data.acceptedYear, entry.data.timelineYear)))
  : null;

const oldestChange = Math.min(...entries.map((entry) => entry.data.timelineYear));
const newestChange = Math.max(...entries.map((entry) => entry.data.timelineYear));
const categoryName = categoryLabel(category, 'de');

const formatHistoricalYearDe = (year: number) => year < 0 ? `${Math.abs(year)} v. Chr.` : String(year);
const centuryLabelDe = (year: number) => {
  if (year <= 0) return 'v. Chr.';
  const century = Math.floor((year - 1) / 100) + 1;
  return `${century}. Jahrhundert`;
};

const sortedItems = [...items].sort(
  (a, b) =>
    b.entry.data.timelineYear - a.entry.data.timelineYear ||
    a.translation.data.claim.localeCompare(b.translation.data.claim, 'de', { sensitivity: 'base' }),
);
---
<BaseLayout
  locale="de"
  title={`${categoryName} — Kategorie`}
  description={`Erkunde ${entries.length} Katalogeinträge in ${categoryName} mit Status, Lebensdauer, Chronologie, Filtern, Gruppierung und Sortierung.`}
  alternatePath={`/categories/${encodeURIComponent(category.toLowerCase())}/`}
>
  <header class="container page-head">
    <p class="eyebrow">Kategorie</p>
    <h1>{categoryName}</h1>
    <p class="page-intro">
      Erkunde die {entries.length} {entries.length === 1 ? 'Eintrag' : 'Einträge'}, die derzeit dieser
      Kategorie zugeordnet sind. Die Zahlen beschreiben diesen kuratierten Katalog, nicht Größe oder Änderungsrate des Fachgebiets.
    </p>
  </header>

  <section class="container overview" aria-labelledby="category-overview-title">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Auf einen Blick</p>
        <h2 id="category-overview-title">Was diese Kategorie enthält</h2>
      </div>
    </div>

    <div class="stats-grid">
      <article>
        <span>Einträge</span>
        <strong>{entries.length}</strong>
        <small>In diesem Katalog</small>
      </article>
      <article>
        <span>Vertretene Status</span>
        <strong>{statusStats.length}</strong>
        <small>{statusStats.map((item) => statusLabel(item.status, 'de')).join(' · ')}</small>
      </article>
      <article>
        <span>Median der Lebensdauer</span>
        <strong>{categoryMedian === null ? '—' : formatApproxYearsLocalized(categoryMedian, 'de')}</strong>
        <small>
          {comparableEntries.length === 0
            ? 'Keine quantitativ vergleichbaren Einträge'
            : `${comparableEntries.length} quantitativ vergleichbare ${comparableEntries.length === 1 ? 'Eintrag' : 'Einträge'}`}
        </small>
      </article>
      <article>
        <span>Repräsentative Änderungen</span>
        <strong>{formatHistoricalYearDe(oldestChange)} → {formatHistoricalYearDe(newestChange)}</strong>
        <small>Ältester bis neuester Änderungsanker</small>
      </article>
    </div>

    <div class="status-breakdown" aria-label="Status breakdown">
      {statusStats.map((item) => (
        <button
          class="status-breakdown-button"
          type="button"
          data-status={item.status}
          aria-pressed="false"
        >
          <span>{statusLabel(item.status, 'de')}</span>
          <strong>{item.count}</strong>
          <i
            aria-hidden="true"
            style={`--status-share: ${(item.count / entries.length) * 100}%`}
          ></i>
        </button>
      ))}
    </div>
  </section>

  <section class="category-explorer">
    <div class="container">
      <div class="section-heading explorer-heading">
        <div>
          <p class="eyebrow">Einträge erkunden</p>
          <h2>{categoryName} durchsuchen</h2>
          <p>
            Filtere die Kategorie, wähle eine Gruppierung und ändere die Sortierung, ohne die Seite zu verlassen.
          </p>
        </div>
      </div>

      <div class="controls" aria-label={`Steuerung für die Kategorie ${categoryName}`}>
        <label class="search-field">
          <span class="sr-only">Diese Kategorie durchsuchen</span>
          <input class="category-search" type="search" placeholder={`${categoryName} durchsuchen…`} autocomplete="off" />
        </label>

        <label>
          <span class="control-label">Lebensdauer</span>
          <select class="lifespan-filter">
            <option value="">Alle Einträge</option>
            <option value="quantified">Quantifizierte Lebensdauer</option>
            <option value="unquantified">Nicht quantifiziert</option>
          </select>
        </label>

        <label>
          <span class="control-label">Sortierung</span>
          <select class="sort-select">
            <option value="newest">Neueste Änderung zuerst</option>
            <option value="oldest">Älteste Änderung zuerst</option>
            <option value="shortest">Kürzeste Lebensdauer zuerst</option>
            <option value="longest">Längste Lebensdauer zuerst</option>
            <option value="alphabetical">A–Z</option>
            <option value="recently-added">Zuletzt hinzugefügt</option>
          </select>
        </label>

        <label>
          <span class="control-label">Gruppieren nach</span>
          <select class="group-select">
            <option value="status">Status</option>
            <option value="century">Jahrhundert der Änderung</option>
            <option value="none">Keine Gruppierung</option>
          </select>
        </label>

        <div class="view-toggle" aria-label="Eintragsansicht">
          <button class="view-button is-active" type="button" data-view="cards" aria-pressed="true">Karten</button>
          <button class="view-button" type="button" data-view="compact" aria-pressed="false">Kompakt</button>
        </div>

        <button class="clear-controls" type="button">Filter zurücksetzen</button>
      </div>

      <p class="results-summary" aria-live="polite">Alle {entries.length} Einträge werden angezeigt</p>

      <div class="category-list" data-view="cards">
        {sortedItems.map(({ entry, translation }) => {
          const comparable = entry.data.lifespanComparable !== false;
          return (
            <div
              class="entry-wrapper"
              data-entry-id={entry.id}
              data-status={entry.data.status}
              data-timeline-year={entry.data.timelineYear}
              data-century={centuryLabelDe(entry.data.timelineYear)}
              data-century-order={entry.data.timelineYear}
              data-lifespan={comparable ? lifespanYears(entry.data.acceptedYear, entry.data.timelineYear) : ''}
              data-comparable={String(comparable)}
              data-published-at={entry.data.publishedAt.getTime()}
              data-claim={translation.data.claim}
              data-search={`${translation.data.claim} ${translation.data.currentUnderstanding} ${translation.data.summary} ${statusLabel(entry.data.status, 'de')} ${translation.data.changedApproximately}`.toLocaleLowerCase('de')}
            >
              <div class="card-view"><FactCard entry={entry} translation={translation} locale="de" /></div>
              <div class="compact-view"><CompactClaim entry={entry} translation={translation} locale="de" /></div>
            </div>
          );
        })}
      </div>

      <div class="empty-state" hidden>
        <p>Keine Einträge entsprechen diesen Filtern.</p>
        <button class="empty-clear" type="button">Alle Einträge in {categoryName} anzeigen</button>
      </div>

      <noscript>
        <p class="noscript-note">
          Filter, Gruppierung, Sortierung und die Kompaktansicht benötigen JavaScript. Ohne JavaScript werden die Einträge nach der neuesten Änderung sortiert angezeigt.
        </p>
      </noscript>
    </div>
  </section>

  <script>
    const searchInput = document.querySelector<HTMLInputElement>('.category-search');
    const lifespanFilter = document.querySelector<HTMLSelectElement>('.lifespan-filter');
    const sortSelect = document.querySelector<HTMLSelectElement>('.sort-select');
    const groupSelect = document.querySelector<HTMLSelectElement>('.group-select');
    const list = document.querySelector<HTMLElement>('.category-list');
    const resultsSummary = document.querySelector<HTMLElement>('.results-summary');
    const emptyState = document.querySelector<HTMLElement>('.empty-state');
    const clearButton = document.querySelector<HTMLButtonElement>('.clear-controls');
    const emptyClear = document.querySelector<HTMLButtonElement>('.empty-clear');
    const statusButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.status-breakdown-button')
    );
    const viewButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.view-button')
    );
    const wrappers = Array.from(
      document.querySelectorAll<HTMLElement>('.entry-wrapper')
    );

    type SortMode = 'newest' | 'oldest' | 'shortest' | 'longest' | 'alphabetical' | 'recently-added';
    type GroupMode = 'status' | 'century' | 'none';
    type ViewMode = 'cards' | 'compact';

    let selectedStatus = '';
    let currentSort: SortMode = 'newest';
    let currentGroup: GroupMode = 'status';
    let currentView: ViewMode = 'cards';

    const compareEntries = (a: HTMLElement, b: HTMLElement) => {
      const yearA = Number(a.dataset.timelineYear ?? 0);
      const yearB = Number(b.dataset.timelineYear ?? 0);
      const claimA = a.dataset.claim ?? '';
      const claimB = b.dataset.claim ?? '';
      const comparableA = a.dataset.comparable === 'true';
      const comparableB = b.dataset.comparable === 'true';
      const lifespanA = comparableA ? Number(a.dataset.lifespan ?? 0) : 0;
      const lifespanB = comparableB ? Number(b.dataset.lifespan ?? 0) : 0;
      const publishedA = Number(a.dataset.publishedAt ?? 0);
      const publishedB = Number(b.dataset.publishedAt ?? 0);

      if (currentSort === 'oldest') return yearA - yearB || claimA.localeCompare(claimB, 'de', { sensitivity: 'base' });
      if (currentSort === 'shortest') {
        if (comparableA !== comparableB) return comparableA ? -1 : 1;
        return lifespanA - lifespanB || yearA - yearB || claimA.localeCompare(claimB, 'de', { sensitivity: 'base' });
      }
      if (currentSort === 'longest') {
        if (comparableA !== comparableB) return comparableA ? -1 : 1;
        return lifespanB - lifespanA || yearB - yearA || claimA.localeCompare(claimB, 'de', { sensitivity: 'base' });
      }
      if (currentSort === 'alphabetical') return claimA.localeCompare(claimB, 'de', { sensitivity: 'base' });
      if (currentSort === 'recently-added') return publishedB - publishedA || claimA.localeCompare(claimB, 'de', { sensitivity: 'base' });
      return yearB - yearA || claimA.localeCompare(claimB, 'de', { sensitivity: 'base' });
    };

    const groupLabel = (wrapper: HTMLElement) => {
      if (currentGroup === 'status') {
        const raw = wrapper.dataset.status ?? 'Other';
        const button = statusButtons.find((candidate) => candidate.dataset.status === raw);
        return button?.querySelector('span')?.textContent ?? raw;
      }
      if (currentGroup === 'century') return wrapper.dataset.century ?? 'Other';
      return '';
    };

    const groupOrder = (a: string, b: string, visible: HTMLElement[]) => {
      if (currentGroup === 'status') {
        const countA = visible.filter((item) => groupLabel(item) === a).length;
        const countB = visible.filter((item) => groupLabel(item) === b).length;
        return countB - countA || a.localeCompare(b);
      }

      if (currentGroup === 'century') {
        const yearFor = (label: string) =>
          Math.max(
            ...visible
              .filter((item) => groupLabel(item) === label)
              .map((item) => Number(item.dataset.centuryOrder ?? 0))
          );
        return yearFor(b) - yearFor(a);
      }

      return 0;
    };

    const renderList = (visible: HTMLElement[]) => {
      if (!list) return;
      list.replaceChildren();

      const sorted = [...visible].sort(compareEntries);

      if (currentGroup === 'none') {
        const grid = document.createElement('div');
        grid.className = 'entry-grid';
        sorted.forEach((wrapper) => grid.append(wrapper));
        list.append(grid);
        return;
      }

      const labels = [...new Set(sorted.map(groupLabel))].sort((a, b) => groupOrder(a, b, sorted));

      labels.forEach((label) => {
        const section = document.createElement('section');
        section.className = 'entry-group';

        const heading = document.createElement('div');
        heading.className = 'group-heading';

        const title = document.createElement('h3');
        title.textContent = label;

        const count = document.createElement('span');
        const groupEntries = sorted.filter((wrapper) => groupLabel(wrapper) === label);
        count.textContent = `${groupEntries.length} ${groupEntries.length === 1 ? 'Eintrag' : 'Einträge'}`;

        heading.append(title, count);

        const grid = document.createElement('div');
        grid.className = 'entry-grid';
        groupEntries.forEach((wrapper) => grid.append(wrapper));

        section.append(heading, grid);
        list.append(section);
      });
    };

    const updateURL = () => {
      const url = new URL(window.location.href);
      const query = searchInput?.value.trim() ?? '';
      const lifespan = lifespanFilter?.value ?? '';

      query ? url.searchParams.set('q', query) : url.searchParams.delete('q');
      selectedStatus ? url.searchParams.set('status', selectedStatus) : url.searchParams.delete('status');
      lifespan ? url.searchParams.set('lifespan', lifespan) : url.searchParams.delete('lifespan');
      currentSort !== 'newest' ? url.searchParams.set('sort', currentSort) : url.searchParams.delete('sort');
      currentGroup !== 'status' ? url.searchParams.set('group', currentGroup) : url.searchParams.delete('group');
      currentView !== 'cards' ? url.searchParams.set('view', currentView) : url.searchParams.delete('view');

      window.history.replaceState({}, '', url);
    };

    const updateDisplay = () => {
      const query = searchInput?.value.trim().toLocaleLowerCase('de') ?? '';
      const lifespan = lifespanFilter?.value ?? '';

      const visible = wrappers.filter((wrapper) => {
        const searchMatch = !query || (wrapper.dataset.search ?? '').includes(query);
        const statusMatch = !selectedStatus || wrapper.dataset.status === selectedStatus;
        const comparable = wrapper.dataset.comparable === 'true';
        const lifespanMatch =
          !lifespan ||
          (lifespan === 'quantified' && comparable) ||
          (lifespan === 'unquantified' && !comparable);

        return searchMatch && statusMatch && lifespanMatch;
      });

      wrappers.forEach((wrapper) => {
        wrapper.hidden = !visible.includes(wrapper);
      });

      statusButtons.forEach((button) => {
        const active = button.dataset.status === selectedStatus;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });

      if (list) list.dataset.view = currentView;

      if (resultsSummary) {
        const filtered = query || selectedStatus || lifespan;
        resultsSummary.textContent = filtered
          ? `${visible.length} von ${wrappers.length} ${visible.length === 1 ? 'Eintrag' : 'Einträgen'} werden angezeigt`
          : `Alle ${wrappers.length} Einträge werden angezeigt`;
      }

      if (emptyState) emptyState.hidden = visible.length !== 0;

      renderList(visible);
      updateURL();
    };

    statusButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const status = button.dataset.status ?? '';
        selectedStatus = selectedStatus === status ? '' : status;
        updateDisplay();
      });
    });

    searchInput?.addEventListener('input', updateDisplay);
    lifespanFilter?.addEventListener('change', updateDisplay);

    sortSelect?.addEventListener('change', () => {
      const value = sortSelect.value;
      if (
        value === 'newest' ||
        value === 'oldest' ||
        value === 'shortest' ||
        value === 'longest' ||
        value === 'alphabetical' ||
        value === 'recently-added'
      ) {
        currentSort = value;
        updateDisplay();
      }
    });

    groupSelect?.addEventListener('change', () => {
      const value = groupSelect.value;
      if (value === 'status' || value === 'century' || value === 'none') {
        currentGroup = value;
        updateDisplay();
      }
    });

    viewButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const value = button.dataset.view;
        if (value !== 'cards' && value !== 'compact') return;
        currentView = value;
        viewButtons.forEach((candidate) => {
          const active = candidate.dataset.view === currentView;
          candidate.classList.toggle('is-active', active);
          candidate.setAttribute('aria-pressed', String(active));
        });
        updateDisplay();
      });
    });

    const clearControls = () => {
      selectedStatus = '';
      if (searchInput) searchInput.value = '';
      if (lifespanFilter) lifespanFilter.value = '';
      currentSort = 'newest';
      currentGroup = 'status';
      if (sortSelect) sortSelect.value = currentSort;
      if (groupSelect) groupSelect.value = currentGroup;
      updateDisplay();
    };

    clearButton?.addEventListener('click', clearControls);
    emptyClear?.addEventListener('click', clearControls);

    const url = new URL(window.location.href);
    if (searchInput) searchInput.value = url.searchParams.get('q') ?? '';

    const requestedStatus = url.searchParams.get('status') ?? '';
    if (statusButtons.some((button) => button.dataset.status === requestedStatus)) {
      selectedStatus = requestedStatus;
    }

    const requestedLifespan = url.searchParams.get('lifespan');
    if (
      lifespanFilter &&
      (requestedLifespan === 'quantified' || requestedLifespan === 'unquantified')
    ) {
      lifespanFilter.value = requestedLifespan;
    }

    const requestedSort = url.searchParams.get('sort');
    if (
      requestedSort === 'oldest' ||
      requestedSort === 'shortest' ||
      requestedSort === 'longest' ||
      requestedSort === 'alphabetical' ||
      requestedSort === 'recently-added'
    ) {
      currentSort = requestedSort;
    }

    const requestedGroup = url.searchParams.get('group');
    if (requestedGroup === 'century' || requestedGroup === 'none') {
      currentGroup = requestedGroup;
    }

    currentView = url.searchParams.get('view') === 'compact' ? 'compact' : 'cards';

    if (sortSelect) sortSelect.value = currentSort;
    if (groupSelect) groupSelect.value = currentGroup;
    viewButtons.forEach((button) => {
      const active = button.dataset.view === currentView;
      button.classList.toggle('is-active', active);
      button.setAttribute('aria-pressed', String(active));
    });

    updateDisplay();
  </script>
</BaseLayout>

<style>
  .page-head { padding: 5rem 0 2rem; }
  .page-head h1 { margin: .2rem 0 1rem; }
  .page-intro { max-width: 62rem; color: var(--muted); font-size: 1.15rem; }

  .overview { padding-bottom: 4rem; }
  .section-heading { margin-bottom: 1.5rem; }
  .section-heading h2 { margin: .2rem 0 0; }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: .9rem;
  }
  .stats-grid article {
    min-width: 0;
    padding: 1.1rem;
    border: 1px solid var(--line);
    background: var(--card);
  }
  .stats-grid article > span {
    display: block;
    color: var(--muted);
    font-size: .76rem;
    font-weight: 850;
    letter-spacing: .07em;
    text-transform: uppercase;
  }
  .stats-grid strong {
    display: block;
    margin-top: .3rem;
    font-size: clamp(1.35rem, 2.8vw, 2rem);
    line-height: 1.15;
  }
  .stats-grid small {
    display: block;
    margin-top: .45rem;
    color: var(--muted);
    line-height: 1.35;
  }

  .status-breakdown {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: .65rem;
    margin-top: .9rem;
  }
  .status-breakdown-button {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: .4rem .75rem;
    min-height: 3.25rem;
    padding: .7rem .8rem;
    border: 1px solid var(--line);
    color: var(--ink);
    background: var(--paper);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  .status-breakdown-button span { font-weight: 800; }
  .status-breakdown-button strong { font-variant-numeric: tabular-nums; }
  .status-breakdown-button i {
    grid-column: 1 / -1;
    height: .25rem;
    background:
      linear-gradient(
        90deg,
        var(--accent) 0 var(--status-share),
        color-mix(in srgb, var(--line) 72%, transparent) var(--status-share) 100%
      );
  }
  .status-breakdown-button:hover,
  .status-breakdown-button:focus-visible,
  .status-breakdown-button.is-active {
    border-color: var(--accent-dark);
  }
  .status-breakdown-button.is-active {
    background: color-mix(in srgb, var(--accent) 9%, var(--card));
  }

  .category-explorer {
    padding: 4rem 0 5rem;
    border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--card) 35%, transparent);
  }
  .explorer-heading p:last-child { max-width: 62rem; margin-bottom: 0; color: var(--muted); }

  .controls {
    display: grid;
    grid-template-columns: minmax(14rem, 1fr) repeat(3, auto) auto auto;
    gap: .65rem;
    align-items: end;
    padding: .8rem;
    border: 1px solid var(--line);
    background: var(--card);
  }
  .controls label { display: flex; flex-direction: column; gap: .3rem; }
  .control-label {
    color: var(--muted);
    font-size: .72rem;
    font-weight: 850;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .controls input,
  .controls select {
    min-height: 2.75rem;
    width: 100%;
    border: 1px solid var(--line);
    border-radius: .55rem;
    padding: .58rem .72rem;
    color: var(--ink);
    background: var(--paper);
    font: inherit;
  }
  .controls select { cursor: pointer; }

  .view-toggle {
    display: inline-flex;
    min-height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    overflow: hidden;
  }
  .view-button {
    border: 0;
    padding: .55rem .75rem;
    color: var(--muted);
    background: transparent;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }
  .view-button.is-active { color: white; background: var(--ink); }

  .clear-controls {
    min-height: 2.75rem;
    border: 0;
    padding: .55rem .7rem;
    color: var(--accent-dark);
    background: transparent;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }
  .clear-controls:hover,
  .clear-controls:focus-visible { text-decoration: underline; }

  .results-summary { margin: 1rem 0 1.5rem; color: var(--muted); }

  .category-list { display: grid; gap: 2.5rem; }
  :global(.entry-group) { display: grid; gap: 1rem; }
  :global(.group-heading) {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    padding-bottom: .55rem;
