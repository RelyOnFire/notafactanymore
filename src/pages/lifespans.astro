---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  centuryNumber,
  formatApproxYears,
  formatHistoricalYear,
  lifespanYears,
  median,
  ordinal,
} from '../lib/lifespans';

const entries = await getCollection('entries');
const comparableEntries = entries.filter((entry) => entry.data.lifespanComparable !== false);
const nonComparableEntries = entries.filter((entry) => entry.data.lifespanComparable === false);

const records = comparableEntries.map((entry) => {
  const lifespan = lifespanYears(entry.data.acceptedYear, entry.data.timelineYear);

  return {
    entry,
    acceptedYear: entry.data.acceptedYear,
    changedYear: entry.data.timelineYear,
    lifespan,
  };
});

const byShortest = [...records].sort(
  (a, b) =>
    a.lifespan - b.lifespan ||
    a.changedYear - b.changedYear ||
    a.entry.data.claim.localeCompare(b.entry.data.claim),
);

const byLongest = [...records].sort(
  (a, b) =>
    b.lifespan - a.lifespan ||
    b.changedYear - a.changedYear ||
    a.entry.data.claim.localeCompare(b.entry.data.claim),
);

const shortest = byShortest.slice(0, 5);
const longest = byLongest.slice(0, 5);
const overallMedian = median(records.map((record) => record.lifespan));

const categories = [
  ...new Set(comparableEntries.map((entry) => entry.data.category)),
].sort();

const statuses = [
  ...new Set(comparableEntries.map((entry) => entry.data.status)),
].sort();

const categoryStats = categories
  .map((category) => {
    const values = records
      .filter((record) => record.entry.data.category === category)
      .map((record) => record.lifespan)
      .sort((a, b) => a - b);

    return {
      category,
      count: values.length,
      median: median(values),
      min: values[0] ?? 0,
      max: values.at(-1) ?? 0,
    };
  })
  .sort((a, b) => a.median - b.median || a.category.localeCompare(b.category));

const comparisonCategoryStats = [...categoryStats].sort((a, b) =>
  a.category.localeCompare(b.category),
);

const lifespanBands = [
  { key: 'under25', label: '<25 years', test: (years: number) => years < 25 },
  { key: '25to49', label: '25–49 years', test: (years: number) => years >= 25 && years < 50 },
  { key: '50to99', label: '50–99 years', test: (years: number) => years >= 50 && years < 100 },
  { key: '100to249', label: '100–249 years', test: (years: number) => years >= 100 && years < 250 },
  { key: '250plus', label: '250+ years', test: (years: number) => years >= 250 },
];

const centuries = [
  ...new Set(records.map((record) => centuryNumber(record.changedYear))),
]
  .filter((century) => century > 0)
  .sort((a, b) => a - b);

const centuryStats = centuries.map((century) => {
  const group = records.filter(
    (record) => centuryNumber(record.changedYear) === century,
  );

  return {
    century,
    label: `${ordinal(century)} century`,
    count: group.length,
    median: median(group.map((record) => record.lifespan)),
    bands: lifespanBands.map((band) => ({
      ...band,
      count: group.filter((record) => band.test(record.lifespan)).length,
    })),
  };
});

const defaultComparisonA =
  categoryStats.find((item) => item.category === 'Medicine') ?? categoryStats[0];

const defaultComparisonB =
  categoryStats.find((item) => item.category === 'Astronomy') ??
  categoryStats.find((item) => item.category !== defaultComparisonA?.category);

const comparisonReady = Boolean(defaultComparisonA && defaultComparisonB);

const formatCategoryDetail = (item: (typeof categoryStats)[number]) =>
  item.count === 1
    ? '1 entry · observed range not shown'
    : `${item.count} entries · range ${formatApproxYears(item.min)} to ${formatApproxYears(item.max)}`;

const initialComparisonResult =
  defaultComparisonA && defaultComparisonB
    ? defaultComparisonA.median === defaultComparisonB.median
      ? 'Their medians are the same in this catalogue.'
      : `${defaultComparisonA.median < defaultComparisonB.median ? defaultComparisonA.category : defaultComparisonB.category} is ${formatApproxYears(Math.abs(defaultComparisonA.median - defaultComparisonB.median))} shorter at the median in this catalogue.`
    : '';

const DISPLAY_CAP = 250;
---
<BaseLayout
  title="Lifespans"
  description="Explore how long formerly accepted scientific and scholarly claims persisted before representative corrections, revisions, or reclassifications."
>
  <header class="page-head container">
    <p class="eyebrow">How long did a fact last?</p>
    <h1>Lifespans of accepted claims</h1>
    <p>
      Compare the approximate span between a claim becoming established and the
      representative point when stronger evidence changed the record.
    </p>
  </header>

  <section class="container stats-grid" aria-label="Lifespan summary">
    <article>
      <span>Catalogue median</span>
      <strong>{formatApproxYears(overallMedian)}</strong>
      <small>Across {records.length} quantitatively comparable entries</small>
    </article>
    <article>
      <span>Shortest span</span>
      <strong>{formatApproxYears(shortest[0]?.lifespan ?? 0)}</strong>
      <small>{shortest[0]?.entry.data.claim}</small>
    </article>
    <article>
      <span>Longest span</span>
      <strong>{formatApproxYears(longest[0]?.lifespan ?? 0)}</strong>
      <small>{longest[0]?.entry.data.claim}</small>
    </article>
    <article>
      <span>Categories measured</span>
      <strong>{categoryStats.length}</strong>
      <small>Descriptive of this catalogue</small>
    </article>
  </section>

  <section class="container methodology-note">
    <p>
      <strong>These durations are approximate.</strong> Each quantitatively comparable entry keeps its
      human-readable historical ranges, while <code>acceptedYear</code>{' '}and{' '}<code>timelineYear</code>{' '}provide representative landmarks for ordering
      and comparison. A field or classroom can continue using an older view
      after contrary evidence appears, so these numbers are not exact dates of
      universal consensus. {nonComparableEntries.length} entries are deliberately excluded from
      lifespan statistics because their acceptance boundary is too diffuse, their historical
      wording spans competing traditions, or a precise numerical duration would create false
      precision. Category comparisons describe this curated catalogue, not turnover rates for
      whole scientific fields.
    </p>
  </section>

  <section class="container extremes">
    <div class="section-heading">
      <div>
        <p class="eyebrow">The extremes</p>
        <h2>Shortest- and longest-lived claims</h2>
      </div>
    </div>

    <div class="extreme-columns">
      <section>
        <h3>Shortest-lived</h3>
        <ol class="ranked-list">
          {shortest.map((record) => (
            <li>
              <a href={`/entries/${record.entry.id}/`}>
                <strong>{record.entry.data.claim}</strong>
                <span>
                  {formatHistoricalYear(record.acceptedYear)} → {formatHistoricalYear(record.changedYear)}
                  {' · '}
                  {record.entry.data.category}
                </span>
              </a>
              <span class="duration-badge">{formatApproxYears(record.lifespan)}</span>
            </li>
          ))}
        </ol>
      </section>

      <section>
        <h3>Longest-lived</h3>
        <ol class="ranked-list">
          {longest.map((record) => (
            <li>
              <a href={`/entries/${record.entry.id}/`}>
                <strong>{record.entry.data.claim}</strong>
                <span>
                  {formatHistoricalYear(record.acceptedYear)} → {formatHistoricalYear(record.changedYear)}
                  {' · '}
                  {record.entry.data.category}
                </span>
              </a>
              <span class="duration-badge">{formatApproxYears(record.lifespan)}</span>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </section>

  {comparisonReady && defaultComparisonA && defaultComparisonB && (
    <section class="comparison-section">
      <div class="container">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Compare categories</p>
            <h2 class="comparison-heading">{defaultComparisonA.category} vs {defaultComparisonB.category}</h2>
            <p class="section-intro">
              Choose any two subjects to compare their entries in this catalogue.
            </p>
          </div>
        </div>

        <div class="comparison-controls" aria-label="Category comparison controls">
          <label>
            <span>First category</span>
            <select class="comparison-select comparison-select-a">
              {comparisonCategoryStats.map((item) => (
                <option
                  value={item.category}
                  selected={item.category === defaultComparisonA.category}
                  data-count={item.count}
                  data-median={item.median}
                  data-min={item.min}
                  data-max={item.max}
                >
                  {item.category}
                </option>
              ))}
            </select>
          </label>

          <label>
            <span>Second category</span>
            <select class="comparison-select comparison-select-b">
              {comparisonCategoryStats.map((item) => (
                <option
                  value={item.category}
                  selected={item.category === defaultComparisonB.category}
                  data-count={item.count}
                  data-median={item.median}
                  data-min={item.min}
                  data-max={item.max}
                >
                  {item.category}
                </option>
              ))}
            </select>
          </label>
        </div>

        <div class="comparison-grid">
          <article class="comparison-card-a">
            <span class="comparison-category">{defaultComparisonA.category}</span>
            <strong class="comparison-median">{formatApproxYears(defaultComparisonA.median)}</strong>
            <small class="comparison-detail">{formatCategoryDetail(defaultComparisonA)}</small>
          </article>
          <article class="comparison-card-b">
            <span class="comparison-category">{defaultComparisonB.category}</span>
            <strong class="comparison-median">{formatApproxYears(defaultComparisonB.median)}</strong>
            <small class="comparison-detail">{formatCategoryDetail(defaultComparisonB)}</small>
          </article>
        </div>

        <p class="comparison-result" aria-live="polite">{initialComparisonResult}</p>
      </div>
    </section>
  )}

  <section class="container category-section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">By subject</p>
        <h2>Median lifespan by category</h2>
        <p class="section-intro">
          Sorted from the shortest median to the longest. Small categories can
          move sharply when a single entry is added, so the entry count is
          shown alongside each median.
        </p>
      </div>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Category</th>
            <th scope="col">Entries</th>
            <th scope="col">Median lifespan</th>
            <th scope="col">Observed range</th>
          </tr>
        </thead>
        <tbody>
          {categoryStats.map((item) => (
            <tr>
              <th scope="row">{item.category}</th>
              <td>{item.count}</td>
              <td>{formatApproxYears(item.median)}</td>
              <td>
                {item.count === 1
                  ? <span class="range-unavailable" title="Observed range requires at least two entries" aria-label="Observed range unavailable">—</span>
                  : <>{formatApproxYears(item.min)} – {formatApproxYears(item.max)}</>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="century-section">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Across time</p>
          <h2>Lifespan distributions by century of change</h2>
          <p class="section-intro">
            Each row groups entries by the century containing their representative
            change year, then shows how those lifespans are distributed.
          </p>
        </div>
      </div>

      <div class="band-legend" aria-label="Lifespan bands">
        {lifespanBands.map((band) => (
          <span><i class={`legend-swatch band-${band.key}`} aria-hidden="true"></i>{band.label}</span>
        ))}
      </div>

      <div class="century-list">
        {centuryStats.map((item) => (
          <article class="century-row">
            <div class="century-meta">
              <strong>{item.label}</strong>
              <span>{item.count} {item.count === 1 ? 'entry' : 'entries'} · median {formatApproxYears(item.median)}</span>
            </div>

            <div class="distribution-bar" aria-hidden="true">
              {item.bands.map((band) =>
                band.count > 0 && (
                  <span
                    class={`distribution-segment band-${band.key}`}
                    style={`width: ${(band.count / item.count) * 100}%`}
                    title={`${band.label}: ${band.count}`}
                  ></span>
                )
              )}
            </div>

            <div class="century-counts">
              {item.bands.filter((band) => band.count > 0).map((band) => (
                <span>{band.label}: <strong>{band.count}</strong></span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="container explorer">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Explore every lifespan</p>
        <h2>Acceptance → change</h2>
        <p class="section-intro">
          Search the catalogue and sort it from the shortest-lived claims to
          the longest. The explorer starts with Chemistry as a manageable sample;
          choose All categories to see the full catalogue. Bar length represents
          lifespan and is capped at{' '}{DISPLAY_CAP}{' '}years so modern short-lived
          claims remain visible; the printed dates and duration always show the
          full approximate span.
        </p>
      </div>
    </div>

    <div class="lifespan-controls" aria-label="Lifespan explorer controls">
      <label>
        <span class="sr-only">Search claims</span>
        <input
          class="lifespan-search"
          type="search"
          placeholder="Search claims…"
          autocomplete="off"
        />
      </label>

      <label>
        <span class="sr-only">Filter by category</span>
        <select class="category-select">
          <option value="">All categories</option>
          {categories.map((category) => <option value={category}>{category}</option>)}
        </select>
      </label>

      <label>
        <span class="sr-only">Filter by status</span>
        <select class="status-select">
          <option value="">All statuses</option>
          {statuses.map((status) => <option value={status}>{status}</option>)}
        </select>
      </label>

      <label>
        <span class="sr-only">Sort lifespans</span>
        <select class="lifespan-sort">
          <option value="shortest">Shortest-lived first</option>
          <option value="longest">Longest-lived first</option>
          <option value="newest">Newest change first</option>
          <option value="oldest">Oldest change first</option>
        </select>
      </label>
    </div>

    <p class="lifespan-results" aria-live="polite">Showing all {records.length} entries</p>

    <div class="lifespan-list">
      {byShortest.map((record) => {
        const displayWidth = Math.max(
          4,
          Math.min(record.lifespan, DISPLAY_CAP) / DISPLAY_CAP * 100,
        );

        return (
          <article
            class="lifespan-entry"
            data-entry-id={record.entry.id}
            data-category={record.entry.data.category}
            data-status={record.entry.data.status}
            data-lifespan={record.lifespan}
            data-accepted-year={record.acceptedYear}
            data-changed-year={record.changedYear}
            data-claim={record.entry.data.claim}
            data-search={`${record.entry.data.claim} ${record.entry.data.category} ${record.entry.data.status} ${record.entry.data.summary} ${record.entry.data.acceptedApproximately} ${record.entry.data.changedApproximately}`.toLowerCase()}
          >
            <div class="entry-copy">
              <h3><a href={`/entries/${record.entry.id}/`}>{record.entry.data.claim}</a></h3>
              <p>{record.entry.data.category} · {record.entry.data.status}</p>
            </div>

            <div class="lifespan-visual">
              <div class="range-label">
                <span><strong>{formatHistoricalYear(record.acceptedYear)}</strong><small>accepted</small></span>
                <span aria-hidden="true">→</span>
                <span><strong>{formatHistoricalYear(record.changedYear)}</strong><small>changed</small></span>
              </div>

              <div class="range-track" aria-hidden="true">
                <span
                  class:list={['range-fill', { capped: record.lifespan > DISPLAY_CAP }]}
                  style={`--span-width: ${displayWidth}%`}
                >
                  <i class="start-dot"></i>
                  <i class="end-dot"></i>
                </span>
              </div>

              <span class="duration-badge">{formatApproxYears(record.lifespan)}</span>
            </div>
          </article>
        );
      })}
    </div>

    <div class="lifespan-empty" hidden>
      <p>No entries match those filters.</p>
      <button class="lifespan-clear" type="button">Clear filters</button>
    </div>

    <noscript>
      <p class="noscript-note">
        Search, filtering, and sorting require JavaScript. Entries are shown
        shortest-lived first.
      </p>
    </noscript>
  </section>

  {nonComparableEntries.length > 0 && (
    <section class="container noncomparable-section">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Kept out of the rankings</p>
          <h2>Entries not assigned a quantitative lifespan</h2>
          <p class="section-intro">
            These remain part of the catalogue, but their acceptance boundary is too diffuse, contested, or historically mixed for a defensible single-number lifespan.
          </p>
        </div>
      </div>
      <div class="noncomparable-list">
        {nonComparableEntries
          .sort((a, b) => a.data.claim.localeCompare(b.data.claim))
          .map((entry) => (
            <a href={`/entries/${entry.id}/`}>
              <strong>{entry.data.claim}</strong>
              <span>{entry.data.acceptedApproximately} → {entry.data.changedApproximately}</span>
            </a>
          ))}
      </div>
    </section>
  )}

  

  <script>
    const comparisonSelectA = document.querySelector<HTMLSelectElement>('.comparison-select-a');
    const comparisonSelectB = document.querySelector<HTMLSelectElement>('.comparison-select-b');
    const comparisonHeading = document.querySelector<HTMLElement>('.comparison-heading');
    const comparisonCardA = document.querySelector<HTMLElement>('.comparison-card-a');
    const comparisonCardB = document.querySelector<HTMLElement>('.comparison-card-b');
    const comparisonResult = document.querySelector<HTMLElement>('.comparison-result');

    type ComparisonStat = {
      category: string;
      count: number;
      median: number;
      min: number;
      max: number;
    };

    const formatApproxYearsClient = (years: number) => {
      const rounded = Number.isInteger(years) ? years : Math.round(years * 10) / 10;
      return `≈${rounded.toLocaleString('en-US')} ${rounded === 1 ? 'year' : 'years'}`;
    };

    const getComparisonStat = (select: HTMLSelectElement): ComparisonStat | null => {
      const option = select.options[select.selectedIndex];
      if (!option) return null;

      return {
        category: option.value,
        count: Number(option.dataset.count ?? 0),
        median: Number(option.dataset.median ?? 0),
        min: Number(option.dataset.min ?? 0),
        max: Number(option.dataset.max ?? 0),
      };
    };

    const formatComparisonDetail = (stat: ComparisonStat) =>
      stat.count === 1
        ? '1 entry · observed range not shown'
        : `${stat.count} entries · range ${formatApproxYearsClient(stat.min)} to ${formatApproxYearsClient(stat.max)}`;

    const updateComparisonCard = (card: HTMLElement | null, stat: ComparisonStat) => {
      if (!card) return;

      const category = card.querySelector<HTMLElement>('.comparison-category');
      const medianValue = card.querySelector<HTMLElement>('.comparison-median');
      const detail = card.querySelector<HTMLElement>('.comparison-detail');

      if (category) category.textContent = stat.category;
      if (medianValue) medianValue.textContent = formatApproxYearsClient(stat.median);
      if (detail) detail.textContent = formatComparisonDetail(stat);
    };

    const keepComparisonDistinct = (
      changed: HTMLSelectElement,
      other: HTMLSelectElement,
    ) => {
      if (changed.value !== other.value) return;

      const replacement = [...other.options].find(
        (option) => option.value !== changed.value,
      );

      if (replacement) other.value = replacement.value;
    };

    const updateComparison = () => {
      if (!comparisonSelectA || !comparisonSelectB) return;

      const statA = getComparisonStat(comparisonSelectA);
      const statB = getComparisonStat(comparisonSelectB);
      if (!statA || !statB) return;

      if (comparisonHeading) {
        comparisonHeading.textContent = `${statA.category} vs ${statB.category}`;
      }

      updateComparisonCard(comparisonCardA, statA);
      updateComparisonCard(comparisonCardB, statB);

      if (comparisonResult) {
        if (statA.median === statB.median) {
          comparisonResult.textContent = 'Their medians are the same in this catalogue.';
        } else {
          const shorter = statA.median < statB.median ? statA : statB;
          const difference = Math.abs(statA.median - statB.median);
          comparisonResult.textContent =
            `${shorter.category} is ${formatApproxYearsClient(difference)} shorter at the median in this catalogue.`;
        }
      }
    };

    comparisonSelectA?.addEventListener('change', () => {
      if (comparisonSelectB) keepComparisonDistinct(comparisonSelectA, comparisonSelectB);
      updateComparison();
    });

    comparisonSelectB?.addEventListener('change', () => {
      if (comparisonSelectA) keepComparisonDistinct(comparisonSelectB, comparisonSelectA);
      updateComparison();
    });

    const searchInput = document.querySelector<HTMLInputElement>('.lifespan-search');
    const categorySelect = document.querySelector<HTMLSelectElement>('.category-select');
    const statusSelect = document.querySelector<HTMLSelectElement>('.status-select');
    const sortSelect = document.querySelector<HTMLSelectElement>('.lifespan-sort');
    const list = document.querySelector<HTMLElement>('.lifespan-list');
    const results = document.querySelector<HTMLElement>('.lifespan-results');
    const emptyState = document.querySelector<HTMLElement>('.lifespan-empty');
    const clearButton = document.querySelector<HTMLButtonElement>('.lifespan-clear');

    const rows = Array.from(
      document.querySelectorAll<HTMLElement>('.lifespan-entry')
    );

    type LifespanSort = 'shortest' | 'longest' | 'newest' | 'oldest';
    let currentSort: LifespanSort = 'shortest';

    const compareRows = (a: HTMLElement, b: HTMLElement) => {
      const lifespanA = Number(a.dataset.lifespan ?? 0);
      const lifespanB = Number(b.dataset.lifespan ?? 0);
      const changedA = Number(a.dataset.changedYear ?? 0);
      const changedB = Number(b.dataset.changedYear ?? 0);
      const claimA = a.dataset.claim ?? '';
      const claimB = b.dataset.claim ?? '';

      if (currentSort === 'longest') {
        return lifespanB - lifespanA || changedB - changedA || claimA.localeCompare(claimB);
      }

      if (currentSort === 'newest') {
        return changedB - changedA || lifespanA - lifespanB || claimA.localeCompare(claimB);
      }

      if (currentSort === 'oldest') {
        return changedA - changedB || lifespanA - lifespanB || claimA.localeCompare(claimB);
      }

      return lifespanA - lifespanB || changedA - changedB || claimA.localeCompare(claimB);
    };

    const updateURL = () => {
      const url = new URL(window.location.href);
      const query = searchInput?.value.trim() ?? '';
      const category = categorySelect?.value ?? '';
      const status = statusSelect?.value ?? '';

      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');

      if (category) url.searchParams.set('category', category);
      else url.searchParams.delete('category');

      if (status) url.searchParams.set('status', status);
      else url.searchParams.delete('status');

      if (currentSort !== 'shortest') url.searchParams.set('sort', currentSort);
      else url.searchParams.delete('sort');

      window.history.replaceState({}, '', url);
    };

    const updateDisplay = () => {
      const query = searchInput?.value.trim().toLowerCase() ?? '';
      const category = categorySelect?.value ?? '';
      const status = statusSelect?.value ?? '';
      let visible = 0;

      rows.sort(compareRows).forEach((row) => {
        const matchesSearch = !query || (row.dataset.search ?? '').includes(query);
        const matchesCategory = !category || row.dataset.category === category;
        const matchesStatus = !status || row.dataset.status === status;
        const show = matchesSearch && matchesCategory && matchesStatus;

        row.hidden = !show;
        list?.append(row);

        if (show) visible += 1;
      });

      if (results) {
        const filtered = query || category || status;
        results.textContent = filtered
          ? `Showing ${visible} of ${rows.length} ${visible === 1 ? 'entry' : 'entries'}`
          : `Showing all ${rows.length} entries`;
      }

      if (emptyState) emptyState.hidden = visible !== 0;
      updateURL();
    };

    const url = new URL(window.location.href);
    const requestedSort = url.searchParams.get('sort');

    if (
      requestedSort === 'longest' ||
      requestedSort === 'newest' ||
      requestedSort === 'oldest'
    ) {
      currentSort = requestedSort;
    }

    if (searchInput) searchInput.value = url.searchParams.get('q') ?? '';

    const requestedCategory = url.searchParams.get('category');
    if (categorySelect) {
      if (
        requestedCategory &&
        [...categorySelect.options].some((option) => option.value === requestedCategory)
      ) {
        categorySelect.value = requestedCategory;
      } else if (
        !url.searchParams.has('q') &&
        !url.searchParams.has('status') &&
        !url.searchParams.has('sort') &&
        [...categorySelect.options].some((option) => option.value === 'Chemistry')
      ) {
        categorySelect.value = 'Chemistry';
      }
    }

    const requestedStatus = url.searchParams.get('status') ?? '';
    if (
      statusSelect &&
      [...statusSelect.options].some((option) => option.value === requestedStatus)
    ) {
      statusSelect.value = requestedStatus;
    }

    if (sortSelect) sortSelect.value = currentSort;

    clearButton?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (categorySelect) categorySelect.value = '';
      if (statusSelect) statusSelect.value = '';
      updateDisplay();
    });

    searchInput?.addEventListener('input', updateDisplay);
    categorySelect?.addEventListener('change', updateDisplay);
    statusSelect?.addEventListener('change', updateDisplay);
    sortSelect?.addEventListener('change', () => {
      const value = sortSelect.value;
      if (
        value === 'shortest' ||
        value === 'longest' ||
        value === 'newest' ||
        value === 'oldest'
      ) {
        currentSort = value;
        updateDisplay();
      }
    });

    updateDisplay();
  </script>
</BaseLayout>

