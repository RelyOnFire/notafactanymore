<button
  class="back-to-top"
  type="button"
  aria-label="Back to top"
  title="Back to top"
  tabindex="-1"
>
  <span class="back-to-top-arrow" aria-hidden="true">↑</span>
  <span class="back-to-top-label">Top</span>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('.back-to-top');

  if (button) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const updateVisibility = () => {
      const threshold = Math.max(650, window.innerHeight * 0.85);
      const visible = window.scrollY > threshold;

      button.classList.toggle('is-visible', visible);
      button.tabIndex = visible ? 0 : -1;
    };

    button.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: reduceMotion.matches ? 'auto' : 'smooth',
      });
    });

    window.addEventListener('scroll', updateVisibility, { passive: true });
    window.addEventListener('resize', updateVisibility, { passive: true });
    updateVisibility();
  }
</script>

<style>
  .back-to-top {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 18;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.8rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.55rem 0.85rem;
    color: white;
    background: var(--ink);
    box-shadow: 0 0.55rem 1.5rem rgb(30 24 13 / 18%);
    font: inherit;
    font-weight: 850;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.7rem);
    transition:
      opacity 150ms ease,
      transform 150ms ease,
      background 150ms ease;
  }

  .back-to-top.is-visible {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .back-to-top:hover,
  .back-to-top:focus-visible {
    background: var(--accent-dark);
  }

  .back-to-top:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--accent) 35%, transparent);
    outline-offset: 2px;
  }

  .back-to-top-arrow {
    font-size: 1.05rem;
    line-height: 1;
  }

  @media (max-width: 600px) {
    .back-to-top {
      width: 3rem;
      height: 3rem;
      min-height: 3rem;
      padding: 0;
    }

    .back-to-top-label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    .back-to-top-arrow {
      font-size: 1.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-to-top {
      transition: none;
    }
  }

  @media print {
    .back-to-top {
      display: none;
    }
  }
</style>
