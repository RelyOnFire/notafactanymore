---
interface TimelineTeaserItem {
  href: string;
  year: number | string;
  claim: string;
}

interface Props {
  items: TimelineTeaserItem[];
  surface?: 'paper' | 'card';
  dense?: boolean;
}

const { items, surface = 'paper', dense = false } = Astro.props;
---

<div class:list={['timeline-strip', `surface-${surface}`, { dense }]}>
  {items.map((item) => (
    <a class="timeline-point" href={item.href}>
      <span class="timeline-point-year">{item.year}</span>
      <span class="timeline-dot" aria-hidden="true"></span>
      <span class="timeline-point-claim">{item.claim}</span>
    </a>
  ))}
</div>

<style>
  .timeline-strip {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1rem;
    min-width: 0;
  }

  .timeline-strip::before {
    content: '';
    position: absolute;
    top: 2.775rem;
    left: calc((100% - 5rem) / 12);
    right: calc((100% - 5rem) / 12);
    height: 1px;
    background: var(--line);
  }

  .timeline-point {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: 1.35rem 0.85rem auto;
    justify-items: center;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
    padding: 0.45rem;
    color: inherit;
    text-align: center;
    text-decoration: none;
  }

  .timeline-point-year {
    line-height: 1;
    color: var(--accent-dark);
    font-weight: 900;
    font-variant-numeric: tabular-nums;
  }

  .timeline-dot {
    position: relative;
    z-index: 1;
    width: 0.85rem;
    height: 0.85rem;
    box-sizing: border-box;
    border: 3px solid var(--paper);
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 1px var(--accent);
  }

  .surface-card .timeline-dot {
    border-color: var(--card);
  }

  .timeline-point-claim {
    width: 100%;
    min-width: 0;
    max-width: 18ch;
    align-self: start;
    overflow-wrap: anywhere;
    hyphens: auto;
    text-wrap: pretty;
    padding-top: 0.15rem;
    font-size: 0.92rem;
    line-height: 1.35;
    font-weight: 750;
    transition: color 150ms ease;
  }

  .dense .timeline-point-year {
    font-size: 0.86rem;
  }

  .dense .timeline-point-claim {
    font-size: 0.88rem;
    font-weight: 700;
  }

  .timeline-point:hover .timeline-point-claim {
    color: var(--accent-dark);
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-point-claim {
      transition: none;
    }
  }

  @media (max-width: 900px) {
    .timeline-strip {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .timeline-strip::before {
      top: 0.75rem;
      bottom: 0.75rem;
      left: 5.175rem;
      right: auto;
      width: 1px;
      height: auto;
    }

    .timeline-point {
      grid-template-columns: 4rem 0.85rem minmax(0, 1fr);
      grid-template-rows: auto;
      justify-items: start;
      align-items: center;
      gap: 0.75rem;
      padding: 0.75rem 0;
      text-align: left;
    }

    .timeline-point-year {
      justify-self: end;
    }

    .timeline-point-claim {
      max-width: none;
      padding-top: 0;
    }
  }
</style>
