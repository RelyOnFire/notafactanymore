---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { categoryLabel, translationMatchesEntry } from '../../../lib/i18n';

const entries = await getCollection('entries');
const translations = await getCollection(
  'entryTranslations',
  (translation) => translation.data.locale === 'de',
);

const translatedEntries = entries.flatMap((entry) => {
  const translation = translations.find(
    (candidate) =>
      candidate.data.entryId === entry.id &&
      translationMatchesEntry(entry, candidate),
  );

  return translation ? [{ entry, translation }] : [];
});

const formatHistoricalYearDe = (year: number) =>
  year < 0 ? `${Math.abs(year)} v. Chr.` : String(year);

const subjects = [...new Set(translatedEntries.map(({ entry }) => entry.data.category))]
  .map((category) => {
    const categoryItems = translatedEntries.filter(
      ({ entry }) => entry.data.category === category,
    );
    const sortedByChange = [...categoryItems].sort(
      (a, b) =>
        b.entry.data.timelineYear - a.entry.data.timelineYear ||
        a.translation.data.claim.localeCompare(
          b.translation.data.claim,
          'de',
          { sensitivity: 'base' },
        ),
    );

    return {
      category,
      label: categoryLabel(category, 'de'),
      count: categoryItems.length,
      oldestChange: Math.min(...categoryItems.map(({ entry }) => entry.data.timelineYear)),
      newestChange: Math.max(...categoryItems.map(({ entry }) => entry.data.timelineYear)),
      latest: sortedByChange[0],
    };
  })
  .sort((a, b) => a.label.localeCompare(b.label, 'de', { sensitivity: 'base' }));
---
<BaseLayout
  locale="de"
  title="Fachgebiete"
  description={`Durchsuche ${translatedEntries.length} Katalogeinträge aus ${subjects.length} wissenschaftlichen und wissenschaftsnahen Fachgebieten.`}
  alternatePath="/categories/"
>
  <header class="container page-head">
    <p class="eyebrow">Fachgebiete</p>
    <h1>Nach Fachgebiet stöbern</h1>
    <p class="page-intro">
      Beginne mit einem Thema. Jedes Fachgebiet hat eine eigene Chronologie,
      Statusübersicht, Lebensdauerstatistik, Suche und Sortierung.
    </p>

    <p class="directory-summary">
      <strong>{subjects.length}</strong> Fachgebiete · <strong>{translatedEntries.length}</strong> Einträge
    </p>
  </header>

  <section class="subject-directory">
    <div class="container subject-grid">
      {subjects.map((subject) => (
        <a
          class="subject-row"
          href={`/de/categories/${encodeURIComponent(subject.category.toLowerCase())}/`}
        >
          <div class="subject-main">
            <h2>{subject.label}</h2>
            <p class="subject-range">
              {formatHistoricalYearDe(subject.oldestChange)}
              <span aria-hidden="true"> → </span>
              {formatHistoricalYearDe(subject.newestChange)}
            </p>
          </div>

          <div class="subject-count">
            <strong>{subject.count}</strong>
            <span>{subject.count === 1 ? 'Eintrag' : 'Einträge'}</span>
          </div>

          {subject.latest && (
            <div class="subject-latest">
              <span>Jüngste Änderung hier</span>
              <strong>{subject.latest.translation.data.claim}</strong>
            </div>
          )}

          <span class="subject-action">{subject.label} öffnen →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding: 5rem 0 4rem;
  }

  .page-head h1 {
    margin: 0.15rem 0 1rem;
    max-width: 13ch;
  }

  .page-intro {
    max-width: 54rem;
    color: var(--muted);
    font-size: 1.15rem;
  }

  .directory-summary {
    margin: 1.6rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .directory-summary strong {
    color: var(--ink);
  }

  .subject-directory {
    padding: 1rem 0 5rem;
  }

  .subject-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2.5rem, 6vw, 5rem);
  }

  .subject-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      "main count"
      "latest latest"
      "action action";
    min-width: 0;
    padding: 1.5rem 0 1.65rem;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }

  .subject-main { grid-area: main; min-width: 0; }

  .subject-row h2 {
    margin: 0;
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
  }

  .subject-range {
    margin: 0.45rem 0 0;
    color: var(--accent-dark);
    font-size: 0.82rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .subject-count {
    grid-area: count;
    align-self: start;
    padding-left: 1rem;
    text-align: right;
  }

  .subject-count strong {
    display: block;
    font-size: 1.8rem;
    line-height: 1;
  }

  .subject-count span {
    display: block;
    margin-top: 0.2rem;
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 750;
  }

  .subject-latest {
    grid-area: latest;
    margin-top: 1.15rem;
  }

  .subject-latest span {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--muted);
    font-size: 0.7rem;
    font-weight: 850;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .subject-latest strong {
    display: block;
    max-width: 34rem;
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .subject-action {
    grid-area: action;
    margin-top: 1rem;
    color: var(--accent-dark);
    font-size: 0.84rem;
    font-weight: 830;
  }

  .subject-row:hover h2,
  .subject-row:focus-visible h2 {
    color: var(--accent-dark);
  }

  @media (max-width: 760px) {
    .subject-grid {
      grid-template-columns: 1fr;
    }

    .page-head {
      padding-top: 3.5rem;
    }
  }
</style>
