---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CompactClaim from '../components/CompactClaim.astro';
import FactCard from '../components/FactCard.astro';

const claimCollator = new Intl.Collator('en', {
  sensitivity: 'base',
  numeric: true,
});

const claimSortKey = (claim: string) => {
  let key = claim.trim();
  const leadingWords = /^(?:a|an|all|every|most|the|there)(?:\s+|\b)\s*/i;
  let previous = '';

  while (key !== previous) {
    previous = key;
    key = key.replace(leadingWords, '');
  }

  return key.replace(/^[^\p{L}\p{N}]+/u, '').trim() || claim.trim();
};

const entries = (await getCollection('entries')).sort((a, b) => {
  const bySubject = claimCollator.compare(
    claimSortKey(a.data.claim),
    claimSortKey(b.data.claim),
  );

  return bySubject || claimCollator.compare(a.data.claim, b.data.claim);
});

const categories = [
  ...new Set(entries.map((entry) => entry.data.category)),
].sort();

const statuses = [
  ...new Set(entries.map((entry) => entry.data.status)),
].sort();
---
<BaseLayout
  title="Browse"
  description="Search and browse claims that were once accepted as fact but were later revised by stronger evidence."
>
  <header class="page-head container">
    <p class="eyebrow">The catalogue</p>
    <h1>Browse entries</h1>
    <p>
      Search the complete collection, narrow it by category or status, choose
      how it is ordered, and switch between detailed cards and a compact index.
    </p>
  </header>

  <section class="filter-region" aria-label="Catalogue controls">
    <div class="container filter-inner">
      <div class="primary-controls">
        <label class="search-field">
          <span class="sr-only">Search claims</span>
          <input
            type="search"
            class="catalogue-search"
            placeholder="Search claims and current understanding…"
            autocomplete="off"
          />
        </label>

        <label class="sort-field">
          <span class="sr-only">Sort catalogue</span>
          <select class="sort-select" aria-label="Sort catalogue">
            <option value="subject">Subject A–Z</option>
            <option value="newest-change">Newest change</option>
            <option value="oldest-change">Oldest change</option>
            <option value="shortest-lived">Shortest-lived</option>
            <option value="longest-lived">Longest-lived</option>
            <option value="recently-added">Recently added</option>
          </select>
        </label>

        <fieldset class="view-switcher">
          <legend class="sr-only">View</legend>
          <div class="view-buttons">
            <button class="view-button" type="button" data-view="cards" aria-pressed="true">
              Cards
            </button>
            <button class="view-button" type="button" data-view="compact" aria-pressed="false">
              Compact
            </button>
          </div>
        </fieldset>

        <button
          class="filter-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="catalogue-filter-panel"
        >
          <span>Filters</span>
          <span class="filter-count" hidden>0</span>
        </button>
      </div>

      <div class="active-filter-row" hidden>
        <div class="active-filter-chips" aria-label="Active filters"></div>
        <button class="clear-filters clear-filters-inline" type="button">Clear all</button>
      </div>

      <div class="catalogue-summary-row">
        <p class="results-summary" aria-live="polite">Showing all {entries.length} entries</p>
      </div>

      <div
        class="filter-panel"
        id="catalogue-filter-panel"
        hidden
        role="dialog"
        aria-labelledby="catalogue-filter-title"
      >
        <div class="filter-panel-header">
          <div>
            <p class="filter-label" id="catalogue-filter-title">Filter the catalogue</p>
            <p class="filter-help">Choose any combination of categories and statuses.</p>
          </div>
          <button class="filter-close" type="button" aria-label="Close filters">×</button>
        </div>

        <div class="filter-panel-scroll">
          <div class="filter-groups">
            <div>
              <p class="group-label">Categories</p>
              <div class="filters" role="group" aria-label="Filter entries by category">
                {categories.map((category) => {
                  const count = entries.filter((entry) => entry.data.category === category).length;
                  return (
                    <button
                      class="filter-button"
                      type="button"
                      data-filter-type="category"
                      data-filter-value={category}
                      aria-pressed="false"
                    >
                      {category}<span class="count">{count}</span>
                    </button>
                  );
                })}
              </div>
            </div>

            <div>
              <p class="group-label">Status</p>
              <div class="filters" role="group" aria-label="Filter entries by status">
                {statuses.map((status) => {
                  const count = entries.filter((entry) => entry.data.status === status).length;
                  return (
                    <button
                      class="filter-button"
                      type="button"
                      data-filter-type="status"
                      data-filter-value={status}
                      aria-pressed="false"
                    >
                      {status}<span class="count">{count}</span>
                    </button>
                  );
                })}
              </div>
            </div>
          </div>
        </div>

        <div class="filter-panel-actions">
          <button class="clear-filters clear-filters-panel" type="button">Clear all</button>
          <button class="apply-filters" type="button">Show all {entries.length} entries</button>
        </div>
      </div>
    </div>
  </section>

  <section class="container catalogue catalogue-cards" aria-label="Catalogue card view">
    {entries.map((entry) => (
      <div
        class="entry-wrapper"
        data-entry-id={entry.id}
        data-category={entry.data.category}
        data-status={entry.data.status}
        data-search={`${entry.data.claim} ${entry.data.currentUnderstanding} ${entry.data.summary} ${entry.data.category} ${entry.data.status}`.toLowerCase()}
        data-claim={entry.data.claim}
        data-subject={claimSortKey(entry.data.claim)}
        data-timeline-year={entry.data.timelineYear}
        data-lifespan={entry.data.lifespanComparable === false ? "" : entry.data.timelineYear - entry.data.acceptedYear}
        data-published-at={entry.data.publishedAt.getTime()}
      >
        <FactCard entry={entry} />
      </div>
    ))}
  </section>

  <section class="container catalogue catalogue-compact" aria-label="Compact catalogue view" hidden>
    {entries.map((entry) => (
      <div
        class="entry-wrapper"
        data-entry-id={entry.id}
        data-category={entry.data.category}
        data-status={entry.data.status}
        data-search={`${entry.data.claim} ${entry.data.currentUnderstanding} ${entry.data.summary} ${entry.data.category} ${entry.data.status}`.toLowerCase()}
        data-claim={entry.data.claim}
        data-subject={claimSortKey(entry.data.claim)}
        data-timeline-year={entry.data.timelineYear}
        data-lifespan={entry.data.lifespanComparable === false ? "" : entry.data.timelineYear - entry.data.acceptedYear}
        data-published-at={entry.data.publishedAt.getTime()}
      >
        <CompactClaim entry={entry} />
      </div>
    ))}
  </section>

  <div class="container empty-state" hidden>
    <p>No entries match those filters.</p>
    <button class="clear-filters empty-clear" type="button">Clear all</button>
  </div>

  <noscript>
    <p class="container noscript-note">
      Search, filtering, sorting, and the compact-view switch require JavaScript.
      All entries are shown as cards.
    </p>
  </noscript>

  <script>
    const filterButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.filter-button')
    );
    const viewButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.view-button')
    );
    const catalogues = Array.from(
      document.querySelectorAll<HTMLElement>('.catalogue')
    );
    const searchInput = document.querySelector<HTMLInputElement>('.catalogue-search');
    const sortSelect = document.querySelector<HTMLSelectElement>('.sort-select');
    const filterToggle = document.querySelector<HTMLButtonElement>('.filter-toggle');
    const filterPanel = document.querySelector<HTMLElement>('.filter-panel');
    const filterClose = document.querySelector<HTMLButtonElement>('.filter-close');
    const applyButton = document.querySelector<HTMLButtonElement>('.apply-filters');
    const clearButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('.clear-filters')
    );
    const filterCount = document.querySelector<HTMLElement>('.filter-count');
    const activeFilterRow = document.querySelector<HTMLElement>('.active-filter-row');
    const activeFilterChips = document.querySelector<HTMLElement>('.active-filter-chips');
    const resultsSummary = document.querySelector<HTMLElement>('.results-summary');
    const emptyState = document.querySelector<HTMLElement>('.empty-state');

    const selectedCategories = new Set<string>();
    const selectedStatuses = new Set<string>();

    type SortMode =
      | 'subject'
      | 'newest-change'
      | 'oldest-change'
      | 'shortest-lived'
      | 'longest-lived'
      | 'recently-added';

    let currentView: 'cards' | 'compact' = 'cards';
    let currentSort: SortMode = 'subject';
    let visibleCount = 0;

    const allWrappers = () => Array.from(
      document.querySelectorAll<HTMLElement>('.entry-wrapper')
    );

    const compareWrappers = (a: HTMLElement, b: HTMLElement) => {
      const claimA = a.dataset.claim ?? '';
      const claimB = b.dataset.claim ?? '';
      const subjectA = a.dataset.subject ?? claimA;
      const subjectB = b.dataset.subject ?? claimB;
      const yearA = Number(a.dataset.timelineYear ?? 0);
      const yearB = Number(b.dataset.timelineYear ?? 0);
      const comparableA = Boolean(a.dataset.lifespan);
      const comparableB = Boolean(b.dataset.lifespan);
      const lifespanA = comparableA ? Number(a.dataset.lifespan) : 0;
      const lifespanB = comparableB ? Number(b.dataset.lifespan) : 0;
      const publishedA = Number(a.dataset.publishedAt ?? 0);
      const publishedB = Number(b.dataset.publishedAt ?? 0);

      if (currentSort === 'newest-change') {
        return yearB - yearA || subjectA.localeCompare(subjectB, undefined, { sensitivity: 'base', numeric: true });
      }

      if (currentSort === 'oldest-change') {
        return yearA - yearB || subjectA.localeCompare(subjectB, undefined, { sensitivity: 'base', numeric: true });
      }

      if (currentSort === 'shortest-lived') {
        if (comparableA !== comparableB) return comparableA ? -1 : 1;
        return lifespanA - lifespanB || yearA - yearB || subjectA.localeCompare(subjectB, undefined, { sensitivity: 'base', numeric: true });
      }

      if (currentSort === 'longest-lived') {
        if (comparableA !== comparableB) return comparableA ? -1 : 1;
        return lifespanB - lifespanA || yearB - yearA || subjectA.localeCompare(subjectB, undefined, { sensitivity: 'base', numeric: true });
      }

      if (currentSort === 'recently-added') {
        return publishedB - publishedA || subjectA.localeCompare(subjectB, undefined, { sensitivity: 'base', numeric: true });
      }

      return (
        subjectA.localeCompare(subjectB, undefined, { sensitivity: 'base', numeric: true })
        || claimA.localeCompare(claimB, undefined, { sensitivity: 'base', numeric: true })
      );
    };

    const sortCatalogues = () => {
      catalogues.forEach((catalogue) => {
        const wrappers = Array.from(catalogue.querySelectorAll<HTMLElement>('.entry-wrapper'));
        wrappers.sort(compareWrappers).forEach((wrapper) => catalogue.append(wrapper));
      });
    };

    const updateURL = () => {
      const url = new URL(window.location.href);
      const search = searchInput?.value.trim() ?? '';

      const setList = (key: string, values: Set<string>) => {
        if (values.size) url.searchParams.set(key, [...values].sort().join(','));
        else url.searchParams.delete(key);
      };

      setList('categories', selectedCategories);
      setList('statuses', selectedStatuses);

      if (search) url.searchParams.set('q', search);
      else url.searchParams.delete('q');

      if (currentView === 'compact') url.searchParams.set('view', 'compact');
      else url.searchParams.delete('view');

      if (currentSort !== 'subject') url.searchParams.set('sort', currentSort);
      else url.searchParams.delete('sort');

      window.history.replaceState({}, '', url);
    };

    const openFilters = () => {
      if (!filterPanel || !filterToggle) return;
      filterPanel.hidden = false;
      filterToggle.setAttribute('aria-expanded', 'true');
      document.body.classList.add('filters-open');
      filterPanel.querySelector<HTMLButtonElement>('.filter-button')?.focus();
    };

    const closeFilters = (returnFocus = true) => {
      if (!filterPanel || !filterToggle) return;
      filterPanel.hidden = true;
      filterToggle.setAttribute('aria-expanded', 'false');
      document.body.classList.remove('filters-open');
      if (returnFocus) filterToggle.focus();
    };

    const setView = (view: 'cards' | 'compact') => {
      currentView = view;

      catalogues.forEach((catalogue) => {
        catalogue.hidden = !catalogue.classList.contains(`catalogue-${view}`);
      });

      viewButtons.forEach((button) => {
        const active = button.dataset.view === view;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });

      try {
        localStorage.setItem('catalogue-view', view);
      } catch {}

      updateDisplay();
    };

    const setSort = (sort: SortMode) => {
      currentSort = sort;
      if (sortSelect) sortSelect.value = sort;
      sortCatalogues();
      updateURL();
    };

    const removeFilter = (type: string, value: string) => {
      const target = type === 'category' ? selectedCategories : selectedStatuses;
      target.delete(value);
      updateDisplay();
    };

    const renderActiveFilters = () => {
      const selections = [
        ...[...selectedCategories].sort().map((value) => ({ type: 'category', value })),
        ...[...selectedStatuses].sort().map((value) => ({ type: 'status', value })),
      ];

      const count = selections.length;

      if (filterCount) {
        filterCount.textContent = String(count);
        filterCount.hidden = count === 0;
      }

      if (activeFilterRow) activeFilterRow.hidden = count === 0;
      if (!activeFilterChips) return;

      activeFilterChips.replaceChildren();

      selections.forEach(({ type, value }) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'active-filter-chip';
        button.setAttribute('aria-label', `Remove ${value} filter`);

        const label = document.createElement('span');
        label.textContent = value;

        const removeIcon = document.createElement('span');
        removeIcon.setAttribute('aria-hidden', 'true');
        removeIcon.textContent = '×';

        button.append(label, removeIcon);
        button.addEventListener('click', () => removeFilter(type, value));
        activeFilterChips.append(button);
      });
    };

    const updateDisplay = () => {
      const query = searchInput?.value.trim().toLowerCase() ?? '';
      const visibility = new Map<string, boolean>();
      visibleCount = 0;

      allWrappers().forEach((wrapper) => {
        const id = wrapper.dataset.entryId ?? '';

        if (visibility.has(id)) {
          wrapper.hidden = !visibility.get(id);
          return;
        }

        const categoryMatch =
          selectedCategories.size === 0 || selectedCategories.has(wrapper.dataset.category ?? '');

        const statusMatch =
          selectedStatuses.size === 0 || selectedStatuses.has(wrapper.dataset.status ?? '');

        const searchMatch = !query || (wrapper.dataset.search ?? '').includes(query);
        const visible = categoryMatch && statusMatch && searchMatch;

        visibility.set(id, visible);
        wrapper.hidden = !visible;

        if (visible) visibleCount += 1;
      });

      filterButtons.forEach((button) => {
        const type = button.dataset.filterType;
        const value = button.dataset.filterValue ?? '';
        const active = type === 'category'
          ? selectedCategories.has(value)
          : selectedStatuses.has(value);

        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });

      const hasFilters =
        selectedCategories.size > 0 ||
        selectedStatuses.size > 0 ||
        query.length > 0;

      if (emptyState) emptyState.hidden = visibleCount !== 0;

      if (resultsSummary) {
        resultsSummary.textContent = hasFilters
          ? `Showing ${visibleCount} of ${visibility.size} ${visibleCount === 1 ? 'entry' : 'entries'}`
          : `Showing all ${visibility.size} entries`;
      }

      if (applyButton) {
        applyButton.textContent = visibleCount === 1
          ? 'Show 1 result'
          : `Show ${visibleCount} results`;
      }

      sortCatalogues();
      renderActiveFilters();
      updateURL();
    };

    const clearFilters = () => {
      selectedCategories.clear();
      selectedStatuses.clear();
      if (searchInput) searchInput.value = '';
      updateDisplay();
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const type = button.dataset.filterType;
        const value = button.dataset.filterValue;

        if (!value) return;

        const target = type === 'category' ? selectedCategories : selectedStatuses;
        target.has(value) ? target.delete(value) : target.add(value);
        updateDisplay();
      });
    });

    viewButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const view = button.dataset.view;
        if (view === 'cards' || view === 'compact') setView(view);
      });
    });

    sortSelect?.addEventListener('change', () => {
      const value = sortSelect.value;
      if (
        value === 'subject' ||
        value === 'newest-change' ||
        value === 'oldest-change' ||
        value === 'shortest-lived' ||
        value === 'longest-lived' ||
        value === 'recently-added'
      ) {
        setSort(value);
      }
    });

    searchInput?.addEventListener('input', updateDisplay);

    filterToggle?.addEventListener('click', () => {
      filterPanel?.hidden ? openFilters() : closeFilters();
    });

    filterClose?.addEventListener('click', () => closeFilters());
    applyButton?.addEventListener('click', () => closeFilters());
    clearButtons.forEach((button) => button.addEventListener('click', clearFilters));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && filterPanel && !filterPanel.hidden) closeFilters();
    });

    filterPanel?.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab' || !window.matchMedia('(max-width: 760px)').matches) return;

      const focusable = Array.from(
        filterPanel.querySelectorAll<HTMLElement>(
          'button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), a[href], [tabindex]:not([tabindex="-1"])'
        )
      ).filter((element) => !element.hasAttribute('hidden'));

      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    const url = new URL(window.location.href);

    const readList = (key: string, target: Set<string>) => {
      url.searchParams
        .get(key)
        ?.split(',')
        .map((value) => value.trim())
        .filter(Boolean)
        .forEach((value) => target.add(value));
    };

    readList('categories', selectedCategories);
    readList('statuses', selectedStatuses);

    if (searchInput) searchInput.value = url.searchParams.get('q') ?? '';

    const requestedSort = url.searchParams.get('sort');
    if (
      requestedSort === 'newest-change' ||
      requestedSort === 'oldest-change' ||
      requestedSort === 'shortest-lived' ||
      requestedSort === 'longest-lived' ||
      requestedSort === 'recently-added'
    ) {
      currentSort = requestedSort;
    }

    if (sortSelect) sortSelect.value = currentSort;

    let savedView: string | null = null;
    try {
      savedView = localStorage.getItem('catalogue-view');
    } catch {}

    const requestedView = url.searchParams.get('view') ?? savedView;

    sortCatalogues();
    setView(requestedView === 'compact' ? 'compact' : 'cards');
  </script>
</BaseLayout>

<style>
  .page-head {
    padding: 5rem 0 2rem;
  }

  .page-head h1 {
    margin: 0.2rem 0 1rem;
  }

  .page-head > p:not(.eyebrow) {
    font-size: 1.2rem;
    color: var(--muted);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .filter-region {
    position: sticky;
    top: 0;
    z-index: 20;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--paper) 95%, transparent);
    backdrop-filter: blur(10px);
  }

  .filter-inner {
    position: relative;
    padding: 0.8rem 0 0.65rem;
  }

  .primary-controls {
    display: grid;
    grid-template-columns: minmax(14rem, 1fr) auto auto auto;
    gap: 0.65rem;
    align-items: center;
  }

  .search-field,
  .sort-field {
    display: block;
  }

  .catalogue-search,
  .sort-select {
    width: 100%;
    min-height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    padding: 0.62rem 0.8rem;
    color: var(--ink);
    background: var(--card);
    font: inherit;
  }

  .sort-select {
    width: auto;
    min-width: 10.5rem;
    cursor: pointer;
  }

  .catalogue-search:focus,
  .sort-select:focus {
    outline: 2px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-color: var(--accent-dark);
  }

  .view-switcher {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .view-buttons {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: 999px;
    overflow: hidden;
    background: var(--card);
  }

  .view-button {
    border: 0;
    padding: 0.55rem 0.85rem;
    color: var(--ink);
    background: transparent;
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .view-button.is-active {
    color: white;
    background: var(--ink);
  }

  .filter-toggle {
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.55rem 0.9rem;
    color: var(--ink);
    background: var(--card);
    font: inherit;
    font-weight: 800;
    cursor: pointer;
  }

  .filter-toggle:hover,
  .filter-toggle:focus-visible {
    border-color: var(--accent-dark);
  }

  .filter-count {
    min-width: 1.35rem;
    padding: 0.05rem 0.35rem;
    border-radius: 999px;
    color: white;
    background: var(--accent-dark);
    font-size: 0.72rem;
    line-height: 1.2;
    text-align: center;
  }

  .active-filter-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.55rem;
  }

  .active-filter-row[hidden] {
    display: none;
  }

  .active-filter-chips {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    scrollbar-width: thin;
    flex: 1;
    padding-bottom: 0.1rem;
  }

  :global(.active-filter-chip) {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.28rem 0.6rem;
    color: var(--ink);
    background: var(--card);
    font: inherit;
    font-size: 0.82rem;
    font-weight: 750;
    cursor: pointer;
  }

  :global(.active-filter-chip:hover),
  :global(.active-filter-chip:focus-visible) {
    border-color: var(--accent-dark);
  }

  .clear-filters {
    border: 0;
    color: var(--accent-dark);
    background: transparent;
    font: inherit;
    font-size: 0.86rem;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
  }

  .clear-filters:hover,
  .clear-filters:focus-visible {
    text-decoration: underline;
  }

  .catalogue-summary-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .results-summary {
    margin: 0.5rem 0 0;
    color: var(--muted);
    font-size: 0.86rem;
  }

  .filter-panel {
    position: absolute;
    right: 0;
