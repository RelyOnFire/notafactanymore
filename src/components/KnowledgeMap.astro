---
import BaseLayout from '../layouts/BaseLayout.astro';
import { correctionMechanisms } from '../data/knowledgeOntology';
import { loadKnowledgeMap, comparisonPath } from '../lib/knowledgeMap';
import type { SiteLocale } from '../lib/i18n';
const { locale = 'en' } = Astro.props as { locale?: SiteLocale };
const de = locale === 'de';
const { readings, rows, mapped, total } = await loadKnowledgeMap(locale);
const [lead, ...others] = readings;
const title = de ? 'Wissenskarte' : 'Knowledge map';
const intro = de ? 'Wie lässt sich derselbe Denkfehler in zwei völlig verschiedenen Fachgebieten erkennen?' : 'How do you recognize the same mistake in two entirely different fields?';
const pair = (r: typeof lead) => r.cases.map(item => item.name[locale]).join(' · ');
---
<BaseLayout {locale} {title} description={intro} alternatePath={de ? '/graph/' : '/de/graph/'}>
  <div class="container atlas">
    <header>
      <h1>{title}</h1>
      <p class="lead">{intro}</p>
      <a href="#matrix">{de ? 'Welche Annahme wurde wie geprüft?' : 'Explore assumptions and tests'} ↓</a>
    </header>
    <section class="featured">
      <p class="eyebrow">{pair(lead)}</p>
      <h2><a href={comparisonPath(lead.id, locale)}>{lead.question[locale]}</a></h2>
      <p>{lead.insight[locale]}</p>
      <a class="read" href={comparisonPath(lead.id, locale)}>{de ? 'Beide Fälle vergleichen' : 'Compare the two cases'} →</a>
    </section>
    <section class="others" aria-label={de ? 'Weitere Vergleiche' : 'More comparisons'}>
      {others.map(r => <article>
        <p class="pair">{pair(r)}</p>
        <h2><a href={comparisonPath(r.id, locale)}>{r.question[locale]}</a></h2>
      </article>)}
    </section>
    <section id="matrix" class="matrix">
      <h2>{de ? 'Welche Evidenz änderte welche Annahme?' : 'Which evidence changed which assumption?'}</h2>
      <p>{de
        ? `Die Karte erfasst ${mapped} von ${total} Katalogeinträgen. Jede Zahl führt zu den Fällen, die eine Annahme und eine Art von Evidenz gemeinsam haben. Ein Fall kann in mehreren Feldern vorkommen.`
        : `The map covers ${mapped} of ${total} catalogue entries. Choose a count to read the cases that share an assumption and a kind of evidence. A case can appear in several cells.`}</p>
      <div class="scroll-table" tabindex="0" role="region" aria-label={de ? 'Tabelle der Annahmen und Belege' : 'Assumptions and evidence table'}>
        <table>
          <thead><tr><th scope="col">{de ? 'Frühere Annahme' : 'Earlier assumption'}</th>{correctionMechanisms.map(method => <th scope="col">{method.label[locale]}</th>)}</tr></thead>
          <tbody>{rows.map(({ pattern, cells }) => <tr>
            <th scope="row">{pattern.label[locale]}</th>
            {cells.map(cell => <td>{cell.cases.length
              ? <a href={`#${cell.id}`} aria-label={`${pattern.label[locale]} · ${cell.method.label[locale]} (${cell.cases.length})`}>{cell.cases.length}</a>
              : <span aria-label="0">–</span>}</td>)}
          </tr>)}</tbody>
        </table>
      </div>
      {rows.flatMap(({ pattern, cells }) => cells.filter(cell => cell.cases.length).map(cell =>
        <section class="cell" id={cell.id} tabindex="-1">
          <a class="return" href="#matrix">↑ {de ? 'Zur Tabelle' : 'Back to the table'}</a>
          <h3>{pattern.label[locale]} · {cell.method.label[locale]}</h3>
          <p>{pattern.definition[locale]} {cell.method.definition[locale]}</p>
          <ul>{cell.cases.map(item => <li><small>{item.category}</small><a href={item.href} lang={item.language}>{item.claim}</a>{de && item.language === 'en' && ' (EN)'}</li>)}</ul>
        </section>))}
    </section>
  </div>
</BaseLayout>

<style>
  .atlas { padding-block: clamp(2rem, 5vw, 4.5rem); }
  h1, h2, h3, p { margin: 0; }
  header { padding-bottom: 2rem; }
  .lead { margin: .75rem 0; font-size: clamp(1.12rem, 2vw, 1.45rem); }
  header a, .read, .return { color: var(--accent-dark); font-weight: 700; text-underline-offset: .18em; }
  .featured { padding: clamp(1.3rem, 4vw, 3rem); border: 1px solid var(--line); border-left: .4rem solid var(--accent); background: var(--card); }
  .featured h2 { max-width: 25ch; margin: .65rem 0 .85rem; }
  .featured p:not(.eyebrow) { max-width: 68ch; font-size: 1.08rem; }
  .read { display: inline-block; margin-top: 1rem; }
  h2 a { text-decoration: none; }
  h2 a:hover, h2 a:focus-visible { text-decoration: underline; text-decoration-thickness: .06em; }
  .others { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); column-gap: 2rem; }
  .others article { padding: 1.35rem 0; border-bottom: 1px solid var(--line); }
  .pair, small { color: var(--muted); font-size: .85rem; font-weight: 650; }
  .others h2 { margin: .4rem 0 0; font-size: clamp(1.22rem, 2.5vw, 1.65rem); }
  .matrix { margin-top: clamp(2.6rem, 6vw, 4.5rem); scroll-margin-top: 1.5rem; }
  .matrix > p, .cell > p { margin-block: .8rem 1.25rem; }
  .scroll-table { overflow-x: auto; }
  table { border-collapse: separate; border-spacing: 0; width: 100%; font-variant-numeric: tabular-nums; }
  th, td { padding: .35rem; border-bottom: 1px solid var(--line); }
  th { font-size: .82rem; line-height: 1.3; }
  thead th { min-width: 5.75rem; vertical-align: bottom; padding-bottom: .8rem; }
  th:first-child { position: sticky; left: 0; z-index: 1; text-align: left; min-width: 8rem; max-width: 13rem; background: var(--paper); border-right: 1px solid var(--line); }
  td { text-align: center; color: var(--muted); }
  td a { display: grid; place-content: center; min-height: 2.75rem; background: #ece1d4; color: var(--accent-dark); font-weight: 750; text-underline-offset: .2em; }
  td a:hover, td a:focus-visible { background: var(--ink); color: var(--card); }
  .cell { display: none; scroll-margin-top: 1rem; border-left: .25rem solid var(--accent); background: var(--card); padding: 1.5rem; margin-top: 1.5rem; }
  .cell:target { display: block; }
  .cell h3 { margin-top: 1rem; font-size: 1.5rem; }
  .cell ul { list-style: none; padding: 0; margin: 0; }
  .cell li { padding: .55rem 0; border-top: 1px solid var(--line); }
  .cell small { display: block; }
  @media(max-width: 650px) { .others { grid-template-columns: 1fr; } }
</style>
